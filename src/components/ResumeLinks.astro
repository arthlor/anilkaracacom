---
import Icon from './Icon.astro';
import { resumeLinks } from '../data/portfolio';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Download resume',
  description = 'A comprehensive overview of my work across journalism, digital products, and technical delivery.',
} = Astro.props;

const resumeItem = {
  title: 'Full CV / Resume',
  description: 'PDF format · Data journalism and Developer background',
  href: resumeLinks.master,
  eventName: 'download_resume',
};
---

<section class="rounded-[2rem] border border-white/8 bg-[#161616]/92 p-6 backdrop-blur-sm md:p-8">
  <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
    <div class="md:max-w-xl">
      <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.18em] text-primary">Resume</span>
      <h2 class="text-2xl font-display font-bold text-foreground">{title}</h2>
      <p class="mt-3 text-sm leading-relaxed text-muted-foreground">{description}</p>
    </div>

    <div class="shrink-0">
      <a
        href={resumeItem.href}
        class="group flex items-center justify-between gap-6 rounded-[1.4rem] border border-white/8 bg-white/[0.04] pl-6 pr-5 py-5 transition-all duration-300 hover:border-primary/30 hover:bg-white/[0.07] min-w-[300px]"
        data-track-event={resumeItem.eventName}
        data-track-label={resumeItem.title}
      >
        <div>
          <span class="block text-base font-semibold text-foreground transition-colors group-hover:text-primary">
            {resumeItem.title}
          </span>
          <span class="mt-1 block text-xs leading-relaxed text-muted-foreground">{resumeItem.description}</span>
        </div>
        <div class="flex h-10 w-10 items-center justify-center rounded-full bg-primary/10 transition-colors group-hover:bg-primary/20">
          <Icon name="download" size={20} class="text-primary" />
        </div>
      </a>
    </div>
  </div>
</section>
