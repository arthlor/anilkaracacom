---
import Icon from './Icon.astro';
import { resumeLinks } from '../data/portfolio';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Resume downloads',
  description = 'Choose the version that matches the role you are considering me for.',
} = Astro.props;

const items = [
  {
    title: 'Master resume',
    description: 'Broad overview across data journalism and product work.',
    href: resumeLinks.master,
    eventName: 'download_master_resume',
  },
  {
    title: 'Data journalism resume',
    description: 'Focused on reporting, analysis, investigations, and visual storytelling.',
    href: resumeLinks.dataJournalism,
    eventName: 'download_data_journalism_resume',
  },
  {
    title: 'Developer resume',
    description: 'Focused on frontend, mobile, and product delivery work.',
    href: resumeLinks.developer,
    eventName: 'download_developer_resume',
  },
];
---

<section class="rounded-3xl border border-border bg-card/80 p-6 backdrop-blur-sm md:flex md:items-center md:justify-between md:p-8">
  <div class="mb-6 md:mb-0 md:max-w-xl">
    <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.18em] text-primary">Resume</span>
    <h2 class="text-2xl font-display font-bold text-foreground">{title}</h2>
    <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{description}</p>
  </div>

  <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap md:justify-end">
    {items.map((item) => (
      <a
        href={item.href}
        class="group inline-flex items-center gap-3 rounded-2xl border border-border bg-background/60 px-5 py-3 transition-all duration-300 hover:border-primary/30 hover:bg-background"
        data-track-event={item.eventName}
        data-track-label={item.title}
      >
        <span class="font-medium text-foreground transition-colors group-hover:text-primary">
          {item.title}
        </span>
        <Icon name="download" size={16} class="text-primary" />
      </a>
    ))}
  </div>
</section>
