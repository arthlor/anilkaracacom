---
import { siteConfig } from "../lib/site";
import { DEFAULT_OG_IMAGE } from "../lib/seo";

interface Props {
  title: string;
  /** Use the title as is, without the " | Anıl Karaca" suffix. */
  exactTitle?: boolean | undefined;
  description?: string | undefined;
  image?: string | undefined;
  imageAlt?: string | undefined;
  article?: boolean | undefined;
  noindex?: boolean | undefined;
  lang?: string | undefined;
  articlePublishedTime?: string | undefined;
  articleModifiedTime?: string | undefined;
  articleAuthor?: string | undefined;
  articleSection?: string | undefined;
}

const {
  title,
  exactTitle = false,
  description = siteConfig.description,
  image = DEFAULT_OG_IMAGE,
  imageAlt,
  article = false,
  noindex = false,
  lang = "en",
  articlePublishedTime,
  articleModifiedTime,
  articleAuthor = siteConfig.displayName,
  articleSection,
} = Astro.props;

const site = Astro.site || siteConfig.url;
const fullTitle = exactTitle ? title : `${title} | ${siteConfig.displayName}`;
const canonicalURL = new URL(Astro.url.pathname, site);
const socialImageURL = new URL(image, site);
// Both the default card and article crops are 1200×630.
const isOwnImage = image === DEFAULT_OG_IMAGE || image.includes("/_astro/");
---

<!-- SEO -->
<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={siteConfig.displayName} />
<link rel="canonical" href={canonicalURL} />
<link
  rel="alternate"
  type="application/rss+xml"
  title={`${siteConfig.displayName} — Articles`}
  href={new URL("/rss.xml", site)}
/>
<link rel="author" href="/about" />
<meta
  name="robots"
  content={noindex
    ? "noindex, nofollow"
    : "index, follow, max-image-preview:large, max-snippet:-1"}
/>

<!-- Open Graph -->
<meta property="og:type" content={article ? "article" : "website"} />
<meta property="og:site_name" content={siteConfig.displayName} />
<meta property="og:locale" content={lang === "tr" ? "tr_TR" : "en_US"} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={exactTitle ? title : fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={socialImageURL} />
{
  isOwnImage && (
    <>
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
    </>
  )
}
<meta property="og:image:alt" content={imageAlt ?? title} />
{
  article && articlePublishedTime && (
    <meta property="article:published_time" content={articlePublishedTime} />
  )
}
{
  article && articleModifiedTime && (
    <meta property="article:modified_time" content={articleModifiedTime} />
  )
}
{
  article && articleAuthor && (
    <meta property="article:author" content={articleAuthor} />
  )
}
{
  article && articleSection && (
    <meta property="article:section" content={articleSection} />
  )
}

<!-- X / Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content={siteConfig.twitterHandle} />
<meta name="twitter:creator" content={siteConfig.twitterHandle} />
<meta name="twitter:title" content={exactTitle ? title : fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImageURL} />
<meta name="twitter:image:alt" content={imageAlt ?? title} />
