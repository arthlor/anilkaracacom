---
import { navigationLinks } from '../lib/site';

const currentPath = Astro.url.pathname;
const isActiveLink = (href: string, matchPrefix = false) =>
  currentPath === href || (matchPrefix && currentPath.startsWith(`${href}/`));
---

<header class="site-header">
  <div class="site-header__container">
    <a href="/" class="site-header__brand">ANIL KARACA</a>

    <div class="site-header__menu">
      <button
        id="site-menu-toggle"
        class="site-header__menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="site-menu-panel"
      >
        <span>Menu</span>
        <span class="site-header__menu-dot" aria-hidden="true"></span>
        <svg
          class="site-header__menu-icon"
          viewBox="0 0 16 16"
          fill="none"
          stroke="currentColor"
          stroke-width="1.2"
          aria-hidden="true"
        >
          <path d="M4 6L8 2L12 6"></path>
          <path d="M4 10L8 14L12 10"></path>
        </svg>
      </button>

      <div id="site-menu-panel" class="site-header__panel" data-open="false">
        {navigationLinks.map((link) => (
          <a
            href={link.href}
            class:list={['site-header__link', isActiveLink(link.href, link.href !== '/') && 'is-active']}
            aria-current={isActiveLink(link.href, link.href !== '/') ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))}

        <a
          href={resumeLinks.master}
          class="site-header__resume"
          data-track-event="download_resume"
          data-track-label="Header"
        >
          Resume
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    padding-top: 10px;
    pointer-events: none;
  }

  .site-header__container {
    position: relative;
    width: min(100% - 40px, 1320px);
    margin-inline: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    pointer-events: auto;
  }

  .site-header__brand {
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.96);
    text-decoration: none;
  }

  .site-header__menu {
    position: relative;
  }

  .site-header__menu-toggle {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    border: 0;
    border-radius: 999px;
    background: #f7f4ef;
    color: #111111;
    padding: 13px 16px 13px 18px;
    font-size: 0.82rem;
    line-height: 1;
    cursor: pointer;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.28);
  }

  .site-header__menu-dot {
    width: 10px;
    height: 10px;
    border-radius: 999px;
    background: #7af298;
    transform: scale(0);
    transition: transform 180ms ease;
  }

  .site-header__menu-toggle[aria-expanded='true'] .site-header__menu-dot {
    transform: scale(1);
  }

  .site-header__menu-icon {
    width: 16px;
    height: 16px;
  }

  .site-header__panel {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    min-width: 210px;
    display: grid;
    gap: 6px;
    padding: 14px 12px;
    border-radius: 18px;
    background: #f7f4ef;
    color: #111111;
    box-shadow: 0 24px 48px rgba(0, 0, 0, 0.28);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px);
    transition:
      opacity 180ms ease,
      transform 180ms ease,
      visibility 180ms ease;
  }

  .site-header__panel[data-open='true'] {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .site-header__link,
  .site-header__resume {
    display: block;
    border-radius: 12px;
    padding: 9px 12px;
    font-size: 0.88rem;
    font-weight: 600;
    color: inherit;
    text-decoration: none;
    transition: background-color 180ms ease, color 180ms ease;
  }

  .site-header__link:hover,
  .site-header__resume:hover {
    background: rgba(17, 17, 17, 0.08);
  }

  .site-header__link.is-active {
    background: rgba(122, 242, 152, 0.28);
  }

  .site-header__resume {
    margin-top: 6px;
    background: #111111;
    color: #f7f4ef;
    text-align: center;
  }

  @media (max-width: 720px) {
    .site-header {
      padding-top: 12px;
    }

    .site-header__container {
      width: min(100% - 28px, 1320px);
    }

    .site-header__brand {
      font-size: 0.78rem;
    }

    .site-header__menu-toggle {
      padding: 11px 14px 11px 16px;
    }
  }
</style>

<script>
  const menuToggle = document.getElementById('site-menu-toggle');
  const menuPanel = document.getElementById('site-menu-panel');

  const closeMenu = () => {
    menuPanel?.setAttribute('data-open', 'false');
    menuToggle?.setAttribute('aria-expanded', 'false');
  };

  menuToggle?.addEventListener('click', (event) => {
    event.stopPropagation();
    const nextState = menuPanel?.getAttribute('data-open') !== 'true';
    menuPanel?.setAttribute('data-open', String(nextState));
    menuToggle.setAttribute('aria-expanded', String(nextState));
  });

  menuPanel?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', closeMenu);
  });

  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Node)) return;
    if (menuPanel?.contains(target) || menuToggle?.contains(target)) return;
    closeMenu();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      closeMenu();
    }
  });
</script>
