---
import { resumeLinks } from "../data/portfolio";
import { navigationLinks } from "../lib/site";
import HeaderNavigation from "./HeaderNavigation";

const currentPath = Astro.url.pathname;
---

<header class="site-header" id="site-header">
  <div class="site-header__bar">
    <a href="/" class="site-header__brand" aria-label="Home">
      <span class="brand-text">ANIL KARACA</span>
      <span class="brand-dot"></span>
    </a>

    <HeaderNavigation
      client:load
      links={navigationLinks}
      currentPath={currentPath}
      resumeHref={resumeLinks.master}
    />
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding: 16px 0;
    pointer-events: none;
    transition: padding 0.3s ease;
  }

  .site-header__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: min(100% - 32px, 1200px);
    margin-inline: auto;
    padding: 0 6px 0 20px;
    height: 56px;
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.07);
    background: rgba(12, 12, 12, 0.85);
    backdrop-filter: blur(20px) saturate(1.4);
    -webkit-backdrop-filter: blur(20px) saturate(1.4);
    box-shadow:
      0 1px 0 0 rgba(255, 255, 255, 0.03) inset,
      0 16px 48px rgba(0, 0, 0, 0.3);
    pointer-events: auto;
    transition: all 0.3s ease;
  }

  .site-header__brand {
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    color: white;
    transition: opacity 200ms ease;
    flex-shrink: 0;
  }

  .site-header__brand:hover {
    opacity: 0.75;
  }

  .brand-text {
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .brand-dot {
    width: 5px;
    height: 5px;
    background: var(--premium-accent, #7af298);
    border-radius: 50%;
    flex-shrink: 0;
  }

  @media (max-width: 768px) {
    .site-header {
      padding: 10px 0;
    }

    .site-header__bar {
      width: min(100% - 24px, 1200px);
      height: 52px;
      padding: 0 8px 0 16px;
      border-radius: 14px;
    }

    .brand-text {
      font-size: 0.75rem;
      letter-spacing: 0.12em;
    }
  }
</style>
