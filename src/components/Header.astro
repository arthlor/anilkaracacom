---
import { resumeLinks } from '../data/portfolio';
import { navigationLinks } from '../lib/site';
import HeaderNavigation from './HeaderNavigation';

const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="site-header__container">
    <a href="/" class="site-header__brand" aria-label="Home">
      <span class="brand-text">ANIL KARACA</span>
      <span class="brand-dot"></span>
    </a>

    <HeaderNavigation 
      client:load 
      links={navigationLinks} 
      currentPath={currentPath}
      resumeHref={resumeLinks.master}
    />
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 100;
    padding-top: 24px;
    pointer-events: none;
  }

  .site-header__container {
    width: min(100% - 48px, 1200px);
    margin-inline: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    pointer-events: auto;
  }

  .site-header__brand {
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    color: white;
    transition: opacity 200ms ease;
  }

  .site-header__brand:hover {
    opacity: 0.8;
  }

  .brand-text {
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .brand-dot {
    width: 6px;
    height: 6px;
    background: var(--premium-accent, #7af298);
    border-radius: 50%;
  }

  @media (max-width: 768px) {
    .site-header {
      padding-top: 16px;
    }
    
    .site-header__container {
      width: min(100% - 32px, 1200px);
    }

    .brand-text {
      font-size: 0.75rem;
    }
  }
</style>
