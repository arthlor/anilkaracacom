---
interface Metric {
  label: string;
  value: string;
  detail?: string | undefined;
}

interface Props {
  slug: string;
  title: string;
  metrics: Metric[];
  variant?: "card" | "hero";
}

const { slug, title, metrics, variant = "card" } = Astro.props;

const previewConfig: Record<
  string,
  {
    mode: "heatmap" | "matrix" | "origin" | "birth" | "transit" | "election";
    eyebrow: string;
    label: string;
    accent: string;
    secondary: string;
    axis: string[];
    kpi: string;
  }
> = {
  "izmir-trafik-kazasi-raporu": {
    mode: "heatmap",
    eyebrow: "Crash records",
    label: "Street risk dashboard",
    accent: "#edbd21",
    secondary: "#7af298",
    axis: ["street rank", "incident mix", "hour density"],
    kpi: "17K+ civic records",
  },
  "izmir-yas-analizi": {
    mode: "matrix",
    eyebrow: "Population matrix",
    label: "Age x district scanner",
    accent: "#68d3f5",
    secondary: "#7af298",
    axis: ["30 districts", "19 age bands", "gender split"],
    kpi: "570 comparison cells",
  },
  "izmir-memleket-dagilimi": {
    mode: "origin",
    eyebrow: "Migration profile",
    label: "Origin cluster map",
    accent: "#7af298",
    secondary: "#f6c56d",
    axis: ["district locator", "top origins", "city baseline"],
    kpi: "30 district profiles",
  },
  "turkiye-dogum-istatistikleri": {
    mode: "birth",
    eyebrow: "Fertility series",
    label: "Birth rhythm timeline",
    accent: "#f6c56d",
    secondary: "#68d3f5",
    axis: ["birth rate", "fertility", "maternal age"],
    kpi: "2001-2020 trend",
  },
  "izmir-coronavirus-toplu-tasima": {
    mode: "transit",
    eyebrow: "Recovery model",
    label: "Transit rebound console",
    accent: "#9b8cff",
    secondary: "#7af298",
    axis: ["mode index", "fare groups", "monthly cursor"],
    kpi: "19K+ mobility records",
  },
  "turkey-elections-red-wave": {
    mode: "election",
    eyebrow: "Election geography",
    label: "Vote shift map",
    accent: "#f46f88",
    secondary: "#68d3f5",
    axis: ["vote share", "province map", "control change"],
    kpi: "81 provinces",
  },
};

const config =
  previewConfig[slug] ??
  ({
    mode: "birth",
    eyebrow: "Data story",
    label: "Interactive analysis",
    accent: "#7af298",
    secondary: "#68d3f5",
    axis: ["data", "visuals", "story"],
    kpi: metrics[0]?.detail ?? "Published analysis",
  } as const);

const cells = Array.from(
  { length: variant === "hero" ? 48 : 36 },
  (_, index) => ({
    index,
    depth: (index % 7) + 1,
    offset: index % 5,
  }),
);

const bars = [42, 58, 34, 72, 49, 82, 61, 46, 75, 54, 88, 63];
const linePoints = [
  [8, 70],
  [18, 62],
  [28, 66],
  [38, 50],
  [48, 54],
  [58, 39],
  [68, 42],
  [78, 31],
  [88, 36],
  [98, 28],
];
const secondLinePoints = [
  [8, 58],
  [18, 55],
  [28, 49],
  [38, 45],
  [48, 38],
  [58, 34],
  [68, 30],
  [78, 29],
  [88, 25],
  [98, 22],
];
const mapDots = [
  [22, 28, 8],
  [36, 22, 5],
  [48, 34, 10],
  [58, 24, 6],
  [66, 39, 9],
  [75, 31, 4],
  [31, 51, 6],
  [44, 57, 12],
  [58, 60, 8],
  [72, 55, 6],
];
const linePath = linePoints
  .map(([x, y], index) => `${index === 0 ? "M" : "L"} ${x} ${y}`)
  .join(" ");
const secondLinePath = secondLinePoints
  .map(([x, y], index) => `${index === 0 ? "M" : "L"} ${x} ${y}`)
  .join(" ");
---

<div
  class:list={[
    "data-story-preview",
    `data-story-preview--${config.mode}`,
    `data-story-preview--${variant}`,
  ]}
  style={`--preview-accent:${config.accent}; --preview-secondary:${config.secondary};`}
  aria-label={`${title} visual preview`}
>
  <div class="data-story-preview__chrome">
    <div>
      <p>{config.eyebrow}</p>
      <strong>{config.label}</strong>
    </div>
    <span>{config.kpi}</span>
  </div>

  <div class="data-story-preview__canvas" aria-hidden="true">
    {
      config.mode === "heatmap" && (
        <div class="data-story-preview__heatmap">
          {cells.map((cell) => (
            <i style={`--depth:${cell.depth}; --offset:${cell.offset};`} />
          ))}
        </div>
      )
    }

    {
      config.mode === "matrix" && (
        <div class="data-story-preview__matrix">
          <div class="data-story-preview__pyramid">
            {bars.slice(0, 8).map((bar, index) => (
              <span
                style={`--left:${100 - bar}; --right:${bar - 12}; --row:${index};`}
              />
            ))}
          </div>
          <div class="data-story-preview__bubble-grid">
            {cells.slice(0, 20).map((cell) => (
              <i style={`--depth:${cell.depth};`} />
            ))}
          </div>
        </div>
      )
    }

    {
      config.mode === "origin" && (
        <div class="data-story-preview__map">
          <svg viewBox="0 0 120 78" role="presentation">
            <path d="M16 44 C22 18 45 9 65 18 C84 25 101 21 109 38 C116 55 94 67 72 62 C51 58 42 74 25 64 C17 59 12 53 16 44Z" />
            {mapDots.map(([x, y, r]) => (
              <circle cx={x} cy={y} r={r} />
            ))}
          </svg>
        </div>
      )
    }

    {
      (config.mode === "birth" || config.mode === "transit") && (
        <div class="data-story-preview__timeline">
          <svg viewBox="0 0 108 82" role="presentation">
            <path class="gridline" d="M8 22 H100 M8 42 H100 M8 62 H100" />
            <path class="primary-line" d={linePath} />
            <path class="secondary-line" d={secondLinePath} />
            {bars.map((bar, index) => (
              <rect
                x={10 + index * 7.4}
                y={78 - bar * 0.58}
                width="3.5"
                height={bar * 0.58}
                rx="1.5"
              />
            ))}
          </svg>
        </div>
      )
    }

    {
      config.mode === "election" && (
        <div class="data-story-preview__election">
          <svg viewBox="0 0 120 78" role="presentation">
            <path d="M11 37 C22 17 49 13 65 20 C78 27 94 19 108 36 C116 47 106 64 86 63 C71 62 65 71 48 65 C33 59 21 59 13 48 C10 44 8 40 11 37Z" />
            {mapDots.map(([x, y, r], index) => (
              <circle
                cx={x}
                cy={y}
                r={r}
                class:list={[index % 3 === 0 && "is-opposition"]}
              />
            ))}
          </svg>
        </div>
      )
    }
  </div>

  <div class="data-story-preview__footer">
    {config.axis.map((item) => <span>{item}</span>)}
  </div>
</div>

<style>
  .data-story-preview {
    position: relative;
    display: grid;
    min-height: 13rem;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 8px;
    background:
      linear-gradient(
        135deg,
        rgba(255, 255, 255, 0.035),
        rgba(255, 255, 255, 0.01)
      ),
      #111;
    color: hsl(var(--foreground));
  }

  .data-story-preview::before {
    position: absolute;
    inset: 0;
    content: "";
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.035) 1px, transparent 1px);
    background-size: 2.5rem 2.5rem;
    mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.9), transparent);
    pointer-events: none;
  }

  .data-story-preview--hero {
    min-height: 23rem;
    border-color: rgba(255, 255, 255, 0.12);
    border-radius: 10px;
  }

  .data-story-preview__chrome,
  .data-story-preview__footer {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem;
  }

  .data-story-preview--hero .data-story-preview__chrome,
  .data-story-preview--hero .data-story-preview__footer {
    padding: 1rem;
  }

  .data-story-preview__chrome {
    border-bottom: 1px solid rgba(255, 255, 255, 0.075);
    background: rgba(17, 17, 17, 0.72);
    backdrop-filter: blur(14px);
  }

  .data-story-preview__chrome p,
  .data-story-preview__chrome span,
  .data-story-preview__footer span {
    margin: 0;
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: hsl(var(--muted-foreground));
  }

  .data-story-preview__chrome strong {
    display: block;
    margin-top: 0.25rem;
    font-size: 0.92rem;
    line-height: 1.2;
  }

  .data-story-preview__chrome span {
    flex-shrink: 0;
    max-width: 11rem;
    text-align: right;
    color: var(--preview-accent);
  }

  .data-story-preview__canvas {
    position: relative;
    z-index: 1;
    min-height: 8.5rem;
    padding: 1rem;
  }

  .data-story-preview--hero .data-story-preview__canvas {
    min-height: 16rem;
    padding: 1.3rem;
  }

  .data-story-preview__footer {
    margin-top: auto;
    border-top: 1px solid rgba(255, 255, 255, 0.075);
    background: rgba(17, 17, 17, 0.68);
  }

  .data-story-preview__footer span {
    color: rgba(243, 241, 235, 0.62);
  }

  .data-story-preview__heatmap,
  .data-story-preview__bubble-grid {
    display: grid;
    height: 100%;
    grid-template-columns: repeat(9, minmax(0, 1fr));
    gap: 0.34rem;
  }

  .data-story-preview__heatmap i,
  .data-story-preview__bubble-grid i {
    min-height: 1rem;
    border: 1px solid color-mix(in srgb, var(--preview-accent) 42%, transparent);
    border-radius: 4px;
    background: color-mix(
      in srgb,
      var(--preview-accent) calc(8% + var(--depth) * 8%),
      transparent
    );
    transform: translateY(calc(var(--offset) * 0.08rem));
  }

  .data-story-preview__matrix {
    display: grid;
    grid-template-columns: 0.75fr 1fr;
    gap: 1rem;
    height: 100%;
    align-items: stretch;
  }

  .data-story-preview__pyramid {
    display: grid;
    align-content: center;
    gap: 0.42rem;
    padding: 0.5rem;
  }

  .data-story-preview__pyramid span {
    display: grid;
    grid-template-columns: minmax(0, calc(var(--left) * 1%)) minmax(
        0,
        calc(var(--right) * 1%)
      );
    gap: 0.3rem;
    height: 0.52rem;
  }

  .data-story-preview__pyramid span::before,
  .data-story-preview__pyramid span::after {
    content: "";
    border-radius: 999px;
  }

  .data-story-preview__pyramid span::before {
    background: var(--preview-secondary);
    opacity: 0.58;
  }

  .data-story-preview__pyramid span::after {
    background: var(--preview-accent);
    opacity: 0.72;
  }

  .data-story-preview__map,
  .data-story-preview__election,
  .data-story-preview__timeline {
    height: 100%;
  }

  .data-story-preview svg {
    width: 100%;
    height: 100%;
    min-height: 8.5rem;
    overflow: visible;
  }

  .data-story-preview--hero svg {
    min-height: 16rem;
  }

  .data-story-preview__map path,
  .data-story-preview__election path {
    fill: rgba(243, 241, 235, 0.055);
    stroke: rgba(243, 241, 235, 0.18);
    stroke-width: 1;
  }

  .data-story-preview__map circle,
  .data-story-preview__election circle {
    fill: color-mix(in srgb, var(--preview-accent) 65%, transparent);
    stroke: rgba(17, 17, 17, 0.9);
    stroke-width: 1.5;
    opacity: 0.9;
  }

  .data-story-preview__election circle.is-opposition {
    fill: var(--preview-secondary);
  }

  .data-story-preview__timeline .gridline {
    fill: none;
    stroke: rgba(255, 255, 255, 0.08);
    stroke-dasharray: 3 4;
  }

  .data-story-preview__timeline rect {
    fill: color-mix(in srgb, var(--preview-accent) 45%, transparent);
  }

  .data-story-preview__timeline .primary-line,
  .data-story-preview__timeline .secondary-line {
    fill: none;
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .data-story-preview__timeline .primary-line {
    stroke: var(--preview-accent);
  }

  .data-story-preview__timeline .secondary-line {
    stroke: var(--preview-secondary);
    opacity: 0.78;
  }

  @media (max-width: 640px) {
    .data-story-preview,
    .data-story-preview--hero {
      min-height: 15rem;
    }

    .data-story-preview__chrome,
    .data-story-preview__footer,
    .data-story-preview--hero .data-story-preview__chrome,
    .data-story-preview--hero .data-story-preview__footer {
      padding: 0.8rem;
    }

    .data-story-preview__chrome {
      align-items: flex-start;
      flex-direction: column;
    }

    .data-story-preview__chrome span {
      max-width: none;
      text-align: left;
    }

    .data-story-preview__canvas,
    .data-story-preview--hero .data-story-preview__canvas {
      min-height: 9rem;
      padding: 0.85rem;
    }

    .data-story-preview--hero svg,
    .data-story-preview svg {
      min-height: 9rem;
    }

    .data-story-preview__footer {
      flex-wrap: wrap;
    }
  }
</style>
