---
import type { ImageMetadata } from "astro";
import Icon from "./Icon.astro";
import OptimizedImage from "./OptimizedImage.astro";
import PillarTag from "./ui/PillarTag.astro";
import TechBadge from "./ui/TechBadge.astro";
import type { PillarKey } from "../lib/site";

interface Props {
  title: string;
  description: string;
  href: string;
  eyebrow?: string | undefined;
  pillar?: PillarKey | undefined;
  meta?: string | undefined;
  role?: string | undefined;
  impact?: string | undefined;
  tags?: string[] | undefined;
  image?: string | ImageMetadata | undefined;
  imageAlt?: string | undefined;
  ctaLabel?: string | undefined;
  external?: boolean | undefined;
}

const {
  title,
  description,
  href,
  eyebrow,
  pillar,
  meta,
  role,
  impact,
  tags = [],
  image,
  imageAlt = title,
  ctaLabel = "View details",
  external = false,
} = Astro.props;

const imageSrc = image;
---

<article class="group flex h-full flex-col gap-4">
  {
    imageSrc && (
      <a
        href={href}
        target={external ? "_blank" : undefined}
        rel={external ? "noopener noreferrer" : undefined}
        aria-label={ctaLabel ? `${ctaLabel}: ${title}` : `Open ${title}`}
        class="block aspect-[1.36/1] overflow-hidden rounded-[20px] bg-white/[0.03] transition-all duration-500 group-hover:shadow-[0_20px_48px_rgba(0,0,0,0.35)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/70 focus-visible:ring-offset-2 focus-visible:ring-offset-background"
      >
        <OptimizedImage
          src={imageSrc}
          alt={imageAlt}
          class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.03]"
          loading="lazy"
          width={800}
          height={500}
        />
      </a>
    )
  }

  <div class="flex flex-1 flex-col">
    {
      (pillar || eyebrow || meta) && (
        <div class="mb-1 flex flex-wrap items-center gap-2">
          {pillar && <PillarTag pillar={pillar} />}
          {eyebrow && (
            <p
              class="text-[0.72rem] font-semibold uppercase tracking-[0.14em] text-primary"
              style="color: var(--premium-accent);"
            >
              {eyebrow}
            </p>
          )}
          {meta && (
            <p class="text-[0.72rem] uppercase tracking-[0.12em] text-muted-foreground">
              {meta}
            </p>
          )}
        </div>
      )
    }

    <h3
      class="text-[clamp(1.55rem,2vw,1.95rem)] font-display font-bold leading-[1.08] text-foreground transition-colors group-hover:text-primary"
    >
      <a
        href={href}
        target={external ? "_blank" : undefined}
        rel={external ? "noopener noreferrer" : undefined}
        class="transition-colors hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/70 focus-visible:ring-offset-2 focus-visible:ring-offset-background"
      >
        {title}
      </a>
    </h3>

    <p class="mt-2 text-[0.96rem] leading-7 text-muted-foreground">
      {description}
    </p>

    {
      (role || impact) && (
        <div class="mt-4 space-y-2 border-l border-white/10 pl-4">
          {role && (
            <p class="text-sm text-muted-foreground">
              <span class="font-medium text-foreground">Role:</span> {role}
            </p>
          )}
          {impact && (
            <p class="text-sm text-muted-foreground">
              <span class="font-medium text-foreground">Impact:</span> {impact}
            </p>
          )}
        </div>
      )
    }

    {
      tags.length > 0 && (
        <div class="mt-4 flex flex-wrap gap-2">
          {tags.map((tag) => (
            <TechBadge label={tag} />
          ))}
        </div>
      )
    }

    <div class="mt-5 pt-1">
      <a
        href={href}
        target={external ? "_blank" : undefined}
        rel={external ? "noopener noreferrer" : undefined}
        class="inline-flex items-center gap-2 text-[0.82rem] font-semibold tracking-wider uppercase text-foreground transition-all hover:gap-3 hover:text-primary"
      >
        {ctaLabel}
        <Icon
          name="arrow-right"
          size={16}
          class="transition-transform group-hover:translate-x-1"
        />
      </a>
    </div>
  </div>
</article>
