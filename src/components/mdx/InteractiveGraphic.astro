---
interface Props {
  src: string;
  title: string;
  height?: string;
}

const { src, title, height = "500px" } = Astro.props;
---

<div class="interactive-graphic-wrapper my-8 relative group">
  <!-- Fullscreen Button -->
  <button
    class="fullscreen-btn absolute top-3 right-3 z-10 p-2 bg-[#1a1a1a]/80 backdrop-blur-md rounded-lg border border-white/[0.08] text-[#a1a1aa] opacity-0 group-hover:opacity-100 transition-all duration-200 hover:bg-white/[0.1] hover:text-white focus:outline-none focus:ring-2 focus:ring-accent-500"
    aria-label="Tam Ekranda Aç"
    title="Tam Ekranda Aç"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path
        d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"
      ></path>
    </svg>
  </button>

  <!-- Iframe Container -->
  <div
    class="iframe-container bg-white/[0.02] rounded-xl overflow-hidden border border-white/[0.06] transition-all duration-300"
  >
    <iframe
      src={src}
      title={title}
      style={`height: ${height}; width: 100%; border: none;`}
      loading="lazy"
      class="w-full"></iframe>
  </div>
</div>

<script>
  // Add fullscreen functionality
  document
    .querySelectorAll(".interactive-graphic-wrapper")
    .forEach((wrapper) => {
      const btn = wrapper.querySelector(".fullscreen-btn");
      const iframe = wrapper.querySelector("iframe") as HTMLIFrameElement;

      if (btn && iframe) {
        btn.addEventListener("click", () => {
          if (!document.fullscreenElement) {
            wrapper.requestFullscreen().catch((err) => {
              console.error(
                `Error attempting to enable fullscreen: ${err.message}`,
              );
            });
          } else {
            document.exitFullscreen();
          }
        });
      }
    });

  // Handle fullscreen change events to adjust styling
  document.addEventListener("fullscreenchange", () => {
    const fullscreenElement = document.fullscreenElement;
    if (
      fullscreenElement &&
      fullscreenElement.classList.contains("interactive-graphic-wrapper")
    ) {
      const iframe = fullscreenElement.querySelector(
        "iframe",
      ) as HTMLIFrameElement;
      if (iframe) {
        // Store original height
        iframe.dataset.originalHeight = iframe.style.height;
        iframe.style.height = "100vh";
        fullscreenElement.classList.add("bg-[#111111]", "p-4");
        fullscreenElement
          .querySelector(".iframe-container")
          ?.classList.remove("rounded-xl", "border");
      }
    } else {
      // Revert styles when exiting fullscreen
      document
        .querySelectorAll(".interactive-graphic-wrapper iframe")
        .forEach((iframeEl) => {
          const iframe = iframeEl as HTMLIFrameElement;
          if (iframe.dataset.originalHeight) {
            iframe.style.height = iframe.dataset.originalHeight;
          }
        });
      document
        .querySelectorAll(".interactive-graphic-wrapper")
        .forEach((wrapper) => {
          wrapper.classList.remove("bg-[#111111]", "p-4");
          wrapper
            .querySelector(".iframe-container")
            ?.classList.add("rounded-xl", "border");
        });
    }
  });
</script>

<style>
  /* Optional: Make scrollbars invisible or styled for the wrapper if needed */
  .interactive-graphic-wrapper:fullscreen {
    overflow: hidden;
  }
</style>
