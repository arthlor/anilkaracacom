---
interface Props {
  id: string;
  /** Kept for existing MDX; step labels are no longer shown. */
  label?: string;
  title?: string;
  summary?: string;
}

const { id, title, summary } = Astro.props;
---

<div id={id} data-scrolly-step={id} class="scrolly-step-block">
  <div class="scrolly-step-card">
    {title && <h3 class="scrolly-step-title">{title}</h3>}
    {summary && <p class="scrolly-step-summary">{summary}</p>}
    <div class="scrolly-step-body">
      <slot />
    </div>
  </div>
</div>

<style>
  .scrolly-step-block {
    display: flex;
    align-items: center;
    min-height: 70vh;
    padding-bottom: 25vh;
    scroll-margin-top: 7rem;
  }

  .scrolly-step-block:first-child {
    padding-top: 10vh;
  }

  .scrolly-step-block:last-child {
    padding-bottom: 40vh;
  }

  .scrolly-step-card {
    background: hsl(var(--card) / 0.92);
    border: 1px solid hsl(var(--border));
    border-radius: 18px;
    padding: 1.5rem;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    transition:
      border-color 240ms ease,
      background 240ms ease,
      box-shadow 240ms ease,
      transform 240ms ease;
    width: 100%;
  }

  :global(.scrolly-step-block[data-active="true"]) .scrolly-step-card {
    border-color: hsl(var(--foreground) / 0.28);
    background: hsl(var(--card));
  }

  .scrolly-step-card .scrolly-step-title {
    font-size: 1.3125rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    margin-top: 0;
    margin-bottom: 0.75rem;
    color: hsl(var(--foreground));
  }

  .scrolly-step-card .scrolly-step-summary {
    margin-bottom: 0;
    font-size: 0.9rem;
    color: hsl(var(--muted-foreground));
    line-height: 1.6;
  }

  .scrolly-step-body {
    margin-top: 1rem;
    font-size: 0.875rem;
    line-height: 1.6;
    color: hsl(var(--foreground) / 0.84);
  }

  .scrolly-step-body :global(p:last-child) {
    margin-bottom: 0;
  }

  :global([data-scrolly-mode="immersive"]) .scrolly-step-block {
    min-height: max(76svh, 620px);
    padding-block: clamp(5rem, 12svh, 9rem);
  }

  :global([data-scrolly-mode="immersive"]) .scrolly-step-block:first-child,
  :global([data-scrolly-mode="immersive"]) .scrolly-step-block:last-child {
    padding-block: clamp(5rem, 12svh, 9rem);
  }

  :global([data-scrolly-mode="immersive"]) .scrolly-step-card {
    position: relative;
    overflow: hidden;
  }

  @media (max-width: 1279px) {
    :global([data-scrolly-mode="pager"]) .scrolly-step-block {
      display: none;
      min-height: auto !important;
      padding-top: 0 !important;
      padding-bottom: 0 !important;
    }
    :global([data-scrolly-mode="pager"])
      :global(.scrolly-step-block[data-active="true"]) {
      display: block !important;
    }
    :global([data-scrolly-mode="pager"]) .scrolly-step-card {
      background: hsl(var(--card) / 0.5);
      backdrop-filter: none;
      box-shadow: none;
      border-color: hsl(var(--border));
    }
    :global([data-scrolly-mode="pager"])
      :global(.scrolly-step-block[data-active="true"])
      .scrolly-step-card {
      border-color: hsl(var(--foreground) / 0.28);
      background: hsl(var(--card));
    }
  }

  @media (max-width: 1023px) {
    /* Each card is followed by the gap set on the scrolly container, so the
       block top is the card top and hash links land like the step controls. */
    :global([data-scrolly-mode="immersive"]) .scrolly-step-block {
      display: block !important;
      min-height: 0;
      padding: 0 0 var(--scrolly-step-gap, 82svh);
      pointer-events: none;
      scroll-margin-top: calc(
        var(--scrolly-sticky-offset, 68px) +
          var(--immersive-canvas-height, 420px) - var(--nav-h)
      );
    }

    :global([data-scrolly-mode="immersive"]) .scrolly-step-block:first-child {
      padding: 0 0 var(--scrolly-step-gap, 82svh);
    }

    :global([data-scrolly-mode="immersive"]) .scrolly-step-block:last-child {
      padding-top: 0;
      padding-bottom: var(--scrolly-end-space, 70svh);
    }

    :global([data-scrolly-mode="immersive"]) .scrolly-step-card {
      max-width: 42rem;
      margin-inline: auto;
      background: hsl(var(--card) / 0.96);
      box-shadow:
        0 18px 48px hsl(var(--foreground) / 0.14),
        0 2px 6px hsl(var(--foreground) / 0.06);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      pointer-events: auto;
    }
  }

  @media (max-width: 420px) {
    :global([data-scrolly-mode="immersive"]) .scrolly-step-card {
      padding: 1.2rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scrolly-step-card {
      transition: none;
    }
  }
</style>
