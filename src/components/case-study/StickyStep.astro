---
interface Props {
  id: string;
  label: string;
  title?: string;
  summary?: string;
}

const { id, label, title, summary } = Astro.props;
---

<div id={id} data-scrolly-step={id} class="scrolly-step-block">
  <div class="scrolly-step-card">
    <span class="scrolly-step-badge">{label}</span>
    {title && <h3 class="scrolly-step-title">{title}</h3>}
    {summary && <p class="scrolly-step-summary">{summary}</p>}
    <div class="scrolly-step-body">
      <slot />
    </div>
  </div>
</div>

<style>
  .scrolly-step-block {
    display: flex;
    align-items: center;
    min-height: 70vh;
    padding-bottom: 25vh;
    scroll-margin-top: 7rem;
  }

  .scrolly-step-block:first-child {
    padding-top: 10vh;
  }

  .scrolly-step-block:last-child {
    padding-bottom: 40vh;
  }

  .scrolly-step-card {
    background: hsl(var(--card) / 0.76);
    border: 1px solid hsl(var(--border));
    border-radius: 12px;
    padding: 1.5rem;
    backdrop-filter: blur(8px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
    transition:
      border-color 240ms ease,
      background 240ms ease,
      box-shadow 240ms ease,
      transform 240ms ease;
    width: 100%;
  }

  :global(.scrolly-step-block[data-active="true"]) .scrolly-step-card {
    border-color: hsl(var(--primary) / 0.5);
    box-shadow: 0 18px 52px hsl(var(--primary) / 0.09);
    background: hsl(var(--card) / 0.92);
  }

  .scrolly-step-badge {
    display: inline-block;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: hsl(var(--primary));
    margin-bottom: 0.5rem;
  }

  .scrolly-step-card .scrolly-step-title {
    font-size: 1.35rem;
    font-weight: 700;
    margin-top: 0;
    margin-bottom: 0.75rem;
    color: hsl(var(--foreground));
  }

  .scrolly-step-card .scrolly-step-summary {
    margin-bottom: 0;
    font-size: 0.9rem;
    color: hsl(var(--muted-foreground));
    line-height: 1.6;
  }

  .scrolly-step-body {
    margin-top: 1rem;
    font-size: 0.875rem;
    line-height: 1.6;
    color: hsl(var(--foreground) / 0.84);
  }

  .scrolly-step-body :global(p:last-child) {
    margin-bottom: 0;
  }

  :global([data-scrolly-mode="immersive"]) .scrolly-step-block {
    min-height: max(76svh, 620px);
    padding-block: clamp(5rem, 12svh, 9rem);
  }

  :global([data-scrolly-mode="immersive"]) .scrolly-step-block:first-child,
  :global([data-scrolly-mode="immersive"]) .scrolly-step-block:last-child {
    padding-block: clamp(5rem, 12svh, 9rem);
  }

  :global([data-scrolly-mode="immersive"]) .scrolly-step-card {
    position: relative;
    overflow: hidden;
    border-radius: 14px;
    background: hsl(var(--card) / 0.68);
  }

  :global([data-scrolly-mode="immersive"]) .scrolly-step-card::before {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 2px;
    background: linear-gradient(
      180deg,
      transparent,
      hsl(var(--primary) / 0.92),
      transparent
    );
    content: "";
    opacity: 0;
    transform: scaleY(0.35);
    transition:
      opacity 240ms ease,
      transform 240ms ease;
  }

  :global([data-scrolly-mode="immersive"])
    :global(.scrolly-step-block[data-active="true"])
    .scrolly-step-card::before {
    opacity: 1;
    transform: scaleY(1);
  }

  @media (max-width: 1279px) {
    :global([data-scrolly-mode="pager"]) .scrolly-step-block {
      display: none;
      min-height: auto !important;
      padding-top: 0 !important;
      padding-bottom: 0 !important;
    }
    :global([data-scrolly-mode="pager"])
      :global(.scrolly-step-block[data-active="true"]) {
      display: block !important;
    }
    :global([data-scrolly-mode="pager"]) .scrolly-step-card {
      background: hsl(var(--card) / 0.5);
      backdrop-filter: none;
      box-shadow: none;
      border-color: hsl(var(--border));
    }
    :global([data-scrolly-mode="pager"])
      :global(.scrolly-step-block[data-active="true"])
      .scrolly-step-card {
      border-color: hsl(var(--primary) / 0.3);
      box-shadow: 0 4px 20px hsl(var(--primary) / 0.08);
      background: hsl(var(--card) / 0.72);
    }
  }

  @media (max-width: 1023px) {
    :global([data-scrolly-mode="immersive"]) .scrolly-step-block {
      display: flex !important;
      min-height: max(72svh, 520px);
      align-items: flex-end;
      padding-block: clamp(4rem, 10svh, 7rem);
      pointer-events: none;
    }

    :global([data-scrolly-mode="immersive"]) .scrolly-step-card {
      max-width: 42rem;
      margin-inline: auto;
      background: hsl(var(--card) / 0.94);
      box-shadow: 0 22px 70px rgba(0, 0, 0, 0.24);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      pointer-events: auto;
    }
  }

  @media (max-width: 420px) {
    :global([data-scrolly-mode="immersive"]) .scrolly-step-block {
      min-height: max(68svh, 480px);
      padding-block: 3.5rem;
    }

    :global([data-scrolly-mode="immersive"]) .scrolly-step-card {
      padding: 1.2rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scrolly-step-card,
    :global([data-scrolly-mode="immersive"]) .scrolly-step-card::before {
      transition: none;
    }
  }
</style>
