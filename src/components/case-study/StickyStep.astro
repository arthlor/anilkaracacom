---
interface Props {
  id: string;
  label: string;
  title?: string;
  summary?: string;
}

const { id, label, title, summary } = Astro.props;
---

<div
  id={id}
  data-scrolly-step={id}
  class="scrolly-step-block"
>
  <div class="scrolly-step-card">
    <span class="scrolly-step-badge">{label}</span>
    {title && <h3 class="scrolly-step-title">{title}</h3>}
    {summary && <p class="scrolly-step-summary">{summary}</p>}
    <div class="scrolly-step-body">
      <slot />
    </div>
  </div>
</div>

<style>
  .scrolly-step-block {
    display: flex;
    align-items: center;
    min-height: 70vh;
    padding-bottom: 25vh;
  }

  .scrolly-step-block:first-child {
    padding-top: 10vh;
  }

  .scrolly-step-block:last-child {
    padding-bottom: 40vh;
  }

  .scrolly-step-card {
    background: rgba(25, 25, 25, 0.75);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 1.5rem;
    backdrop-filter: blur(8px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
    transition: all 0.3s ease;
    width: 100%;
  }

  :global(.scrolly-step-block[data-active="true"]) .scrolly-step-card {
    border-color: #3b82f6;
    box-shadow: 0 10px 40px rgba(59, 130, 246, 0.15);
    background: rgba(25, 25, 25, 0.9);
  }

  .scrolly-step-badge {
    display: inline-block;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: #3b82f6;
    margin-bottom: 0.5rem;
  }

  .scrolly-step-title {
    font-size: 1.35rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
    color: #ffffff;
  }

  .scrolly-step-summary {
    font-size: 0.9rem;
    color: #a1a1aa;
    line-height: 1.6;
  }

  .scrolly-step-body {
    margin-top: 1rem;
    font-size: 0.875rem;
    line-height: 1.6;
    color: #d4d4d8;
  }

  @media (max-width: 1279px) {
    .scrolly-step-block {
      display: none;
      min-height: auto !important;
      padding-top: 0 !important;
      padding-bottom: 0 !important;
    }
    :global(.scrolly-step-block[data-active="true"]) {
      display: block !important;
    }
    .scrolly-step-card {
      background: rgba(25, 25, 25, 0.5);
      backdrop-filter: none;
      box-shadow: none;
      border-color: rgba(255, 255, 255, 0.05);
    }
    :global(.scrolly-step-block[data-active="true"]) .scrolly-step-card {
      border-color: rgba(59, 130, 246, 0.3);
      box-shadow: 0 4px 20px rgba(59, 130, 246, 0.08);
      background: rgba(25, 25, 25, 0.7);
    }
  }
</style>
