---
import { getStoryStepById } from "../../lib/storyStepContext";

interface Props {
  id: string;
  label?: string;
  title?: string;
  summary?: string;
}

const { id, label, title, summary } = Astro.props;

const stepMeta = getStoryStepById(id);
const resolvedLabel = label ?? stepMeta?.label;
const resolvedTitle = title ?? stepMeta?.title ?? id;
const resolvedSummary = summary ?? stepMeta?.summary ?? "";
---

<section
  id={id}
  data-story-step
  class="grid gap-5 border-t border-white/[0.055] px-0 py-5 first:border-t-0 md:gap-6 md:py-7"
>
  <div class="max-w-4xl space-y-2 px-3 md:px-5">
    {
      resolvedLabel && (
        <p class="text-[10px] font-bold uppercase tracking-[0.16em] text-primary/70">
          {resolvedLabel}
        </p>
      )
    }
    <h3
      class="font-display text-2xl font-bold leading-tight text-foreground sm:text-[1.7rem]"
    >
      {resolvedTitle}
    </h3>
    {
      resolvedSummary && (
        <p
          class="max-w-3xl text-sm leading-6 text-muted-foreground/90 sm:text-base"
        >
          {resolvedSummary}
        </p>
      )
    }
    <div class="prose-article max-w-3xl text-sm leading-relaxed">
      <slot />
    </div>
  </div>

  <div class="min-w-0 w-full overflow-hidden">
    <slot name="visual" />
  </div>
</section>
