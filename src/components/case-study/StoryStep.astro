---
interface Props {
  id: string;
  label?: string;
  title: string;
  summary: string;
}

const { id, label, title, summary } = Astro.props;
---

<section
  id={id}
  data-story-step
  class="page-frame-soft grid gap-8 p-6 md:p-8 lg:min-h-[78vh] lg:grid-cols-[minmax(0,0.85fr)_minmax(320px,0.95fr)] lg:items-start"
>
  <div class="space-y-5">
    {label && <p class="page-kicker">{label}</p>}
    <h3 class="text-3xl font-display font-bold text-foreground">{title}</h3>
    <p class="text-base leading-relaxed text-muted-foreground">{summary}</p>
    <div class="prose-article max-w-none">
      <slot />
    </div>
  </div>

  <div class="lg:sticky lg:top-28">
    <div class="page-frame p-4">
      <slot name="visual" />
    </div>
  </div>
</section>
