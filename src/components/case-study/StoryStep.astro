---
interface Props {
  id: string;
  label?: string;
  title: string;
  summary: string;
}

const { id, label, title, summary } = Astro.props;
---

<section
  id={id}
  data-story-step
  class="grid gap-10 p-5 md:p-8 xl:min-h-[88vh] xl:grid-cols-[minmax(0,0.32fr)_minmax(520px,1.68fr)] xl:items-start border-t border-white/[0.04] first:border-t-0"
>
  <div class="space-y-6">
    {label && (
      <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-primary/70">{label}</p>
    )}
    <h3 class="text-3xl font-display font-bold text-foreground leading-tight">{title}</h3>
    <p class="text-base leading-relaxed text-muted-foreground/90">{summary}</p>
    <div class="prose-article max-w-none text-sm leading-relaxed">
      <slot />
    </div>
  </div>

  <div class="xl:sticky xl:top-28 min-w-0 w-full overflow-visible">
    <slot name="visual" />
  </div>
</section>
