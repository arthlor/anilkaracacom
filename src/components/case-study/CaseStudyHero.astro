---
import type { CollectionEntry } from "astro:content";

import Icon from "../Icon.astro";
import OptimizedImage from "../OptimizedImage.astro";
import MetricCard from "../ui/MetricCard.astro";
import PillarTag from "../ui/PillarTag.astro";
import TechBadge from "../ui/TechBadge.astro";

interface Props {
  entry: CollectionEntry<"articles"> | CollectionEntry<"projects">;
  collection: "articles" | "projects";
  locale: {
    backLabel: string;
    publishedLabel: string;
    roleLabel: string;
    impactLabel: string;
    summaryLabel: string;
    methodologyLabel: string;
  };
}

const { entry, collection, locale } = Astro.props;
const backHref = collection === "articles" ? "/articles" : "/projects";
const isPublishedArticle = collection === "articles" && entry.data.published;
const formattedDate = entry.data.pubDate.toLocaleDateString(
  entry.data.language === "tr" ? "tr-TR" : "en-US",
  {
    year: "numeric",
    month: "long",
    day: "numeric",
  },
);
const demoUrl =
  "demoUrl" in entry.data
    ? entry.data.demoUrl || entry.data.liveUrl
    : undefined;
const githubUrl = "githubUrl" in entry.data ? entry.data.githubUrl : undefined;
const heroSummary = isPublishedArticle
  ? entry.data.executiveSummary.split(/[.!?]/).filter(Boolean)[0]?.trim() ||
    entry.data.executiveSummary
  : entry.data.executiveSummary;
const heroImageFit =
  collection === "projects" &&
  (entry.id === "yeser" || entry.id === "ai-fit-check")
    ? "contain"
    : "cover";
---

<section
  class:list={[
    "relative overflow-hidden pt-24 pb-10 md:pt-28 md:pb-16",
    isPublishedArticle && "case-study-hero-shell--article",
  ]}
>
  <div class="container-standard">
    <div class="case-study-hero">
      <a href={backHref} class="case-study-hero__back">
        <Icon name="arrow-left" size={16} />
        {locale.backLabel}
      </a>

      <div class="case-study-hero__grid">
        <div class="case-study-hero__copy">
          <div class="case-study-hero__meta">
            <PillarTag pillar={entry.data.pillar} />
            <span class="case-study-hero__date">
              {locale.publishedLabel}: {formattedDate}
            </span>
          </div>

          <h1>{entry.data.title}</h1>
          <p class="case-study-hero__lede">{entry.data.description}</p>

          <div class="case-study-hero__stack">
            {entry.data.techStack.map((item) => <TechBadge label={item} />)}
          </div>

          {
            !isPublishedArticle && (
              <div class="case-study-hero__summary">
                <p class="case-study-hero__label">{locale.summaryLabel}</p>
                <p class="case-study-hero__summary-copy">{heroSummary}</p>

                {(entry.data.role || entry.data.impact) && (
                  <div class="case-study-hero__facts">
                    {entry.data.role && (
                      <div class="case-study-hero__fact">
                        <p class="case-study-hero__fact-label">
                          {locale.roleLabel}
                        </p>
                        <p class="case-study-hero__fact-copy">
                          {entry.data.role}
                        </p>
                      </div>
                    )}
                    {entry.data.impact && (
                      <div class="case-study-hero__fact">
                        <p class="case-study-hero__fact-label">
                          {locale.impactLabel}
                        </p>
                        <p class="case-study-hero__fact-copy">
                          {entry.data.impact}
                        </p>
                      </div>
                    )}
                  </div>
                )}

                {(demoUrl || githubUrl) && (
                  <div class="case-study-hero__actions">
                    {demoUrl && (
                      <a
                        href={demoUrl}
                        target={
                          demoUrl.startsWith("http") ? "_blank" : undefined
                        }
                        rel={
                          demoUrl.startsWith("http")
                            ? "noopener noreferrer"
                            : undefined
                        }
                        class="case-study-hero__action case-study-hero__action--primary"
                      >
                        Open live project
                        <Icon name="arrow-right" size={16} />
                      </a>
                    )}
                    {githubUrl && (
                      <a
                        href={githubUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="case-study-hero__action case-study-hero__action--secondary"
                      >
                        View source
                        <Icon name="external-link" size={16} />
                      </a>
                    )}
                  </div>
                )}
              </div>
            )
          }
        </div>

        <div class="case-study-hero__side">
          {
            entry.data.heroImage && (
              <div class="case-study-hero__media">
                <OptimizedImage
                  src={entry.data.heroImage}
                  alt={entry.data.title}
                  class:list={[
                    "aspect-[16/11] h-full w-full",
                    heroImageFit === "contain"
                      ? "object-contain p-8 sm:p-10 scale-[1.1]"
                      : "object-cover",
                  ]}
                  loading="eager"
                  width={1200}
                  height={825}
                />
              </div>
            )
          }

          {
            !isPublishedArticle && (
              <div class="case-study-hero__metrics">
                {entry.data.metrics.map((metric) => (
                  <MetricCard
                    label={metric.label}
                    value={metric.value}
                    detail={metric.detail}
                  />
                ))}
              </div>
            )
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .case-study-hero {
    position: relative;
    padding: clamp(1.4rem, 2vw, 2rem);
  }

  .case-study-hero__back {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: hsl(var(--muted-foreground));
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: color 180ms ease;
  }

  .case-study-hero__back:hover {
    color: hsl(var(--foreground));
  }

  .case-study-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(320px, 0.95fr);
    gap: 2rem;
    margin-top: 1.25rem;
    align-items: start;
  }

  .case-study-hero__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  .case-study-hero__date {
    display: inline-flex;
    align-items: center;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: hsl(var(--muted-foreground));
  }

  .case-study-hero h1 {
    max-width: 14ch;
    margin-top: 1.15rem;
    font-family: var(--font-display);
    font-size: 5rem;
    font-weight: 700;
    line-height: 0.94;
    letter-spacing: 0;
    color: hsl(var(--foreground));
  }

  .case-study-hero__lede {
    max-width: 44rem;
    margin-top: 1rem;
    font-size: 1.05rem;
    line-height: 1.75;
    color: hsl(var(--muted-foreground));
  }

  .case-study-hero__stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 1.15rem;
  }

  .case-study-hero__summary {
    margin-top: 1.35rem;
    padding: 1rem 0 0;
    border-top: 1px solid hsl(var(--border));
  }

  .case-study-hero__label,
  .case-study-hero__fact-label {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .case-study-hero__label {
    color: var(--premium-accent);
  }

  .case-study-hero__summary-copy {
    margin-top: 0.65rem;
    font-size: 1rem;
    line-height: 1.65;
    color: hsl(var(--foreground));
  }

  .case-study-hero__facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .case-study-hero__fact {
    padding-top: 1rem;
    border-top: 1px solid hsl(var(--border));
  }

  .case-study-hero__fact-label {
    color: hsl(var(--muted-foreground));
  }

  .case-study-hero__fact-copy {
    margin-top: 0.55rem;
    font-size: 0.95rem;
    line-height: 1.75;
    color: hsl(var(--foreground));
  }

  .case-study-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 1.5rem;
  }

  .case-study-hero__action {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 3rem;
    padding: 0.85rem 1.2rem;
    font-size: 0.84rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transition:
      border-color 180ms ease,
      background 180ms ease,
      color 180ms ease,
      transform 180ms ease;
  }

  .case-study-hero__action:hover {
    transform: translateY(-1px);
  }

  .case-study-hero__action--primary {
    background: var(--premium-accent);
    color: var(--premium-dark);
  }

  .case-study-hero__action--secondary {
    border: 1px solid hsl(var(--border));
    background: hsl(var(--card));
    color: hsl(var(--foreground));
  }

  .case-study-hero__action--secondary:hover {
    border-color: rgba(122, 242, 152, 0.35);
    color: hsl(var(--primary));
  }

  .case-study-hero__side {
    display: grid;
    gap: 1.1rem;
  }

  .case-study-hero__media {
    overflow: hidden;
    border-radius: 12px;
  }

  .case-study-hero__metrics {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  @media (max-width: 1080px) {
    .case-study-hero__grid {
      grid-template-columns: 1fr;
    }

    .case-study-hero h1 {
      max-width: 100%;
      font-size: 4rem;
    }
  }

  :global(.case-study-hero-shell--article) .case-study-hero {
    padding-block: clamp(1rem, 1.6vw, 1.5rem);
  }

  :global(.case-study-hero-shell--article) .case-study-hero h1 {
    max-width: 16ch;
  }

  :global(.case-study-hero-shell--article) .case-study-hero__lede {
    max-width: 38rem;
  }

  :global(.case-study-hero-shell--article) .case-study-hero__summary {
    max-width: 44rem;
  }

  @media (max-width: 760px) {
    :global(.case-study-hero-shell--article) .case-study-hero__side {
      display: none;
    }

    :global(.case-study-hero-shell--article) .case-study-hero__stack {
      display: none;
    }

    :global(.case-study-hero-shell--article) .case-study-hero__summary {
      margin-top: 1rem;
    }
  }

  @media (max-width: 640px) {
    .case-study-hero {
      padding: 1rem;
    }

    .case-study-hero h1 {
      font-size: 2.5rem;
      line-height: 0.98;
    }

    .case-study-hero__lede {
      font-size: 0.98rem;
      line-height: 1.6;
    }

    .case-study-hero__facts,
    .case-study-hero__metrics {
      grid-template-columns: 1fr;
    }

    .case-study-hero__actions {
      flex-direction: column;
    }

    .case-study-hero__action {
      justify-content: center;
    }
  }
</style>
