---
import { getStorySteps } from "../../lib/storyStepContext";

interface Step {
  id: string;
  label: string;
  title?: string;
  summary?: string;
}

interface Props {
  steps?: Step[];
}

const { steps: stepsProp } = Astro.props;
const steps = stepsProp?.length ? stepsProp : getStorySteps();
---

<section class="article-story-shell my-10 md:my-14" data-story-root>
  <div
    class="relative z-10 mb-5 -mx-4 border-b border-white/[0.055] px-4 py-2.5 md:mx-0 md:mb-7 md:px-1"
  >
    <div
      class="flex items-center gap-4 overflow-x-auto no-scrollbar"
      data-story-nav-root
    >
      <div class="flex gap-2">
        {
          steps.map((step, index) => (
            <a
              href={`#${step.id}`}
              data-story-nav
              data-story-target={step.id}
              data-active={index === 0 ? "true" : "false"}
              aria-current={index === 0 ? "step" : undefined}
              class:list={[
                "whitespace-nowrap border-b px-1.5 py-2 text-[10px] font-bold uppercase tracking-[0.12em] transition-all duration-300 sm:px-2.5 sm:text-[11px]",
                index === 0
                  ? "border-primary/60 text-primary"
                  : "border-transparent text-[#71717a] hover:border-white/[0.18] hover:text-[#a1a1aa]",
              ]}
            >
              {step.label}
            </a>
          ))
        }
      </div>
    </div>
  </div>
  <div class="space-y-8 md:space-y-10">
    <slot />
  </div>
</section>

<style>
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  [data-story-nav] {
    min-height: 2rem;
  }

  [data-story-nav][data-active="true"] {
    box-shadow: none;
  }
</style>

<script is:inline>
  document.querySelectorAll("[data-story-root]").forEach((root) => {
    if (!(root instanceof HTMLElement) || root.dataset.storyBound === "true") {
      return;
    }

    root.dataset.storyBound = "true";

    const navLinks = Array.from(root.querySelectorAll("[data-story-nav]"));
    const storySteps = Array.from(root.querySelectorAll("[data-story-step]"));

    if (navLinks.length === 0 || storySteps.length === 0) {
      return;
    }

    const setActive = (stepId) => {
      navLinks.forEach((link) => {
        if (!(link instanceof HTMLElement)) {
          return;
        }

        const isActive = link.dataset.storyTarget === stepId;
        link.dataset.active = String(isActive);
        if (isActive) {
          link.setAttribute("aria-current", "step");
        } else {
          link.removeAttribute("aria-current");
        }
        link.classList.toggle("border-primary/60", isActive);
        link.classList.toggle("text-primary", isActive);
        link.classList.toggle("border-transparent", !isActive);
        link.classList.toggle("text-[#71717a]", !isActive);
      });
    };

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];

        if (visible) {
          setActive(visible.target.id);
        }
      },
      { threshold: [0.25, 0.45, 0.7], rootMargin: "-10% 0px -25% 0px" },
    );

    storySteps.forEach((step) => observer.observe(step));
  });
</script>
