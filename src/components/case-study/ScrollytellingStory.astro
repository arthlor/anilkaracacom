---
interface Step {
  id: string;
  label: string;
  title?: string;
  summary?: string;
}

interface Props {
  steps: Step[];
}

const { steps } = Astro.props;
---

<section class="my-16" data-story-root>
  <div class="sticky top-[78px] z-40 mb-12 -mx-4 px-4 py-4 backdrop-blur-lg bg-[#111111]/90 border-y border-white/10 md:mx-0 md:rounded-2xl md:border md:top-24">
    <div class="flex items-center gap-4 overflow-x-auto no-scrollbar" data-story-nav-root>
      <div class="flex gap-2">
        {steps.map((step, index) => (
          <a
            href={`#${step.id}`}
            data-story-nav
            data-story-target={step.id}
            class:list={[
              'whitespace-nowrap rounded-full border px-5 py-2 text-xs font-bold uppercase tracking-widest transition-all duration-300',
              index === 0 
                ? 'border-primary bg-primary text-black' 
                : 'border-white/10 bg-white/5 text-muted-foreground hover:border-white/20 hover:bg-white/10 hover:text-foreground',
            ]}
          >
            {step.label}
          </a>
        ))}
      </div>
    </div>
  </div>
  <div class="space-y-16">
    <slot />
  </div>
</section>

<style>
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

<script is:inline>
  document.querySelectorAll('[data-story-root]').forEach((root) => {
    if (!(root instanceof HTMLElement) || root.dataset.storyBound === 'true') {
      return;
    }

    root.dataset.storyBound = 'true';

    const navLinks = Array.from(root.querySelectorAll('[data-story-nav]'));
    const storySteps = Array.from(root.querySelectorAll('[data-story-step]'));

    if (navLinks.length === 0 || storySteps.length === 0) {
      return;
    }

    const setActive = (stepId) => {
      navLinks.forEach((link) => {
        if (!(link instanceof HTMLElement)) {
          return;
        }

        const isActive = link.dataset.storyTarget === stepId;
        link.classList.toggle('border-primary', isActive);
        link.classList.toggle('bg-primary', isActive);
        link.classList.toggle('text-black', isActive);
        link.classList.toggle('border-white/10', !isActive);
        link.classList.toggle('bg-white/5', !isActive);
        link.classList.toggle('text-muted-foreground', !isActive);
      });
    };

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];

        if (visible) {
          setActive(visible.target.id);
        }
      },
      { threshold: [0.25, 0.45, 0.7], rootMargin: '-10% 0px -25% 0px' },
    );

    storySteps.forEach((step) => observer.observe(step));
  });
</script>
