---
interface Step {
  id: string;
  label: string;
  title?: string;
  summary?: string;
}

interface Props {
  steps: Step[];
}

const { steps } = Astro.props;
---

<section class="article-story-shell my-20" data-story-root>
  <div class="sticky top-[78px] z-40 mb-12 -mx-4 px-4 py-3 backdrop-blur-xl bg-[#111111]/84 border-b border-white/[0.06] md:mx-0 md:rounded-[24px] md:border md:border-white/[0.06] md:top-24 lg:mb-14 lg:px-5">
    <div class="flex items-center gap-4 overflow-x-auto no-scrollbar" data-story-nav-root>
      <div class="flex gap-2">
        {steps.map((step, index) => (
          <a
            href={`#${step.id}`}
            data-story-nav
            data-story-target={step.id}
            class:list={[
              'whitespace-nowrap rounded-full border px-5 py-2 text-[11px] font-bold uppercase tracking-[0.18em] transition-all duration-300',
              index === 0 
                ? 'border-primary/30 bg-primary/10 text-primary' 
                : 'border-white/[0.04] bg-white/[0.03] text-[#71717a] hover:border-white/[0.08] hover:bg-white/[0.05] hover:text-[#a1a1aa]',
            ]}
          >
            {step.label}
          </a>
        ))}
      </div>
    </div>
  </div>
  <div class="space-y-[4.5rem]">
    <slot />
  </div>
</section>

<style>
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

<script is:inline>
  document.querySelectorAll('[data-story-root]').forEach((root) => {
    if (!(root instanceof HTMLElement) || root.dataset.storyBound === 'true') {
      return;
    }

    root.dataset.storyBound = 'true';

    const navLinks = Array.from(root.querySelectorAll('[data-story-nav]'));
    const storySteps = Array.from(root.querySelectorAll('[data-story-step]'));

    if (navLinks.length === 0 || storySteps.length === 0) {
      return;
    }

    const setActive = (stepId) => {
      navLinks.forEach((link) => {
        if (!(link instanceof HTMLElement)) {
          return;
        }

        const isActive = link.dataset.storyTarget === stepId;
        link.classList.toggle('border-primary/30', isActive);
        link.classList.toggle('bg-primary/10', isActive);
        link.classList.toggle('text-primary', isActive);
        link.classList.toggle('border-white/[0.04]', !isActive);
        link.classList.toggle('bg-white/[0.03]', !isActive);
        link.classList.toggle('text-[#71717a]', !isActive);
      });
    };

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];

        if (visible) {
          setActive(visible.target.id);
        }
      },
      { threshold: [0.25, 0.45, 0.7], rootMargin: '-10% 0px -25% 0px' },
    );

    storySteps.forEach((step) => observer.observe(step));
  });
</script>
