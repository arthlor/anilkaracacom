---
interface Props {
  mode?: "pager" | "immersive";
}

const { mode = "pager" } = Astro.props;

// "stage" sits under the visual (pager, desktop immersive); "dock" is the
// fixed bottom control bar used by immersive mode on small screens.
const navVariants = mode === "immersive" ? ["stage", "dock"] : ["stage"];
---

<div
  class="sticky-scrolly-container my-12 md:my-20"
  data-scrolly-root
  data-story-root
  data-scrolly-mode={mode}
>
  <div class="sticky-scrolly-grid">
    <div class="scrolly-narrative-col">
      <slot />
    </div>

    <div class="scrolly-visual-col">
      <div class="sticky-visual-stage">
        <div class="sticky-visual-wrapper">
          <slot name="visual" />
        </div>

        {
          navVariants.includes("stage") && (
            <nav
              class="scrolly-mobile-nav"
              data-scrolly-nav="stage"
              aria-label="Story chapters"
            >
              <button
                type="button"
                class="scrolly-nav-btn scrolly-nav-btn--prev"
                aria-label="Previous step"
              >
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <polyline points="15 18 9 12 15 6" />
                </svg>
              </button>

              <div class="scrolly-progress" aria-hidden="true">
                <span class="scrolly-progress__current">01</span>
                <span class="scrolly-progress__divider" />
                <span class="scrolly-progress__total">03</span>
              </div>

              <div class="scrolly-nav-dots" />

              <button
                type="button"
                class="scrolly-nav-btn scrolly-nav-btn--next"
                aria-label="Next step"
              >
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <polyline points="9 18 15 12 9 6" />
                </svg>
              </button>
            </nav>
          )
        }
      </div>
    </div>
  </div>

  {
    navVariants.includes("dock") && (
      <nav
        class="scrolly-mobile-nav scrolly-dock"
        data-scrolly-nav="dock"
        aria-label="Story chapters"
      >
        <button
          type="button"
          class="scrolly-nav-btn scrolly-nav-btn--prev"
          aria-label="Previous step"
        >
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <polyline points="15 18 9 12 15 6" />
          </svg>
        </button>

        <div class="scrolly-progress" aria-hidden="true">
          <span class="scrolly-progress__current">01</span>
          <span class="scrolly-progress__divider" />
          <span class="scrolly-progress__total">03</span>
        </div>

        <div class="scrolly-nav-dots" />

        <button
          type="button"
          class="scrolly-nav-btn scrolly-nav-btn--next"
          aria-label="Next step"
        >
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <polyline points="9 18 15 12 9 6" />
          </svg>
        </button>
      </nav>
    )
  }
</div>

<style>
  .sticky-scrolly-container {
    --immersive-canvas-height: clamp(340px, 52svh, 500px);
    --scrolly-sticky-offset: calc(var(--nav-h) + 16px);
    position: relative;
    width: 100%;
    margin-left: auto;
    margin-right: auto;
  }

  .sticky-scrolly-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
  }

  .scrolly-narrative-col {
    position: relative;
    z-index: 2;
    display: flex;
    min-width: 0;
    flex-direction: column;
  }

  .scrolly-visual-col {
    position: relative;
    width: 100%;
    min-width: 0;
    min-height: 350px;
  }

  .sticky-visual-stage {
    position: sticky;
    top: calc(var(--nav-h) + 48px);
    width: 100%;
  }

  .sticky-visual-wrapper {
    display: flex;
    width: 100%;
    min-width: 0;
    align-items: center;
    justify-content: center;
  }

  .scrolly-mobile-nav {
    display: none;
    min-height: 3.25rem;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 0.75rem;
    padding: 0.3rem 0.45rem;
    border: 1px solid hsl(var(--border));
    border-radius: 999px;
    background: hsl(var(--card) / 0.88);
    backdrop-filter: blur(18px) saturate(1.2);
    -webkit-backdrop-filter: blur(18px) saturate(1.2);
  }

  .scrolly-nav-btn {
    display: inline-flex;
    width: 2.75rem;
    height: 2.75rem;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    border: 1px solid hsl(var(--border));
    border-radius: 999px;
    background: hsl(var(--foreground) / 0.025);
    color: hsl(var(--muted-foreground));
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition:
      color 180ms ease,
      background 180ms ease,
      border-color 180ms ease,
      opacity 180ms ease;
  }

  .scrolly-nav-btn:hover,
  .scrolly-nav-btn:focus-visible {
    border-color: hsl(var(--primary) / 0.35);
    background: hsl(var(--primary) / 0.08);
    color: hsl(var(--foreground));
    outline: none;
  }

  .scrolly-nav-btn:active {
    background: hsl(var(--primary) / 0.14);
  }

  /* aria-disabled keeps focus on the button when it reaches either end. */
  .scrolly-nav-btn[aria-disabled="true"] {
    cursor: default;
    opacity: 0.3;
  }

  .scrolly-nav-btn[aria-disabled="true"]:hover {
    border-color: hsl(var(--border));
    background: hsl(var(--foreground) / 0.025);
    color: hsl(var(--muted-foreground));
  }

  .scrolly-nav-dots {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .scrolly-progress {
    display: none;
    align-items: center;
    gap: 0.55rem;
    color: hsl(var(--muted-foreground));
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0;
  }

  .scrolly-progress__current {
    color: hsl(var(--foreground));
  }

  .scrolly-progress__divider {
    width: clamp(2rem, 8vw, 4rem);
    height: 1px;
    background: hsl(var(--border));
  }

  :global(.scrolly-dot) {
    position: relative;
    display: inline-flex;
    width: 2.75rem;
    height: 2.75rem;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: 999px;
    background: transparent;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }

  :global(.scrolly-dot)::after {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: hsl(var(--muted-foreground) / 0.38);
    content: "";
    transition:
      width 200ms ease,
      background 200ms ease,
      box-shadow 200ms ease;
  }

  :global(.scrolly-dot:hover)::after,
  :global(.scrolly-dot:focus-visible)::after {
    background: hsl(var(--foreground) / 0.72);
  }

  :global(.scrolly-dot:focus-visible) {
    outline: 2px solid hsl(var(--primary) / 0.65);
    outline-offset: -4px;
  }

  :global(.scrolly-dot[data-active="true"])::after {
    width: 1.55rem;
    border-radius: 999px;
    background: hsl(var(--foreground));
  }

  /* Fixed bottom dock: only rendered in immersive mode, only shown < 1024px. */
  .scrolly-dock {
    position: fixed;
    bottom: calc(env(safe-area-inset-bottom, 0px) + 12px);
    left: 50%;
    z-index: 60;
    width: min(calc(100% - 2rem), 24rem);
    gap: 0.4rem;
    margin: 0;
    padding: 0.3rem;
    background: hsl(var(--card) / 0.9);
    box-shadow:
      0 10px 32px hsl(var(--foreground) / 0.14),
      0 1px 3px hsl(var(--foreground) / 0.08);
    opacity: 0;
    translate: -50% 1rem;
    visibility: hidden;
    transition:
      opacity 220ms ease,
      translate 260ms cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0s linear 260ms;
  }

  .sticky-scrolly-container[data-dock="visible"] .scrolly-dock {
    opacity: 1;
    translate: -50% 0;
    visibility: visible;
    transition:
      opacity 220ms ease,
      translate 260ms cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0s linear 0s;
  }

  .scrolly-dock .scrolly-nav-dots {
    min-width: 0;
    flex: 1 1 auto;
  }

  .scrolly-dock :global(.scrolly-dot) {
    min-width: 1.75rem;
    flex: 0 1 2.75rem;
  }

  .scrolly-dock .scrolly-progress {
    display: flex;
    gap: 0.3rem;
    padding-left: 0.35rem;
  }

  .scrolly-dock .scrolly-progress__divider {
    width: 0.7rem;
  }

  @media (min-width: 1280px) {
    .sticky-scrolly-container[data-scrolly-mode="pager"] {
      max-width: 1360px;
    }

    .sticky-scrolly-container[data-scrolly-mode="pager"] .sticky-scrolly-grid {
      grid-template-columns: 350px minmax(0, 1fr);
      gap: 4rem;
    }
  }

  @media (max-width: 1279px) {
    .sticky-scrolly-container[data-scrolly-mode="pager"]
      .scrolly-narrative-col {
      padding-top: 1rem;
    }

    .sticky-scrolly-container[data-scrolly-mode="pager"] .scrolly-visual-col {
      order: -1;
      min-height: auto;
    }

    .sticky-scrolly-container[data-scrolly-mode="pager"] .sticky-visual-stage {
      position: relative;
      top: 0;
    }

    .sticky-scrolly-container[data-scrolly-mode="pager"] .scrolly-mobile-nav {
      display: flex;
    }
  }

  .sticky-scrolly-container[data-scrolly-mode="immersive"] {
    max-width: 1380px;
  }

  .sticky-scrolly-container[data-scrolly-mode="immersive"]
    .scrolly-mobile-nav[data-scrolly-nav="stage"] {
    display: flex;
  }

  .sticky-scrolly-container[data-scrolly-mode="immersive"]
    .scrolly-mobile-nav[data-scrolly-nav="stage"]
    .scrolly-progress {
    display: flex;
  }

  .sticky-scrolly-container[data-scrolly-mode="immersive"]
    .scrolly-mobile-nav[data-scrolly-nav="stage"]
    .scrolly-nav-btn {
    display: none;
  }

  @media (min-width: 1024px) {
    .sticky-scrolly-container {
      --scrolly-sticky-offset: 104px;
    }

    .sticky-scrolly-container[data-scrolly-mode="immersive"] {
      --immersive-canvas-height: min(560px, calc(100svh - 136px));
    }

    .sticky-scrolly-container[data-scrolly-mode="immersive"]
      .sticky-scrolly-grid {
      grid-template-columns: minmax(300px, 350px) minmax(0, 1fr);
      gap: clamp(2.5rem, 4vw, 4.75rem);
    }

    .sticky-scrolly-container[data-scrolly-mode="immersive"]
      .sticky-visual-stage {
      top: var(--scrolly-sticky-offset);
    }
  }

  @media (max-width: 1023px) {
    /* Cards scroll over a pinned graphic that never fades. The gap between
       cards lets each chart state be seen unobstructed before the next card
       arrives; the end space keeps the final state on screen after the last
       card has passed. */
    .sticky-scrolly-container[data-scrolly-mode="immersive"] {
      --immersive-canvas-height: min(
        clamp(340px, 52svh, 500px),
        max(240px, calc(100svh - 9rem))
      );
      --scrolly-step-gap: 82svh;
      --scrolly-end-space: calc(var(--immersive-canvas-height) + 16svh);
    }

    .sticky-scrolly-container[data-scrolly-mode="immersive"]
      .sticky-scrolly-grid {
      grid-template-areas: "story";
      gap: 0;
    }

    .sticky-scrolly-container[data-scrolly-mode="immersive"]
      .scrolly-narrative-col,
    .sticky-scrolly-container[data-scrolly-mode="immersive"]
      .scrolly-visual-col {
      grid-area: story;
    }

    .sticky-scrolly-container[data-scrolly-mode="immersive"]
      .scrolly-visual-col {
      z-index: 1;
      min-height: 100%;
      pointer-events: none;
    }

    .sticky-scrolly-container[data-scrolly-mode="immersive"]
      .sticky-visual-stage {
      top: var(--scrolly-sticky-offset);
      pointer-events: auto;
    }

    .sticky-scrolly-container[data-scrolly-mode="immersive"]
      .scrolly-narrative-col {
      z-index: 2;
      padding-top: calc(var(--immersive-canvas-height) + 1.5rem);
      pointer-events: none;
    }

    .sticky-scrolly-container[data-scrolly-mode="immersive"]
      .scrolly-mobile-nav[data-scrolly-nav="stage"] {
      display: none;
    }

    .sticky-scrolly-container[data-scrolly-mode="immersive"] .scrolly-dock {
      display: flex;
    }
  }

  @media (max-width: 420px) {
    .sticky-scrolly-container {
      --scrolly-sticky-offset: 74px;
    }
  }

  @media (max-width: 359px) {
    .scrolly-dock .scrolly-progress {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scrolly-nav-btn,
    :global(.scrolly-dot)::after,
    .scrolly-dock,
    .sticky-scrolly-container[data-dock="visible"] .scrolly-dock {
      transition: none;
    }
  }
</style>

<script is:inline>
  document.querySelectorAll("[data-scrolly-root]").forEach((container) => {
    if (
      !(container instanceof HTMLElement) ||
      container.dataset.bound === "true"
    ) {
      return;
    }

    container.dataset.bound = "true";

    const steps = Array.from(container.querySelectorAll("[data-scrolly-step]"));
    if (steps.length === 0) return;

    const mode = container.dataset.scrollyMode ?? "pager";
    const isImmersive = mode === "immersive";
    const isPagerMobileQuery = window.matchMedia("(max-width: 1279px)");
    const immersiveMobileQuery = window.matchMedia("(max-width: 1023px)");
    const reducedMotionQuery = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    );
    let isPagerMobile = isPagerMobileQuery.matches;
    let activeIndex = 0;
    let activeStepId = null;
    let scrollFrame = 0;
    let lockedIndex = null;
    let lockTargetTop = 0;
    let settleTimer = 0;
    let lockTimer = 0;
    let isDockVisible = null;
    let stickyTop = 0;

    const navs = Array.from(container.querySelectorAll("[data-scrolly-nav]"));
    const prevButtons = container.querySelectorAll(".scrolly-nav-btn--prev");
    const nextButtons = container.querySelectorAll(".scrolly-nav-btn--next");
    const currentLabels = container.querySelectorAll(
      ".scrolly-progress__current",
    );
    const visualStage = container.querySelector(".sticky-visual-stage");
    const dock = container.querySelector(".scrolly-dock");

    container
      .querySelectorAll(".scrolly-progress__total")
      .forEach((label) => {
        label.textContent = String(steps.length).padStart(2, "0");
      });

    const dots = [];
    navs.forEach((nav) => {
      const dotsContainer = nav.querySelector(".scrolly-nav-dots");
      if (!dotsContainer) return;
      dotsContainer.innerHTML = "";
      steps.forEach((step, index) => {
        const dot = document.createElement("button");
        dot.type = "button";
        dot.className = "scrolly-dot";
        dot.setAttribute(
          "aria-label",
          `Go to chapter ${index + 1}: ${
            step.querySelector("h3")?.textContent?.trim() ?? ""
          }`,
        );
        dot.dataset.index = String(index);
        dotsContainer.appendChild(dot);
        dots.push(dot);
      });
    });

    function isImmersiveMobile() {
      return isImmersive && immersiveMobileQuery.matches;
    }

    function getCard(step) {
      return step.querySelector(".scrolly-step-card") ?? step;
    }

    function measure() {
      stickyTop =
        visualStage instanceof HTMLElement
          ? Number.parseFloat(getComputedStyle(visualStage).top) || 0
          : 0;
    }

    // A step activates when its card (mobile) or block (desktop) crosses
    // this line. Taking the last step above the line makes the result a pure
    // function of scroll position, so it cannot flicker between steps.
    function getActivationLine() {
      return window.innerHeight * (isImmersiveMobile() ? 0.8 : 0.48);
    }

    function getScrollIndex() {
      const line = getActivationLine();
      const mobile = isImmersiveMobile();
      let index = 0;
      steps.forEach((step, stepIndex) => {
        const anchor = mobile ? getCard(step) : step;
        if (anchor.getBoundingClientRect().top <= line) index = stepIndex;
      });
      return index;
    }

    function setStep(index, options = {}) {
      if (index < 0 || index >= steps.length) return;
      const { force = false } = options;
      const step = steps[index];
      const stepId = step.getAttribute("data-scrolly-step");
      activeIndex = index;

      steps.forEach((candidate, candidateIndex) => {
        const isActive = candidateIndex === index;
        candidate.setAttribute("data-active", String(isActive));
        if (isActive) {
          candidate.setAttribute("aria-current", "step");
        } else {
          candidate.removeAttribute("aria-current");
        }
      });

      dots.forEach((dot) => {
        const isActive = Number(dot.dataset.index) === index;
        dot.setAttribute("data-active", String(isActive));
        dot.setAttribute("aria-current", isActive ? "step" : "false");
      });

      prevButtons.forEach((button) => {
        button.setAttribute("aria-disabled", String(index === 0));
      });
      nextButtons.forEach((button) => {
        button.setAttribute(
          "aria-disabled",
          String(index === steps.length - 1),
        );
      });
      currentLabels.forEach((label) => {
        label.textContent = String(index + 1).padStart(2, "0");
      });

      if (force || activeStepId !== stepId) {
        activeStepId = stepId;
        container.dataset.activeStepId = stepId;
        window.dispatchEvent(
          new CustomEvent("scrolly:stepchange", {
            detail: { stepId },
          }),
        );
      }
    }

    function getTargetScrollTop(index) {
      const step = steps[index];
      const viewportHeight = window.innerHeight;
      let anchorTop;
      let desiredTop;

      if (isImmersiveMobile()) {
        // Land with the whole graphic visible and the card's heading
        // directly beneath it, while staying past the activation line.
        anchorTop = getCard(step).getBoundingClientRect().top;
        const stageHeight =
          visualStage instanceof HTMLElement ? visualStage.offsetHeight : 0;
        desiredTop = Math.min(
          stickyTop + stageHeight + 16,
          getActivationLine() - 24,
        );
      } else {
        const rect = step.getBoundingClientRect();
        anchorTop = rect.top;
        desiredTop = Math.min(
          (viewportHeight - rect.height) / 2,
          getActivationLine() - 24,
        );
      }

      const maxScroll =
        document.documentElement.scrollHeight - viewportHeight;
      return Math.max(
        0,
        Math.min(maxScroll, window.scrollY + anchorTop - desiredTop),
      );
    }

    function releaseLock() {
      window.clearTimeout(settleTimer);
      window.clearTimeout(lockTimer);
      if (lockedIndex === null) return;
      lockedIndex = null;
      scheduleUpdate();
    }

    function armSettle(delay) {
      window.clearTimeout(settleTimer);
      settleTimer = window.setTimeout(releaseLock, delay);
    }

    // Runs on scroll and scrollend. A superseded smooth scroll (rapid taps)
    // can end short of the current target, so only reaching the target or
    // the settle timer releases the lock.
    function handleLockedScroll() {
      if (lockedIndex === null) return;
      if (Math.abs(window.scrollY - lockTargetTop) <= 2) {
        releaseLock();
      } else {
        armSettle(240);
      }
    }

    // Programmatic navigation: switch the visual immediately, then hold that
    // step while the page scrolls so intermediate steps never flash past.
    function goToStep(index) {
      const target = Math.max(0, Math.min(steps.length - 1, index));
      setStep(target);
      if (!isImmersive) return;

      const top = getTargetScrollTop(target);
      if (Math.abs(top - window.scrollY) < 2) {
        releaseLock();
        return;
      }

      lockedIndex = target;
      lockTargetTop = top;
      window.scrollTo({
        top,
        behavior: reducedMotionQuery.matches ? "instant" : "smooth",
      });
      // Released when the target is reached, scrolling settles, the reader
      // takes over, or as a last resort after the safety timeout.
      armSettle(600);
      window.clearTimeout(lockTimer);
      lockTimer = window.setTimeout(releaseLock, 2400);
    }

    function setDockVisible(visible) {
      if (!(dock instanceof HTMLElement) || visible === isDockVisible) return;
      isDockVisible = visible;
      container.dataset.dock = visible ? "visible" : "hidden";
      dock.inert = !visible;
      if (visible) {
        dock.removeAttribute("aria-hidden");
      } else {
        dock.setAttribute("aria-hidden", "true");
      }
    }

    // Show the dock only while the graphic is pinned, so it never floats over
    // the surrounding article.
    function updateDock() {
      if (!(dock instanceof HTMLElement)) return;
      if (!isImmersiveMobile() || !(visualStage instanceof HTMLElement)) {
        setDockVisible(false);
        return;
      }

      const stageRect = visualStage.getBoundingClientRect();
      setDockVisible(
        stageRect.top <= stickyTop + stageRect.height * 0.35 &&
          stageRect.top >= stickyTop - stageRect.height * 0.2,
      );
    }

    function update() {
      scrollFrame = 0;
      if (!isImmersive) return;
      updateDock();
      if (lockedIndex === null) setStep(getScrollIndex());
    }

    function scheduleUpdate() {
      if (scrollFrame) return;
      scrollFrame = window.requestAnimationFrame(update);
    }

    const observer = new IntersectionObserver(
      (entries) => {
        if (isImmersive || isPagerMobile) return;

        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort(
            (left, right) =>
              Math.abs(left.boundingClientRect.top - window.innerHeight * 0.4) -
              Math.abs(right.boundingClientRect.top - window.innerHeight * 0.4),
          )[0];

        if (!visible) return;
        const index = steps.indexOf(visible.target);
        if (index !== -1) setStep(index);
      },
      {
        root: null,
        rootMargin: "-24% 0px -44% 0px",
        threshold: [0, 0.05, 0.2],
      },
    );

    function initLayout() {
      isPagerMobile = isPagerMobileQuery.matches;

      steps.forEach((step) => observer.unobserve(step));

      if (isImmersive) {
        measure();
        releaseLock();
        scheduleUpdate();
        return;
      }

      if (!isPagerMobile) {
        steps.forEach((step) => observer.observe(step));
      }
      setStep(activeIndex, { force: true });
    }

    function getBaseIndex() {
      return lockedIndex ?? activeIndex;
    }

    function isAtEdge(button) {
      return button.getAttribute("aria-disabled") === "true";
    }

    prevButtons.forEach((button) => {
      button.addEventListener("click", () => {
        if (!isAtEdge(button)) goToStep(getBaseIndex() - 1);
      });
    });
    nextButtons.forEach((button) => {
      button.addEventListener("click", () => {
        if (!isAtEdge(button)) goToStep(getBaseIndex() + 1);
      });
    });

    dots.forEach((dot) => {
      dot.addEventListener("click", () => goToStep(Number(dot.dataset.index)));
    });

    navs.forEach((nav) => {
      nav.addEventListener("keydown", (event) => {
        const base = getBaseIndex();
        const targets = {
          ArrowLeft: base - 1,
          ArrowRight: base + 1,
          Home: 0,
          End: steps.length - 1,
        };
        if (!(event.key in targets)) return;
        event.preventDefault();
        goToStep(targets[event.key]);

        if (
          document.activeElement instanceof HTMLElement &&
          document.activeElement.classList.contains("scrolly-dot")
        ) {
          nav
            .querySelector(`.scrolly-dot[data-index="${activeIndex}"]`)
            ?.focus({ preventScroll: true });
        }
      });
    });

    const scrollKeys = new Set([
      " ",
      "ArrowDown",
      "ArrowUp",
      "End",
      "Home",
      "PageDown",
      "PageUp",
    ]);

    // Any direct scroll gesture outside the controls hands control back to
    // the scroll position immediately.
    function handleUserScrollIntent(event) {
      if (lockedIndex === null) return;
      if (event.type === "keydown" && !scrollKeys.has(event.key)) return;
      const target = event.target;
      if (target instanceof Element && target.closest("[data-scrolly-nav]")) {
        return;
      }
      releaseLock();
    }

    isPagerMobileQuery.addEventListener("change", initLayout);

    if (isImmersive) {
      immersiveMobileQuery.addEventListener("change", initLayout);
      window.addEventListener(
        "scroll",
        () => {
          handleLockedScroll();
          scheduleUpdate();
        },
        { passive: true },
      );
      window.addEventListener("scrollend", handleLockedScroll);
      window.addEventListener("resize", () => {
        measure();
        scheduleUpdate();
      });
      window.addEventListener("wheel", handleUserScrollIntent, {
        passive: true,
      });
      window.addEventListener("touchstart", handleUserScrollIntent, {
        passive: true,
      });
      window.addEventListener("keydown", handleUserScrollIntent);
    }

    setDockVisible(false);
    setStep(0, { force: true });
    initLayout();
  });
</script>
