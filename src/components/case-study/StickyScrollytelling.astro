---
interface Props {
  mode?: "pager" | "immersive";
}

const { mode = "pager" } = Astro.props;
---

<div
  class="sticky-scrolly-container my-12 md:my-20"
  data-scrolly-root
  data-story-root
  data-scrolly-mode={mode}
>
  <div class="sticky-scrolly-grid">
    <div class="scrolly-narrative-col">
      <slot />
    </div>

    <div class="scrolly-visual-col">
      <div class="sticky-visual-stage">
        <div class="sticky-visual-wrapper">
          <slot name="visual" />
        </div>

        <nav class="scrolly-mobile-nav" aria-label="Story chapters">
          <button
            type="button"
            class="scrolly-nav-btn scrolly-nav-btn--prev"
            aria-label="Previous step"
          >
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
          </button>

          <div class="scrolly-progress" aria-live="polite">
            <span class="scrolly-progress__current">01</span>
            <span class="scrolly-progress__divider" aria-hidden="true"></span>
            <span class="scrolly-progress__total">03</span>
          </div>

          <div class="scrolly-nav-dots"></div>

          <button
            type="button"
            class="scrolly-nav-btn scrolly-nav-btn--next"
            aria-label="Next step"
          >
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </button>
        </nav>
      </div>
    </div>
  </div>
</div>

<style>
  .sticky-scrolly-container {
    --immersive-canvas-height: clamp(340px, 52svh, 500px);
    --scrolly-sticky-offset: 82px;
    position: relative;
    width: 100%;
    margin-left: auto;
    margin-right: auto;
  }

  .sticky-scrolly-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
  }

  .scrolly-narrative-col {
    position: relative;
    z-index: 2;
    display: flex;
    min-width: 0;
    flex-direction: column;
  }

  .scrolly-visual-col {
    position: relative;
    width: 100%;
    min-width: 0;
    min-height: 350px;
  }

  .sticky-visual-stage {
    position: sticky;
    top: 140px;
    width: 100%;
  }

  .sticky-visual-wrapper {
    display: flex;
    width: 100%;
    min-width: 0;
    align-items: center;
    justify-content: center;
  }

  .scrolly-mobile-nav {
    display: none;
    min-height: 3.25rem;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 0.75rem;
    padding: 0.3rem 0.45rem;
    border: 1px solid hsl(var(--border));
    border-radius: 999px;
    background: hsl(var(--card) / 0.88);
    box-shadow: 0 16px 44px rgba(0, 0, 0, 0.18);
    backdrop-filter: blur(18px) saturate(1.2);
    -webkit-backdrop-filter: blur(18px) saturate(1.2);
  }

  .scrolly-nav-btn {
    display: inline-flex;
    width: 2.75rem;
    height: 2.75rem;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    border: 1px solid hsl(var(--border));
    border-radius: 999px;
    background: hsl(var(--foreground) / 0.025);
    color: hsl(var(--muted-foreground));
    transition:
      color 180ms ease,
      background 180ms ease,
      border-color 180ms ease;
  }

  .scrolly-nav-btn:hover,
  .scrolly-nav-btn:focus-visible {
    border-color: hsl(var(--primary) / 0.35);
    background: hsl(var(--primary) / 0.08);
    color: hsl(var(--foreground));
    outline: none;
  }

  .scrolly-nav-btn:disabled {
    pointer-events: none;
    opacity: 0.3;
  }

  .scrolly-nav-dots {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .scrolly-progress {
    display: none;
    align-items: center;
    gap: 0.55rem;
    color: hsl(var(--muted-foreground));
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .scrolly-progress__current {
    color: hsl(var(--foreground));
  }

  .scrolly-progress__divider {
    width: clamp(2rem, 8vw, 4rem);
    height: 1px;
    background: linear-gradient(
      90deg,
      hsl(var(--primary) / 0.78),
      hsl(var(--border))
    );
  }

  :global(.scrolly-dot) {
    position: relative;
    display: inline-flex;
    width: 2.75rem;
    height: 2.75rem;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: 999px;
    background: transparent;
    cursor: pointer;
  }

  :global(.scrolly-dot)::after {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: hsl(var(--muted-foreground) / 0.38);
    content: "";
    transition:
      width 200ms ease,
      background 200ms ease,
      box-shadow 200ms ease;
  }

  :global(.scrolly-dot:hover)::after,
  :global(.scrolly-dot:focus-visible)::after {
    background: hsl(var(--foreground) / 0.72);
  }

  :global(.scrolly-dot:focus-visible) {
    outline: 2px solid hsl(var(--primary) / 0.65);
    outline-offset: -4px;
  }

  :global(.scrolly-dot[data-active="true"])::after {
    width: 1.55rem;
    border-radius: 999px;
    background: hsl(var(--primary));
    box-shadow: 0 0 14px hsl(var(--primary) / 0.34);
  }

  @media (min-width: 1280px) {
    .sticky-scrolly-container[data-scrolly-mode="pager"] {
      max-width: 1360px;
    }

    .sticky-scrolly-container[data-scrolly-mode="pager"] .sticky-scrolly-grid {
      grid-template-columns: 350px minmax(0, 1fr);
      gap: 4rem;
    }
  }

  @media (max-width: 1279px) {
    .sticky-scrolly-container[data-scrolly-mode="pager"]
      .scrolly-narrative-col {
      padding-top: 1rem;
    }

    .sticky-scrolly-container[data-scrolly-mode="pager"] .scrolly-visual-col {
      order: -1;
      min-height: auto;
    }

    .sticky-scrolly-container[data-scrolly-mode="pager"] .sticky-visual-stage {
      position: relative;
      top: 0;
    }

    .sticky-scrolly-container[data-scrolly-mode="pager"] .scrolly-mobile-nav {
      display: flex;
    }
  }

  .sticky-scrolly-container[data-scrolly-mode="immersive"] {
    max-width: 1380px;
  }

  .sticky-scrolly-container[data-scrolly-mode="immersive"] .scrolly-mobile-nav {
    display: flex;
  }

  .sticky-scrolly-container[data-scrolly-mode="immersive"] .scrolly-progress {
    display: flex;
  }

  .sticky-scrolly-container[data-scrolly-mode="immersive"] .scrolly-nav-btn {
    display: none;
  }

  .sticky-scrolly-container[data-scrolly-mode="immersive"]
    .sticky-visual-stage {
    transition: opacity 180ms ease;
  }

  @media (min-width: 1024px) {
    .sticky-scrolly-container {
      --scrolly-sticky-offset: 104px;
    }

    .sticky-scrolly-container[data-scrolly-mode="immersive"] {
      --immersive-canvas-height: min(560px, calc(100svh - 136px));
    }

    .sticky-scrolly-container[data-scrolly-mode="immersive"]
      .sticky-scrolly-grid {
      grid-template-columns: minmax(300px, 350px) minmax(0, 1fr);
      gap: clamp(2.5rem, 4vw, 4.75rem);
    }

    .sticky-scrolly-container[data-scrolly-mode="immersive"]
      .sticky-visual-stage {
      top: var(--scrolly-sticky-offset);
    }
  }

  @media (max-width: 1023px) {
    .sticky-scrolly-container[data-scrolly-mode="immersive"]
      .sticky-scrolly-grid {
      grid-template-areas: "story";
      gap: 0;
    }

    .sticky-scrolly-container[data-scrolly-mode="immersive"]
      .scrolly-narrative-col,
    .sticky-scrolly-container[data-scrolly-mode="immersive"]
      .scrolly-visual-col {
      grid-area: story;
    }

    .sticky-scrolly-container[data-scrolly-mode="immersive"]
      .scrolly-visual-col {
      z-index: 8;
      min-height: 100%;
      pointer-events: none;
    }

    .sticky-scrolly-container[data-scrolly-mode="immersive"]
      .sticky-visual-stage {
      top: var(--scrolly-sticky-offset);
      pointer-events: auto;
    }

    .sticky-scrolly-container[data-scrolly-mode="immersive"]
      .scrolly-narrative-col {
      z-index: 2;
      padding-top: calc(var(--immersive-canvas-height) + 9rem);
    }

    .sticky-scrolly-container[data-scrolly-mode="immersive"]
      .scrolly-mobile-nav {
      margin-inline: 0.25rem;
    }

    .sticky-scrolly-container[data-scrolly-mode="immersive"][data-mobile-reading="true"]
      .sticky-visual-stage {
      opacity: 0;
      pointer-events: none;
    }
  }

  @media (max-width: 420px) {
    .sticky-scrolly-container {
      --scrolly-sticky-offset: 74px;
    }

    .sticky-scrolly-container[data-scrolly-mode="immersive"]
      .scrolly-mobile-nav {
      min-height: 3rem;
      margin-top: 0.55rem;
    }

    .sticky-scrolly-container[data-scrolly-mode="immersive"]
      .scrolly-narrative-col {
      padding-top: calc(var(--immersive-canvas-height) + 7.5rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scrolly-nav-btn,
    :global(.scrolly-dot)::after,
    .sticky-scrolly-container[data-scrolly-mode="immersive"]
      .sticky-visual-stage {
      transition: none;
    }
  }
</style>

<script is:inline>
  document.querySelectorAll("[data-scrolly-root]").forEach((container) => {
    if (
      !(container instanceof HTMLElement) ||
      container.dataset.bound === "true"
    ) {
      return;
    }

    container.dataset.bound = "true";

    const steps = Array.from(container.querySelectorAll("[data-scrolly-step]"));
    if (steps.length === 0) return;

    const mode = container.dataset.scrollyMode ?? "pager";
    const isPagerMobileQuery = window.matchMedia("(max-width: 1279px)");
    let isPagerMobile = isPagerMobileQuery.matches;
    let activeIndex = 0;
    let activeStepId = null;
    let isMobileReading = false;
    let scrollFrame = 0;

    const prevBtn = container.querySelector(".scrolly-nav-btn--prev");
    const nextBtn = container.querySelector(".scrolly-nav-btn--next");
    const dotsContainer = container.querySelector(".scrolly-nav-dots");
    const currentLabel = container.querySelector(".scrolly-progress__current");
    const totalLabel = container.querySelector(".scrolly-progress__total");
    const visualStage = container.querySelector(".sticky-visual-stage");

    if (totalLabel) {
      totalLabel.textContent = String(steps.length).padStart(2, "0");
    }

    if (dotsContainer) {
      dotsContainer.innerHTML = "";
      steps.forEach((step, index) => {
        const dot = document.createElement("button");
        dot.type = "button";
        dot.className = "scrolly-dot";
        dot.setAttribute(
          "aria-label",
          `Go to chapter ${index + 1}: ${
            step.querySelector("h3")?.textContent?.trim() ?? ""
          }`,
        );
        dot.dataset.index = String(index);
        dotsContainer.appendChild(dot);
      });
    }

    const dots = dotsContainer
      ? Array.from(dotsContainer.querySelectorAll(".scrolly-dot"))
      : [];

    function setStep(index, options = {}) {
      if (index < 0 || index >= steps.length) return;
      const { scroll = false, force = false } = options;
      const step = steps[index];
      const stepId = step.getAttribute("data-scrolly-step");
      activeIndex = index;

      steps.forEach((candidate, candidateIndex) => {
        const isActive = candidateIndex === index;
        candidate.setAttribute("data-active", String(isActive));
        if (isActive) {
          candidate.setAttribute("aria-current", "step");
        } else {
          candidate.removeAttribute("aria-current");
        }
      });

      dots.forEach((dot, dotIndex) => {
        const isActive = dotIndex === index;
        dot.setAttribute("data-active", String(isActive));
        dot.setAttribute("aria-current", isActive ? "step" : "false");
      });

      if (prevBtn instanceof HTMLButtonElement) {
        prevBtn.disabled = index === 0;
      }
      if (nextBtn instanceof HTMLButtonElement) {
        nextBtn.disabled = index === steps.length - 1;
      }
      if (currentLabel) {
        currentLabel.textContent = String(index + 1).padStart(2, "0");
      }

      if (scroll) {
        step.scrollIntoView({
          behavior: window.matchMedia("(prefers-reduced-motion: reduce)")
            .matches
            ? "auto"
            : "smooth",
          block: mode === "immersive" ? "center" : "nearest",
        });
      }

      if (force || activeStepId !== stepId) {
        activeStepId = stepId;
        container.dataset.activeStepId = stepId;
        window.dispatchEvent(
          new CustomEvent("scrolly:stepchange", {
            detail: { stepId },
          }),
        );
      }
    }

    const observer = new IntersectionObserver(
      (entries) => {
        if (mode === "immersive" || isPagerMobile) return;

        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort(
            (left, right) =>
              Math.abs(left.boundingClientRect.top - window.innerHeight * 0.4) -
              Math.abs(right.boundingClientRect.top - window.innerHeight * 0.4),
          )[0];

        if (!visible) return;
        const index = steps.indexOf(visible.target);
        if (index !== -1) setStep(index);
      },
      {
        root: null,
        rootMargin: "-24% 0px -44% 0px",
        threshold: [0, 0.05, 0.2],
      },
    );

    function updateImmersiveStep() {
      scrollFrame = 0;
      if (mode !== "immersive") return;

      const activationLine =
        window.innerWidth < 1024
          ? window.innerHeight * 0.78
          : window.innerHeight * 0.48;

      let nextIndex = activeIndex;
      let closestDistance = Number.POSITIVE_INFINITY;

      steps.forEach((step, index) => {
        const rect = step.getBoundingClientRect();
        const distance =
          activationLine < rect.top
            ? rect.top - activationLine
            : activationLine > rect.bottom
              ? activationLine - rect.bottom
              : 0;

        if (distance < closestDistance) {
          closestDistance = distance;
          nextIndex = index;
        }
      });

      setStep(nextIndex);
      updateMobileReadingState();
    }

    function updateMobileReadingState() {
      if (
        mode !== "immersive" ||
        window.innerWidth >= 1024 ||
        !(visualStage instanceof HTMLElement)
      ) {
        isMobileReading = false;
        container.removeAttribute("data-mobile-reading");
        if (visualStage instanceof HTMLElement) {
          visualStage.inert = false;
          visualStage.removeAttribute("aria-hidden");
        }
        return;
      }

      const activeStep = steps[activeIndex];
      const activeCard = activeStep?.querySelector(".scrolly-step-card");
      const mobileNav = visualStage.querySelector(".scrolly-mobile-nav");
      if (
        !(activeCard instanceof HTMLElement) ||
        !(mobileNav instanceof HTMLElement)
      ) {
        return;
      }

      const cardRect = activeCard.getBoundingClientRect();
      const navRect = mobileNav.getBoundingClientRect();
      const enterReadingAt = navRect.bottom - 12;
      const leaveReadingAt = navRect.bottom + 28;
      const cardStillOnScreen = cardRect.bottom > 90;
      const shouldRead = isMobileReading
        ? cardRect.top < leaveReadingAt && cardStillOnScreen
        : cardRect.top < enterReadingAt && cardStillOnScreen;

      if (shouldRead === isMobileReading) return;
      isMobileReading = shouldRead;
      container.dataset.mobileReading = String(shouldRead);
      visualStage.inert = shouldRead;
      visualStage.setAttribute("aria-hidden", String(shouldRead));
    }

    function scheduleImmersiveUpdate() {
      if (scrollFrame) return;
      scrollFrame = window.requestAnimationFrame(updateImmersiveStep);
    }

    function initLayout() {
      isPagerMobile = isPagerMobileQuery.matches;

      steps.forEach((step) => observer.unobserve(step));

      if (mode === "immersive") {
        updateMobileReadingState();
        scheduleImmersiveUpdate();
        return;
      }

      if (isPagerMobile) {
        setStep(activeIndex, { force: true });
      } else {
        steps.forEach((step) => observer.observe(step));
        setStep(activeIndex, { force: true });
      }
    }

    if (prevBtn) {
      prevBtn.addEventListener("click", () =>
        setStep(activeIndex - 1, { scroll: mode === "immersive" }),
      );
    }
    if (nextBtn) {
      nextBtn.addEventListener("click", () =>
        setStep(activeIndex + 1, { scroll: mode === "immersive" }),
      );
    }

    dots.forEach((dot, index) => {
      dot.addEventListener("click", () =>
        setStep(index, { scroll: mode === "immersive" }),
      );
    });

    isPagerMobileQuery.addEventListener("change", initLayout);

    if (mode === "immersive") {
      window.addEventListener("scroll", scheduleImmersiveUpdate, {
        passive: true,
      });
      window.addEventListener("resize", scheduleImmersiveUpdate);
    }

    setStep(0, { force: true });
    initLayout();
  });
</script>
