---
import type { ImageMetadata } from "astro";

import Icon from "./Icon.astro";
import OptimizedImage from "./OptimizedImage.astro";
import TechBadge from "./ui/TechBadge.astro";

interface Props {
  title: string;
  description: string;
  href: string;
  eyebrow: string;
  meta?: string | undefined;
  tags?: string[] | undefined;
  image: string | ImageMetadata;
  imageFit?: "cover" | "contain" | undefined;
  ctaLabel: string;
  external?: boolean | undefined;
}

const {
  title,
  description,
  href,
  eyebrow,
  meta,
  tags = [],
  image,
  imageFit = "cover",
  ctaLabel,
  external = false,
} = Astro.props as Props;

const visibleTags = tags.slice(0, 2);
---

<article class="group h-full">
  <a
    href={href}
    target={external ? "_blank" : undefined}
    rel={external ? "noopener noreferrer" : undefined}
    class="flex h-full flex-col gap-4 rounded-xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/70 focus-visible:ring-offset-4 focus-visible:ring-offset-background"
  >
    <div
      class:list={[
        "overflow-hidden rounded-xl transition-all duration-500 group-hover:shadow-[0_12px_32px_rgba(0,0,0,0.25)]",
        imageFit === "contain"
          ? "aspect-square flex items-center justify-center bg-gradient-to-br from-white/[0.04] to-white/[0.01]"
          : "aspect-[1.36/1] bg-white/[0.02]",
      ]}
    >
      <OptimizedImage
        src={image}
        alt=""
        class:list={[
          "transition-transform duration-700 group-hover:scale-[1.03]",
          imageFit === "contain"
            ? "h-[60%] w-[60%] object-contain drop-shadow-[0_8px_24px_rgba(0,0,0,0.3)]"
            : "h-full w-full object-cover",
        ]}
        loading="lazy"
        width={800}
        height={imageFit === "contain" ? 800 : 500}
      />
    </div>

    <div class="flex flex-1 flex-col gap-3 pt-1">
      <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
        <p
          class="text-[0.72rem] font-semibold uppercase tracking-[0.14em]"
          style="color: var(--premium-accent);"
        >
          {eyebrow}
        </p>
        {
          meta && (
            <p class="text-[0.72rem] uppercase tracking-[0.12em] text-muted-foreground">
              {meta}
            </p>
          )
        }
      </div>

      <div class="space-y-2">
        <h3
          class="text-[clamp(1.45rem,2vw,1.85rem)] font-display font-bold leading-[1.08] text-foreground transition-colors group-hover:text-primary"
        >
          {title}
        </h3>
        <p class="text-[0.95rem] leading-7 text-muted-foreground">
          {description}
        </p>
      </div>

      {
        visibleTags.length > 0 && (
          <div class="flex flex-wrap gap-2">
            {visibleTags.map((tag) => (
              <TechBadge label={tag} />
            ))}
          </div>
        )
      }

      <span
        class="mt-auto inline-flex items-center gap-2 pt-1 text-[0.78rem] font-medium tracking-wider uppercase text-muted-foreground transition-all group-hover:gap-3 group-hover:text-primary"
      >
        {ctaLabel}
        <Icon
          name="arrow-right"
          size={16}
          class="transition-transform group-hover:translate-x-1"
        />
      </span>
    </div>
  </a>
</article>
