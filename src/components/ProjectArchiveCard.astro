---
import type { ImageMetadata } from "astro";

import Icon from "./Icon.astro";
import OptimizedImage from "./OptimizedImage.astro";
import TechBadge from "./ui/TechBadge.astro";

interface Props {
  title: string;
  description: string;
  href: string;
  eyebrow: string;
  meta?: string | undefined;
  role?: string | undefined;
  impact?: string | undefined;
  tags?: string[] | undefined;
  image: string | ImageMetadata;
  imageFit?: "cover" | "contain" | undefined;
  ctaLabel: string;
  external?: boolean | undefined;
}

const {
  title,
  description,
  href,
  eyebrow,
  meta,
  role,
  impact,
  tags = [],
  image,
  imageFit = "cover",
  ctaLabel,
  external = false,
} = Astro.props as Props;

const proofItems = [
  role ? { label: "Role", value: role } : undefined,
  impact ? { label: "Impact", value: impact } : undefined,
].filter((item): item is { label: string; value: string } => Boolean(item));

const visibleTags = tags.slice(0, 2);
---

<article class="group flex h-full flex-col gap-4">
  <a
    href={href}
    target={external ? "_blank" : undefined}
    rel={external ? "noopener noreferrer" : undefined}
    aria-label={ctaLabel ? `${ctaLabel}: ${title}` : `Open ${title}`}
    class="block aspect-[1.36/1] overflow-hidden rounded-xl bg-white/[0.02] transition-all duration-500 group-hover:shadow-[0_12px_32px_rgba(0,0,0,0.25)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/70 focus-visible:ring-offset-2 focus-visible:ring-offset-background"
  >
    <OptimizedImage
      src={image}
      alt={title}
      class:list={[
        "h-full w-full transition-transform duration-700 group-hover:scale-[1.03]",
        imageFit === "contain"
          ? "object-contain p-6 sm:p-8 scale-[1.1]"
          : "object-cover",
      ]}
      loading="lazy"
      width={800}
      height={500}
    />
  </a>

  <div class="flex flex-1 flex-col gap-3 pt-1">
    <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
      <p
        class="text-[0.72rem] font-semibold uppercase tracking-[0.14em]"
        style="color: var(--premium-accent);"
      >
        {eyebrow}
      </p>
      {
        meta && (
          <p class="text-[0.72rem] uppercase tracking-[0.12em] text-muted-foreground">
            {meta}
          </p>
        )
      }
    </div>

    <div class="space-y-2">
      <h3
        class="text-[clamp(1.45rem,2vw,1.85rem)] font-display font-bold leading-[1.08] text-foreground transition-colors group-hover:text-primary"
      >
        <a
          href={href}
          target={external ? "_blank" : undefined}
          rel={external ? "noopener noreferrer" : undefined}
          class="focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/70 focus-visible:ring-offset-2 focus-visible:ring-offset-background"
        >
          {title}
        </a>
      </h3>

      <p class="text-[0.95rem] leading-7 text-muted-foreground">
        {description}
      </p>
    </div>

    {
      proofItems.length > 0 && (
        <div class="flex flex-wrap gap-x-4 gap-y-1">
          {proofItems.map((item) => (
            <p class="text-[0.82rem] text-muted-foreground">
              <span class="font-medium text-foreground/80">{item.label}:</span>{" "}
              {item.value}
            </p>
          ))}
        </div>
      )
    }

    {
      visibleTags.length > 0 && (
        <div class="flex flex-wrap gap-2">
          {visibleTags.map((tag) => (
            <TechBadge label={tag} />
          ))}
        </div>
      )
    }

    <div class="mt-auto pt-1">
      <a
        href={href}
        target={external ? "_blank" : undefined}
        rel={external ? "noopener noreferrer" : undefined}
        class="inline-flex items-center gap-2 text-[0.78rem] font-medium tracking-wider uppercase text-muted-foreground transition-all hover:gap-3 hover:text-primary"
      >
        {ctaLabel}
        <Icon
          name="arrow-right"
          size={16}
          class="transition-transform group-hover:translate-x-1"
        />
      </a>
    </div>
  </div>
</article>
