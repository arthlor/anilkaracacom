---
import Icon from '../Icon.astro';
import { pillarConfig, type PillarKey } from '../../lib/site';

interface Props {
  pillar: PillarKey;
}

const { pillar } = Astro.props;
const config = pillarConfig[pillar];
---

<span class="inline-flex min-h-[32px] items-center gap-2 rounded-full bg-white/[0.05] px-3 py-1.5 text-[0.72rem] font-semibold tracking-[0.12em] text-foreground">
  <Icon name={config.icon} size={14} class={config.accentClass} />
  {config.shortTitle}
</span>
