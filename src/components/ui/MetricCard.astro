---
interface Props {
  label: string;
  value: string;
  detail?: string | undefined;
}

const { label, value, detail } = Astro.props;
---

<div class="rounded-[1.6rem] border border-white/8 bg-white/[0.03] p-5 backdrop-blur-sm">
  <p class="text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-primary">{label}</p>
  <p class="mt-3 text-[clamp(1.8rem,2.4vw,2.5rem)] font-display font-bold leading-none text-foreground">{value}</p>
  {detail && <p class="mt-3 text-sm leading-relaxed text-muted-foreground">{detail}</p>}
</div>
