---
interface Props {
  label: string;
  value: string;
  detail?: string | undefined;
}

const { label, value, detail } = Astro.props;
---

<div class="rounded-xl bg-white/[0.03] p-5 backdrop-blur-sm border border-white/[0.04]">
  <p class="text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-primary">{label}</p>
  <p class="mt-3 text-[clamp(1.5rem,2vw,2rem)] font-display font-bold leading-none text-foreground">{value}</p>
  {detail && <p class="mt-3 text-sm leading-relaxed text-muted-foreground">{detail}</p>}
</div>
