---
import { getCollection } from "astro:content";

import WorkCard from "./WorkCard.astro";
import {
  getEntryHref,
  getEntrySummary,
  getEntryTags,
  getEntryTypeLabel,
  isPublicEntryData,
} from "../lib/content";
import { resolveRelatedEntries } from "../lib/relatedContent";

interface Props {
  currentCollection: "articles" | "projects";
  currentSlug: string;
  currentPillar:
    | "data-journalism-civic-tech"
    | "scientific-environmental-modeling"
    | "geopolitical-network-analysis"
    | "software-systems-architecture";
  language: "en" | "tr";
  relatedContent?: Array<{ collection: "articles" | "projects"; slug: string }>;
}

const {
  currentCollection,
  currentSlug,
  currentPillar,
  language,
  relatedContent = [],
} = Astro.props;

const [articles, projects] = await Promise.all([
  getCollection("articles", ({ data }) => isPublicEntryData(data)),
  getCollection("projects", ({ data }) => isPublicEntryData(data)),
]);

const entries = resolveRelatedEntries({
  articles,
  projects,
  currentCollection,
  currentSlug,
  currentPillar,
  relatedContent,
});

const heading = language === "tr" ? "Daha fazla" : "More";
---

{
  entries.length > 0 && (
    <section class="border-white/8 mt-20 border-t pt-10">
      <div class="mb-10 max-w-2xl">
        <span class="text-xs font-semibold uppercase tracking-[0.18em] text-primary">
          {heading}
        </span>
      </div>

      <div class="grid gap-6 lg:grid-cols-3">
        {entries.map((entry) => (
          <WorkCard
            title={entry.data.title}
            eyebrow={getEntryTypeLabel(entry, language)}
            pillar={entry.data.pillar}
            meta={entry.data.pubDate.toLocaleDateString(
              entry.data.language === "tr" ? "tr-TR" : "en-US",
              {
                year: "numeric",
                month: "short",
                day: "numeric",
              },
            )}
            description={getEntrySummary(entry)}
            href={getEntryHref(entry)}
            external={false}
            role={entry.data.role}
            impact={entry.data.impact}
            tags={getEntryTags(entry).slice(0, 4)}
            image={entry.data.heroImage}
            imageFit={
              entry.collection === "projects" &&
              (entry.id === "yeser" || entry.id === "ai-fit-check")
                ? "contain"
                : "cover"
            }
            ctaLabel={
              entry.collection === "projects"
                ? "Open case study"
                : "Read article"
            }
          />
        ))}
      </div>
    </section>
  )
}
