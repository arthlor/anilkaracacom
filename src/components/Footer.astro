---
import { resumeLinks } from '../data/portfolio';
import { navigationLinks, siteConfig, socialLinks } from '../lib/site';

interface Props {
  hideCTA?: boolean;
}

const { hideCTA = false } = Astro.props;

const socialLinkMap = new Map(
  socialLinks.map((link) => [
    link.label === 'X (Twitter)' ? 'X' : link.label,
    {
      ...link,
      label: link.label === 'X (Twitter)' ? 'X' : link.label,
    },
  ]),
);

const footerSocialLinks = ['X', 'LinkedIn', 'GitHub', 'YouTube']
  .map((label) => socialLinkMap.get(label))
  .filter((link): link is NonNullable<(typeof socialLinks)[number]> => Boolean(link));
---

<footer class="site-footer">
  <div class="site-footer__container">
    {!hideCTA && (
      <div class="site-footer__cta">
        <div class="site-footer__cta-content">
          <h2 class="site-footer__cta-title">
            Let's build <br />
            <span>something great.</span>
          </h2>
          <a href="/contact" class="site-footer__cta-button">
            Start a project
            <svg viewBox="0 0 16 16" fill="none" class="w-4 h-4" stroke="currentColor" stroke-width="1.5">
              <path d="M3.33331 8H12.6666" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M8 3.33331L12.6667 7.99998L8 12.6666" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>
      </div>
    )}

    <div class="site-footer__main">
      <div class="site-footer__brand-col">
        <div class="site-footer__brand-id">
          <span class="site-footer__tag">{siteConfig.personName}</span>
          <p class="site-footer__tag-desc">Data Journalist & Product Engineer</p>
        </div>
        <div class="site-footer__social-pills">
          {footerSocialLinks.map((link) => (
            <a href={link.href} target="_blank" rel="noopener noreferrer" class="site-footer__social-pill">
              {link.label}
            </a>
          ))}
        </div>
      </div>

      <div class="site-footer__nav-grid">
        <div class="site-footer__nav-col">
          <p class="site-footer__nav-label">Navigate</p>
          <div class="site-footer__nav-links">
            {navigationLinks.map(link => (
              <a href={link.href}>{link.label}</a>
            ))}
          </div>
        </div>
        <div class="site-footer__nav-col">
          <p class="site-footer__nav-label">Explore</p>
          <div class="site-footer__nav-links">
            <a href={resumeLinks.master}>Resume</a>
            <a href="/articles">Articles</a>
            <a href={siteConfig.githubUrl} target="_blank">GitHub</a>
          </div>
        </div>
      </div>
    </div>

    <div class="site-footer__bottom">
      <div class="site-footer__legal">
        <span>© {new Date().getFullYear()}</span>
        <a href={`mailto:${siteConfig.contactEmail}`} class="site-footer__contact-link">{siteConfig.contactEmail}</a>
      </div>
      <div class="site-footer__status">
        <span class="site-footer__status-dot"></span>
        <span>Open for new mandates 2024+</span>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    padding: 80px 0 40px;
    background: transparent;
    color: #f3f1eb;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    z-index: 10;
  }

  .site-footer__container {
    width: min(100% - 48px, 1200px);
    margin-inline: auto;
  }

  /* Compact CTA Section */
  .site-footer__cta {
    margin-bottom: 80px;
    padding: 60px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    display: flex;
    justify-content: center;
    text-align: center;
  }

  .site-footer__cta-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 4rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    margin-bottom: 32px;
    color: #fff;
  }

  .site-footer__cta-title span {
    color: var(--premium-accent, #7af298);
  }

  .site-footer__cta-button {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 16px 32px;
    background: #fff;
    color: #000;
    border-radius: 999px;
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: none;
    transition: transform 300ms cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 300ms ease;
  }

  .site-footer__cta-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 20px 40px rgba(255, 255, 255, 0.1);
  }

  /* Main Footer Section */
  .site-footer__main {
    display: flex;
    justify-content: space-between;
    gap: 60px;
    margin-bottom: 80px;
  }

  .site-footer__brand-col {
    display: flex;
    flex-direction: column;
    gap: 24px;
    max-width: 320px;
  }

  .site-footer__tag {
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #fff;
  }

  .site-footer__tag-desc {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.4);
    margin-top: 4px;
  }

  .site-footer__social-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .site-footer__social-pill {
    padding: 6px 14px;
    font-size: 0.75rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.6);
    text-decoration: none;
    transition: all 200ms ease;
  }

  .site-footer__social-pill:hover {
    color: #fff;
  }

  .site-footer__nav-grid {
    display: flex;
    gap: 100px;
  }

  .site-footer__nav-label {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--premium-accent, #7af298);
    margin-bottom: 20px;
  }

  .site-footer__nav-links {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .site-footer__nav-links a {
    font-size: 0.9rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.5);
    text-decoration: none;
    transition: color 200ms ease;
  }

  .site-footer__nav-links a:hover {
    color: #fff;
  }

  /* Bottom Bar */
  .site-footer__bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 32px;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }

  .site-footer__legal {
    display: flex;
    align-items: center;
    gap: 20px;
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.4);
  }

  .site-footer__contact-link {
    color: rgba(255, 255, 255, 0.5);
    text-decoration: none;
    transition: color 200ms ease;
  }

  .site-footer__contact-link:hover {
    color: #fff;
  }

  .site-footer__status {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.75rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.4);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .site-footer__status-dot {
    width: 6px;
    height: 6px;
    background: var(--premium-accent, #7af298);
    border-radius: 50%;
    box-shadow: 0 0 10px var(--premium-accent, #7af298);
  }

  @media (max-width: 768px) {
    .site-footer__main {
      flex-direction: column;
      gap: 48px;
    }

    .site-footer__nav-grid {
      gap: 40px;
      justify-content: space-between;
    }

    .site-footer__bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 24px;
    }
  }
</style>
