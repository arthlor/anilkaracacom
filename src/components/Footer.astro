---
import PixelHead from "./pixel-me/PixelHead.astro";
import { navigationLinks, siteConfig, socialLinks } from "../lib/site";

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer__main">
      <div class="footer__brand">
        <a class="footer__name" href="/">
          <PixelHead size={36} />
          <span>{siteConfig.displayName}</span>
        </a>
        <p class="footer__tagline">
          {siteConfig.role}, based in {siteConfig.location.split(",")[0]}.
        </p>
        <div class="footer__contact">
          <a
            class="footer__email"
            href={`mailto:${siteConfig.contactEmail}`}
            data-track-event="contact_click"
            data-track-label="Footer Email">{siteConfig.contactEmail}</a
          >
          <button
            type="button"
            class="footer__copy"
            data-copy-email={siteConfig.contactEmail}
          >
            Copy
          </button>
          <span class="visually-hidden" role="status" data-copy-status></span>
        </div>
      </div>

      <nav class="footer__col" aria-labelledby="footer-site">
        <h2 id="footer-site" class="footer__heading">Site</h2>
        <ul>
          {
            navigationLinks.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav class="footer__col" aria-labelledby="footer-elsewhere">
        <h2 id="footer-elsewhere" class="footer__heading">Elsewhere</h2>
        <ul>
          {
            socialLinks.map((link) => (
              <li>
                <a href={link.href} target="_blank" rel="noopener noreferrer">
                  {link.label} <span aria-hidden="true">↗</span>
                </a>
              </li>
            ))
          }
          <li><a href="/rss.xml">RSS</a></li>
        </ul>
      </nav>
    </div>

    <div class="footer__bottom">
      <p>© {year} {siteConfig.displayName} · {siteConfig.location}</p>
      <a class="footer__top" href="#top">Back to top <span aria-hidden="true">↑</span></a>
    </div>
  </div>
</footer>

<script>
  const copy = async (text: string) => {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      // Clipboard API blocked: copy through a temporary selection instead.
      const field = document.createElement("textarea");
      field.value = text;
      field.setAttribute("readonly", "");
      field.style.position = "fixed";
      field.style.opacity = "0";
      document.body.append(field);
      field.select();
      const copied = document.execCommand("copy");
      field.remove();
      return copied;
    }
  };

  document
    .querySelectorAll<HTMLButtonElement>("[data-copy-email]")
    .forEach((button) => {
      const status = button.parentElement?.querySelector("[data-copy-status]");
      let reset = 0;
      button.addEventListener("click", async () => {
        // If both ways fail, the address is still a mailto link.
        if (!(await copy(button.dataset.copyEmail ?? ""))) return;
        button.textContent = "Copied ✓";
        button.dataset.copied = "";
        if (status) status.textContent = "Email address copied";
        window.clearTimeout(reset);
        reset = window.setTimeout(() => {
          button.textContent = "Copy";
          delete button.dataset.copied;
          if (status) status.textContent = "";
        }, 2000);
      });
    });
</script>

<style>
  .footer {
    margin-top: auto;
    padding-block: clamp(48px, 7vw, 72px) 28px;
    border-top: 1px solid hsl(var(--border));
    font-size: 0.9375rem;
  }

  .footer__main {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) minmax(0, 1fr);
    gap: 40px 32px;
  }

  .footer__name {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .footer__name :global(.pixel-head) {
    transition: transform 240ms steps(2, jump-none);
  }

  .footer__name:hover :global(.pixel-head) {
    transform: translateY(-3px);
  }

  .footer__tagline {
    max-width: 22rem;
    margin-top: 12px;
    line-height: 1.45;
    color: hsl(var(--muted-foreground));
  }

  .footer__contact {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
    margin-top: 24px;
  }

  .footer__email {
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: hsl(var(--foreground) / 0.25);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
    transition: text-decoration-color 200ms ease;
  }

  .footer__email:hover {
    text-decoration-color: currentColor;
  }

  .footer__copy {
    min-height: 32px;
    padding: 0 11px;
    border: 1px solid hsl(var(--border));
    border-radius: 999px;
    background: transparent;
    font: inherit;
    font-size: 0.75rem;
    font-weight: 500;
    color: hsl(var(--muted-foreground));
    cursor: pointer;
    transition:
      color 200ms ease,
      border-color 200ms ease;
  }

  .footer__copy:hover,
  .footer__copy[data-copied] {
    border-color: hsl(var(--foreground) / 0.3);
    color: hsl(var(--foreground));
  }

  .footer__heading {
    margin-bottom: 14px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0;
    color: hsl(var(--muted-foreground));
  }

  .footer__col ul {
    display: grid;
    gap: 10px;
  }

  .footer__col a,
  .footer__top {
    color: hsl(var(--foreground) / 0.78);
    transition: color 200ms ease;
  }

  .footer__col a:hover,
  .footer__top:hover {
    color: hsl(var(--foreground));
  }

  .footer__col a span {
    color: hsl(var(--muted-foreground));
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px 24px;
    margin-top: clamp(40px, 6vw, 64px);
    padding-top: 20px;
    border-top: 1px solid hsl(var(--border));
    font-size: 0.8125rem;
    color: hsl(var(--muted-foreground));
  }

  .footer__bottom .footer__top {
    color: hsl(var(--muted-foreground));
  }

  .footer__bottom .footer__top:hover {
    color: hsl(var(--foreground));
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (max-width: 719px) {
    .footer__main {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .footer__brand {
      grid-column: 1 / -1;
    }
  }
</style>
