---
import { Image } from "astro:assets";

import type { ProjectEntry } from "../lib/content";

interface Props {
  entry: ProjectEntry;
  size: number;
  class?: string;
}

const { entry, size, class: className } = Astro.props;
const { heroImage, title } = entry.data;
---

{
  heroImage ? (
    <Image
      src={heroImage}
      alt=""
      width={size * 2}
      height={size * 2}
      class:list={["project-icon", className]}
      style={`--icon-size: ${size}px`}
    />
  ) : (
    <span
      class:list={["project-icon project-icon--letter", className]}
      style={`--icon-size: ${size}px`}
      aria-hidden="true"
    >
      {title.charAt(0)}
    </span>
  )
}

<style>
  .project-icon {
    display: block;
    flex: none;
    width: var(--icon-size);
    height: var(--icon-size);
    border-radius: 22.5%;
    box-shadow: inset 0 0 0 1px hsl(var(--foreground) / 0.06);
    object-fit: cover;
  }

  .project-icon--letter {
    display: grid;
    place-items: center;
    background: hsl(var(--foreground));
    color: hsl(var(--background));
    font-size: calc(var(--icon-size) * 0.46);
    font-weight: 600;
    letter-spacing: -0.04em;
  }
</style>
