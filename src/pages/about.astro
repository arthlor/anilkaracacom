---
import Icon from '../components/Icon.astro';
import {
  credibilityHighlights,
  educationEntries,
  experienceEntries,
  publicationEntries,
  resumeLinks,
} from '../data/portfolio';
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="About" description="Full profile for Anil Karaca, including experience, education, and publications.">
  <section class="pt-28 pb-14">
    <div class="container-standard">
      <div class="page-frame p-6 md:p-8">
        <span class="page-kicker">About</span>
        <h1 class="mt-4 max-w-5xl text-5xl font-display font-bold tracking-tight sm:text-6xl">
          One profile across journalism, civic communication, and shipped product work.
        </h1>
        <p class="mt-6 max-w-3xl text-lg leading-relaxed text-muted-foreground">
          This page holds the full story in one place: the role history, the education background, and the graduate
          research that shaped how I think about audiences, media, and interface decisions.
        </p>
        <div class="mt-10 flex flex-col gap-4 sm:flex-row">
          <a
            href={resumeLinks.master}
            class="page-button"
            data-track-event="download_resume"
            data-track-label="About Resume"
          >
            <Icon name="download" size={18} />
            Download resume
          </a>
          <a href="/contact" class="page-button page-button--secondary">
            Contact me
            <Icon name="arrow-right" size={18} />
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="py-14">
    <div class="container-standard">
      <div class="grid gap-4 md:grid-cols-3">
        {credibilityHighlights.map((highlight) => (
          <div class="page-frame-soft p-6 text-sm leading-relaxed text-muted-foreground">
            {highlight}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="container-standard">
      <div class="page-section-head max-w-3xl">
        <span class="page-kicker">Experience</span>
        <h2 class="mt-3 text-3xl font-display font-bold text-foreground">Role history, with the employer context attached</h2>
      </div>

      <div class="space-y-6">
        {experienceEntries.map((entry) => (
          <article class="page-frame p-7 md:p-8">
            <div class="flex flex-col gap-8 lg:flex-row lg:items-start lg:justify-between">
              <div class="max-w-xl">
                <span class="page-kicker">{entry.period}</span>
                <h3 class="mt-3 text-2xl font-display font-bold text-foreground">{entry.role}</h3>
                <p class="mt-2 text-sm font-semibold uppercase tracking-[0.14em] text-primary">{entry.organization}</p>
                <p class="mt-4 text-sm leading-relaxed text-muted-foreground">{entry.context}</p>
              </div>

              <div class="max-w-2xl">
                <p class="text-sm leading-relaxed text-muted-foreground">{entry.summary}</p>
                <div class="mt-5 flex flex-wrap gap-3">
                  {entry.highlights.map((highlight) => (
                    <span class="page-chip !normal-case !tracking-[0.02em]">{highlight}</span>
                  ))}
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="container-standard">
      <div class="page-section-head max-w-3xl">
        <span class="page-kicker">Education</span>
        <h2 class="mt-3 text-3xl font-display font-bold text-foreground">Academic background behind the work</h2>
      </div>

      <div class="grid gap-6 lg:grid-cols-3">
        {educationEntries.map((entry) => (
          <article class="page-frame-soft flex h-full flex-col p-6">
            <span class="page-kicker">{entry.period}</span>
            <h3 class="mt-3 text-2xl font-display font-bold text-foreground">{entry.institution}</h3>
            <p class="mt-2 text-sm font-semibold uppercase tracking-[0.14em] text-primary">{entry.degree}</p>
            <p class="mt-5 text-sm leading-relaxed text-muted-foreground">{entry.grade}</p>
            {entry.notes && <p class="mt-3 text-sm leading-relaxed text-muted-foreground">{entry.notes}</p>}
            {entry.skills && (
              <div class="mt-5 flex flex-wrap gap-3">
                {entry.skills.map((skill) => (
                  <span class="page-chip !normal-case !tracking-[0.02em]">{skill}</span>
                ))}
              </div>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="pb-24 pt-16">
    <div class="container-standard">
      <div class="page-section-head max-w-3xl">
        <span class="page-kicker">Publication</span>
        <h2 class="mt-3 text-3xl font-display font-bold text-foreground">Graduate research that belongs in the profile story</h2>
      </div>

      <div class="space-y-6">
        {publicationEntries.map((entry) => (
          <article class="page-frame p-7 md:p-8">
            <div class="flex flex-col gap-8 lg:flex-row lg:items-start lg:justify-between">
              <div class="max-w-2xl">
                <span class="page-kicker">{entry.type}</span>
                <h3 class="mt-3 text-3xl font-display font-bold text-foreground">{entry.title}</h3>
                <p class="mt-3 text-sm font-semibold uppercase tracking-[0.14em] text-primary">
                  {entry.publisher} · {entry.year}
                </p>
                <p class="mt-5 text-sm leading-relaxed text-muted-foreground">{entry.summary}</p>
              </div>

              <div class="flex shrink-0 items-start">
                <a href={entry.href} target="_blank" rel="noopener noreferrer" class="page-button">
                  Open thesis
                  <Icon name="arrow-right" size={18} />
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</MainLayout>
