---
import Icon from '../components/Icon.astro';
import ResumeLinks from '../components/ResumeLinks.astro';
import { InfiniteMovingCards } from '../components/ui/InfiniteMovingCards';
import {
  careerTimeline,
  credibilityHighlights,
  workplaces,
} from '../data/portfolio';
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="About" description="Background, experience, and credibility notes for Anil Karaca.">
  <section class="relative overflow-hidden pt-28 pb-18">
    <div class="absolute inset-0 bg-gradient-to-b from-card/35 to-background"></div>
    <div class="absolute right-0 top-10 h-[420px] w-[420px] rounded-full bg-primary/10 blur-[120px]"></div>

    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl">
        <span class="text-xs font-semibold uppercase tracking-[0.18em] text-primary">About</span>
        <h1 class="mt-4 text-5xl font-display font-bold tracking-tight sm:text-6xl">
          I built this portfolio around two hiring lanes, but the advantage is the overlap.
        </h1>
        <p class="mt-6 max-w-3xl text-lg leading-relaxed text-muted-foreground">
          I have spent more than a decade working across journalism, public communication, and software delivery. That
          mix is why I can move between story framing, analysis, interface design, and product execution without losing
          clarity.
        </p>
        <div class="mt-10 flex flex-col gap-4 sm:flex-row">
          <a
            href="/anilkaraca-cv.pdf"
            class="inline-flex items-center justify-center gap-2 rounded-2xl bg-primary px-7 py-4 text-sm font-semibold text-primary-foreground transition-all duration-300 hover:brightness-110"
            data-track-event="download_master_resume"
            data-track-label="About Resume"
          >
            <Icon name="download" size={18} />
            Download master resume
          </a>
          <a
            href="/contact"
            class="inline-flex items-center justify-center gap-2 rounded-2xl border border-border bg-card/80 px-7 py-4 text-sm font-semibold text-foreground transition-all duration-300 hover:border-primary/30"
          >
            Contact me
            <Icon name="arrow-right" size={18} />
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="py-14">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-4 md:grid-cols-3">
        {credibilityHighlights.map((highlight) => (
          <div class="rounded-3xl border border-border bg-card/80 p-6 text-sm leading-relaxed text-muted-foreground backdrop-blur-sm">
            {highlight}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="rounded-3xl border border-border bg-card/80 p-8 backdrop-blur-sm">
        <div class="max-w-2xl">
          <span class="text-xs font-semibold uppercase tracking-[0.18em] text-primary">Where I have worked</span>
          <h2 class="mt-3 text-3xl font-display font-bold text-foreground">Newsrooms, civic institutions, and product work all shaped the same skill set.</h2>
        </div>

        <div class="mt-8">
          <InfiniteMovingCards
            client:load
            items={workplaces.map((workplace) => ({
              name: workplace.name,
              image: workplace.logo,
              link: workplace.url,
            }))}
            speed="slow"
            pauseOnHover={true}
            className="mx-auto"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <div class="mb-10 max-w-2xl">
        <span class="text-xs font-semibold uppercase tracking-[0.18em] text-primary">Career arc</span>
        <h2 class="mt-3 text-3xl font-display font-bold text-foreground">A short timeline of how the portfolio came together</h2>
      </div>

      <div class="space-y-5">
        {careerTimeline.map((item) => (
          <div class="rounded-3xl border border-border bg-card/80 p-6 backdrop-blur-sm">
            <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
              <div>
                <span class="text-xs font-semibold uppercase tracking-[0.18em] text-primary">{item.year}</span>
                <h3 class="mt-2 text-xl font-display font-bold text-foreground">{item.title}</h3>
              </div>
              <p class="max-w-2xl text-sm leading-relaxed text-muted-foreground">{item.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-6 lg:grid-cols-2">
        <div class="rounded-3xl border border-border bg-card/80 p-8 backdrop-blur-sm">
          <span class="text-xs font-semibold uppercase tracking-[0.18em] text-primary">Why this portfolio is split</span>
          <div class="mt-5 space-y-4 text-sm leading-relaxed text-muted-foreground">
            <p>
              Recruiters often see mixed profiles as noise. I split the site into `Data Journalism` and `Developer`
              because those are the clearest hiring stories.
            </p>
            <p>
              The split is not artificial. It reflects how I actually work: data-heavy editorial thinking on one side,
              interface and product delivery on the other.
            </p>
            <p>
              The overlap is the differentiator. I can talk to editors, product people, and engineers without needing a
              translator in the room.
            </p>
          </div>
        </div>

        <div class="rounded-3xl border border-border bg-card/80 p-8 backdrop-blur-sm">
          <span class="text-xs font-semibold uppercase tracking-[0.18em] text-primary">Best fit</span>
          <div class="mt-5 space-y-4 text-sm leading-relaxed text-muted-foreground">
            <p>Data journalism teams that need someone comfortable with both reporting and implementation.</p>
            <p>Editorial product teams building tools, explainers, or civic-information experiences.</p>
            <p>Frontend or mobile teams that value product judgment, communication, and speed.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="pb-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <ResumeLinks />
    </div>
  </section>
</MainLayout>
