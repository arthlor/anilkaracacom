---
import JsonLd from "../components/JsonLd.astro";
import MainLayout from "../layouts/MainLayout.astro";
import { educationEntries, experienceEntries } from "../data/portfolio";
import { buildPersonSchema, toJpg } from "../lib/seo";
import { siteConfig, socialLinks } from "../lib/site";
import portrait from "../assets/images/anilkaraca-avatar.webp";

const profile = {
  "@type": "ProfilePage",
  mainEntity: buildPersonSchema(await toJpg(portrait, 512)),
};
---

<MainLayout
  title="About"
  description="Anıl Karaca is a data journalist and developer based in İzmir."
>
  <JsonLd schema={profile} />
  <header class="page-head container">
    <h1 class="t-display">About</h1>
    <p class="about-bio">
      I’m a data journalist and developer in İzmir. I spent five years in
      Turkish newsrooms and five in municipal communications. Now I report with
      public data and build apps, games, and digital products.
    </p>
  </header>

  <section class="container block" aria-labelledby="experience-title">
    <h2 id="experience-title" class="block__title">Experience</h2>
    <ol class="rows" role="list">
      {
        experienceEntries.map((entry) => (
          <li class="rows__item">
            <p class="t-meta rows__period">{entry.period}</p>
            <div>
              <h3 class="rows__heading">{entry.role}</h3>
              <p class="rows__sub">{entry.organization}</p>
              <p class="rows__text">{entry.summary}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="container block" aria-labelledby="education-title">
    <h2 id="education-title" class="block__title">Education</h2>
    <ol class="rows" role="list">
      {
        educationEntries.map((entry) => (
          <li class="rows__item">
            <p class="t-meta rows__period">{entry.period}</p>
            <div>
              <h3 class="rows__heading">{entry.degree}</h3>
              <p class="rows__sub">{entry.institution}</p>
              {entry.note && <p class="rows__text">{entry.note}</p>}
              {entry.thesis && (
                <p class="rows__text">
                  Thesis:{" "}
                  <a
                    class="rows__link"
                    href={entry.thesis.href}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {entry.thesis.title}
                  </a>
                </p>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section id="contact" class="container block block--last" aria-labelledby="contact-title">
    <h2 id="contact-title" class="block__title">Contact</h2>
    <div class="contact">
      <a
        class="contact__email"
        href={`mailto:${siteConfig.contactEmail}`}
        data-track-event="contact_click"
        data-track-label="About Email">{siteConfig.contactEmail}</a
      >
      <ul class="contact__links" role="list">
        {
          socialLinks.map((link) => (
            <li>
              <a
                class="more"
                data-external
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</MainLayout>

<style>
  .about-bio {
    max-width: 38rem;
    margin-top: 20px;
    font-size: clamp(1.1875rem, 2vw, 1.5rem);
    line-height: 1.38;
    letter-spacing: -0.015em;
    color: hsl(var(--foreground) / 0.72);
    text-wrap: pretty;
  }

  .block {
    padding-bottom: clamp(48px, 7vw, 80px);
  }

  .block--last {
    padding-bottom: clamp(80px, 10vw, 128px);
  }

  .block__title {
    padding-bottom: 12px;
    border-bottom: 1px solid hsl(var(--border));
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: hsl(var(--muted-foreground));
  }

  .rows__item {
    display: grid;
    grid-template-columns: 160px minmax(0, 1fr);
    gap: 4px 24px;
    padding-block: 24px;
  }

  .rows__item + .rows__item {
    border-top: 1px solid hsl(var(--border));
  }

  .rows__period {
    padding-top: 5px;
  }

  .rows__heading {
    font-size: 1.1875rem;
    line-height: 1.3;
  }

  .rows__link {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-decoration-color: hsl(var(--foreground) / 0.25);
    text-underline-offset: 0.2em;
  }

  .rows__link:hover {
    text-decoration-color: currentColor;
  }

  .rows__sub {
    margin-top: 2px;
    color: hsl(var(--foreground) / 0.72);
  }

  .rows__text {
    max-width: 40rem;
    margin-top: 8px;
    color: hsl(var(--muted-foreground));
    text-wrap: pretty;
  }

  .contact {
    padding-top: 28px;
  }

  .contact__email {
    font-size: clamp(1.5rem, 3.6vw, 2.5rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    overflow-wrap: anywhere;
  }

  .contact__email:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.15em;
  }

  .contact__links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 28px;
    margin-top: 28px;
  }

  @media (max-width: 599px) {
    .rows__item {
      grid-template-columns: minmax(0, 1fr);
    }

    .rows__period {
      padding-top: 0;
    }
  }
</style>
