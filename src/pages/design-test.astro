---
import MainLayout from "../layouts/MainLayout.astro";
import Icon from "../components/Icon.astro";
import { cn } from "../lib/utils";
---

<MainLayout title="Design System Test" noindex={true}>
  <div class="container mx-auto p-8 space-y-8">
    <h1 class="text-4xl font-bold">Design System Integration Test</h1>

    <section class="space-y-4">
      <h2 class="text-2xl font-semibold">1. Icon Rendering</h2>
      <div class="flex gap-4 text-3xl">
        <Icon name="arrow-right" size={28} />
        <Icon name="data-journalism" size={28} class="text-primary" />
        <Icon name="code" size={28} class="text-secondary" />
      </div>
      <p class="text-sm text-muted-foreground">
        This page stays available for local visual checks but is excluded from
        indexing.
      </p>
    </section>

    <section class="space-y-4">
      <h2 class="text-2xl font-semibold">2. Shadcn Theming & cn() Utility</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div
          class={cn(
            "rounded-lg border bg-card text-card-foreground shadow-sm p-6",
          )}
        >
          <h3 class="text-lg font-semibold mb-2">Default Card</h3>
          <p class="text-muted-foreground">
            This uses the default card variables.
          </p>
        </div>

        <div
          class={cn(
            "rounded-lg border bg-card text-card-foreground shadow-sm p-6",
            "bg-primary text-primary-foreground border-primary",
          )}
        >
          <h3 class="text-lg font-semibold mb-2">Primary Card</h3>
          <p>This uses the primary color variables verified with cn().</p>
        </div>

        <div
          class={cn(
            "rounded-lg border bg-card text-card-foreground shadow-sm p-6",
            "bg-destructive text-destructive-foreground",
          )}
        >
          <h3 class="text-lg font-semibold mb-2">Destructive Card</h3>
          <p>Testing destructive colors.</p>
        </div>
      </div>
    </section>
  </div>
</MainLayout>
