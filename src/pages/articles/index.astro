---
import { getCollection } from "astro:content";

import ArticleCard from "../../components/ArticleCard.astro";
import JsonLd from "../../components/JsonLd.astro";
import {
  getArticleHref,
  isPublicEntryData,
  sortEntriesByDateDesc,
} from "../../lib/content";
import MainLayout from "../../layouts/MainLayout.astro";
import { buildArticleListSchema } from "../../lib/seo";

const articles = sortEntriesByDateDesc(
  await getCollection("articles", ({ data }) => isPublicEntryData(data)),
);
const [lead, ...rest] = articles;
// Rows of three, led by enough rows of two that none is left short.
const pairs = [0, 4, 2][rest.length % 3] ?? 0;

const collection = {
  "@type": "CollectionPage",
  name: "Articles",
  mainEntity: buildArticleListSchema(
    articles.map((entry) => ({
      href: entry.data.externalUrl ? getArticleHref(entry) : `${getArticleHref(entry)}/`,
      title: entry.data.title,
    })),
  ),
};
---

<MainLayout
  title="Articles"
  description="Data journalism by Anıl Karaca, in English and Turkish."
>
  <JsonLd schema={collection} />
  <header class="page-head container">
    <h1 class="t-display">Articles</h1>
  </header>

  <div class="container articles">
    {
      lead && (
        <div class="articles__lead">
          <ArticleCard
            entry={lead}
            variant="feature"
            headingLevel="h2"
            loading="eager"
          />
        </div>
      )
    }

    <ul class="articles__grid" role="list">
      {
        rest.map((entry, index) => (
          <li
            class:list={[
              index < pairs && "articles__pair",
              rest.length % 2 === 1 &&
                index === rest.length - 1 &&
                "articles__last-odd",
            ]}
          >
            <ArticleCard
              entry={entry}
              headingLevel="h2"
              sizes={
                index < pairs
                  ? "(min-width: 900px) 560px, (min-width: 600px) 50vw, 100vw"
                  : undefined
              }
            />
          </li>
        ))
      }
    </ul>
  </div>
</MainLayout>

<style>
  .articles {
    padding-bottom: clamp(80px, 10vw, 128px);
  }

  .articles__lead {
    padding-bottom: clamp(40px, 6vw, 64px);
    margin-bottom: clamp(40px, 6vw, 64px);
    border-bottom: 1px solid hsl(var(--border));
  }

  .articles__grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 56px 24px;
  }

  .articles__grid > li {
    grid-column: span 2;
  }

  .articles__grid > .articles__pair {
    grid-column: span 3;
  }

  @media (max-width: 899px) {
    .articles__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .articles__grid > li,
    .articles__grid > .articles__pair {
      grid-column: auto;
    }
  }

  /* A card left alone on the last row of two spans it instead. */
  @media (min-width: 600px) and (max-width: 899px) {
    .articles__grid > .articles__last-odd {
      grid-column: 1 / -1;
    }

    .articles__last-odd :global(.card__media img) {
      aspect-ratio: 2 / 1;
    }
  }

  @media (max-width: 599px) {
    .articles__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 40px;
    }
  }
</style>
