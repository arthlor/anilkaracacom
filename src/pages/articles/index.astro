---
import { getCollection } from 'astro:content';

import ProjectArchiveCard from '../../components/ProjectArchiveCard.astro';
import {
  getEntrySummary,
  getEntryTags,
  getArticleHref,
  getEntryTypeLabel,
  groupEntriesByPillar,
  sortEntriesByFeatureAndDate,
} from '../../lib/content';
import MainLayout from '../../layouts/MainLayout.astro';

const articles = sortEntriesByFeatureAndDate(
  await getCollection('articles', ({ data }) => data.published),
);
const grouped = groupEntriesByPillar(articles).filter((section) => section.entries.length > 0);
const sectionTitleClass =
  'mt-3 max-w-2xl text-[clamp(2rem,3vw,2.55rem)] font-display font-bold leading-[1.08] text-foreground';
const sectionDescriptionClass = 'mt-3 max-w-2xl text-[0.98rem] leading-8 text-muted-foreground';
---

<MainLayout
  title="Articles"
  description="Article archive for Anil Karaca, grouped by pillar across data journalism, systems analysis, and political reporting."
>
  <section class="pt-28 pb-14">
    <div class="container-standard">
      <div class="page-frame p-6 md:p-8">
        <span class="page-kicker">Articles showcase</span>
        <h1 class="mt-4 text-5xl font-display font-bold tracking-tight text-foreground sm:text-6xl">
          Reporting, investigations, and analysis in one writing archive.
        </h1>
        <p class="mt-5 max-w-2xl text-base leading-8 text-muted-foreground sm:text-[1.02rem]">
          A dedicated showcase for reported pieces, data-led analysis, and long-form explanatory work.
        </p>
      </div>
    </div>
  </section>

  <section class="pb-20 pt-6">
    <div class="container-standard">
      <div class="space-y-14">
        {grouped.map((section) => (
          <section>
            <div class="mb-6">
              <div class="page-section-head mb-0 max-w-3xl">
                <span class="page-kicker">{section.shortTitle}</span>
                <h2 class={sectionTitleClass}>{section.title}</h2>
                <p class={sectionDescriptionClass}>{section.description}</p>
              </div>
            </div>

            <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
              {section.entries.map((entry) => (
                <ProjectArchiveCard
                  title={entry.data.title}
                  eyebrow={getEntryTypeLabel(entry)}
                  meta={entry.data.pubDate.toLocaleDateString(entry.data.language === 'tr' ? 'tr-TR' : 'en-US', {
                    year: 'numeric',
                    month: 'short',
                    day: 'numeric',
                  })}
                  description={getEntrySummary(entry)}
                  href={getArticleHref(entry)}
                  external={false}
                  role={entry.data.role}
                  impact={entry.data.impact}
                  tags={getEntryTags(entry)}
                  image={entry.data.heroImage}
                  ctaLabel="Read article"
                />
              ))}
            </div>
          </section>
        ))}
      </div>
    </div>
  </section>
</MainLayout>
