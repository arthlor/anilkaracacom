---
import { getCollection } from 'astro:content';

import WorkCard from '../../components/WorkCard.astro';
import {
  getArticleHref,
  getEntrySummary,
  groupEntriesByPillar,
  sortEntriesByFeatureAndDate,
} from '../../lib/content';
import MainLayout from '../../layouts/MainLayout.astro';

const articles = sortEntriesByFeatureAndDate(
  await getCollection('articles', ({ data }) => data.published),
);
const grouped = groupEntriesByPillar(articles).filter((section) => section.entries.length > 0);
---

<MainLayout
  title="Articles"
  description="Article archive for Anil Karaca, grouped by pillar across data journalism, systems analysis, and political reporting."
>
  <section class="pt-28 pb-14">
    <div class="container-standard">
      <div class="page-frame p-6 md:p-8">
        <span class="page-kicker">Article archive</span>
        <h1 class="mt-4 text-5xl font-display font-bold tracking-tight text-foreground sm:text-6xl">
          Reporting, investigations, and analysis in one writing archive.
        </h1>
        <p class="mt-6 max-w-3xl text-lg leading-relaxed text-muted-foreground">
          This is the writing-focused archive for readers who want articles only. The main work library lives in
          `Projects`, while this page keeps the reporting material easy to browse on its own.
        </p>
      </div>
    </div>
  </section>

  <section class="pb-24 pt-8">
    <div class="container-standard">
      <div class="space-y-16">
        {grouped.map((section) => (
          <section>
            <div class="mb-8">
              <div class="page-section-head mb-0 max-w-3xl">
                <span class="page-kicker">{section.shortTitle}</span>
                <h2 class="mt-3 text-3xl font-display font-bold text-foreground">{section.title}</h2>
                <p class="mt-3 text-base leading-relaxed text-muted-foreground">{section.description}</p>
              </div>
            </div>

            <div class="grid gap-6 lg:grid-cols-3">
              {section.entries.map((entry) => (
                <WorkCard
                  title={entry.data.title}
                  eyebrow={entry.data.language === 'tr' ? 'Article in Turkish' : 'Article in English'}
                  meta={entry.data.pubDate.toLocaleDateString(entry.data.language === 'tr' ? 'tr-TR' : 'en-US', {
                    year: 'numeric',
                    month: 'short',
                    day: 'numeric',
                  })}
                  description={getEntrySummary(entry)}
                  href={getArticleHref(entry)}
                  external={false}
                  tags={entry.data.tags.slice(0, 4)}
                  image={entry.data.heroImage}
                  ctaLabel="Read article"
                />
              ))}
            </div>
          </section>
        ))}
      </div>
    </div>
  </section>
</MainLayout>
