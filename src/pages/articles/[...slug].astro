---
import { getCollection } from "astro:content";

import ArticleLayout from "../../layouts/ArticleLayout.astro";
import { isPublicEntryData } from "../../lib/content";
import { resolveRelatedArticles } from "../../lib/relatedContent";
import { validatePortfolioContent } from "../../lib/validateContent";

export async function getStaticPaths() {
  await validatePortfolioContent();

  const articles = await getCollection("articles", ({ data }) =>
    isPublicEntryData(data),
  );

  return articles
    .filter((article) => !article.data.externalUrl)
    .map((article) => ({
      params: { slug: article.id },
      props: {
        entry: article,
        related: resolveRelatedArticles({ articles, current: article }),
      },
    }));
}

const { entry, related } = Astro.props;
---

<ArticleLayout entry={entry} related={related} />
