---
import { getCollection, render } from "astro:content";

import CaseStudyLayout from "../../layouts/CaseStudyLayout.astro";
import { isPublicEntryData } from "../../lib/content";
import { validatePortfolioContent } from "../../lib/validateContent";

export async function getStaticPaths() {
  await validatePortfolioContent();

  const articles = await getCollection("articles", ({ data }) =>
    isPublicEntryData(data),
  );
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { entry: article },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<CaseStudyLayout entry={entry} collection="articles" Content={Content} />
