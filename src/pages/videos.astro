---
import { getCollection, type CollectionEntry } from 'astro:content';

import Icon from '../components/Icon.astro';
import MainLayout from '../layouts/MainLayout.astro';

const videos: CollectionEntry<'videos'>[] = await getCollection('videos');
const featuredVideo = videos.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())[0];
---

<MainLayout title="Supporting Video Work" description="Supporting documentary and visual storytelling work by Anil Karaca.">
  <section class="relative overflow-hidden pt-28 pb-18">
    <div class="absolute inset-0 bg-gradient-to-b from-card/35 to-background"></div>

    <div class="relative mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <span class="text-xs font-semibold uppercase tracking-[0.18em] text-primary">Supporting work</span>
      <h1 class="mt-4 text-5xl font-display font-bold tracking-tight sm:text-6xl">
        Video is supporting proof of my storytelling process, not a separate hiring lane.
      </h1>
      <p class="mt-6 max-w-3xl text-lg leading-relaxed text-muted-foreground">
        I keep this page available because documentary and visual communication work strengthens the journalism side of
        the portfolio. It is included as supporting context rather than the main career story.
      </p>
    </div>
  </section>

  {featuredVideo && (
    <section class="pb-24 pt-10">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <div class="grid gap-6 lg:grid-cols-[1.2fr_0.8fr]">
          <div class="overflow-hidden rounded-[2rem] border border-border bg-card/80 backdrop-blur-sm">
            <div class="aspect-video">
              <iframe
                src={`https://www.youtube.com/embed/${featuredVideo.data.videoId}`}
                title={featuredVideo.data.title}
                class="h-full w-full"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
              ></iframe>
            </div>
          </div>

          <div class="rounded-[2rem] border border-border bg-card/80 p-8 backdrop-blur-sm">
            <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-primary/10 text-primary">
              <Icon name="video" size={24} />
            </div>
            <span class="mt-6 block text-xs font-semibold uppercase tracking-[0.18em] text-primary">Documentary</span>
            <h2 class="mt-3 text-3xl font-display font-bold text-foreground">{featuredVideo.data.title}</h2>
            <p class="mt-4 text-sm leading-relaxed text-muted-foreground">{featuredVideo.data.description}</p>

            <div class="mt-6 rounded-2xl border border-border/70 bg-background/50 p-4 text-sm leading-relaxed text-muted-foreground">
              This work supports the portfolio by showing narrative pacing, visual communication, and the ability to
              deliver a complete story package outside standard article formats.
            </div>

            <a
              href={`https://www.youtube.com/watch?v=${featuredVideo.data.videoId}`}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-primary"
            >
              Watch on YouTube
              <Icon name="external-link" size={16} />
            </a>
          </div>
        </div>
      </div>
    </section>
  )}
</MainLayout>
