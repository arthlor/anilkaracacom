---
import { getCollection, type CollectionEntry } from 'astro:content';

import Icon from '../components/Icon.astro';
import MainLayout from '../layouts/MainLayout.astro';

const videos: CollectionEntry<'videos'>[] = await getCollection('videos');
const featuredVideo = videos.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())[0];
---

<MainLayout title="Supporting Video Work" description="Supporting documentary and visual storytelling work by Anil Karaca.">
  <section class="pt-28 pb-14">
    <div class="relative mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="page-frame p-6 md:p-8">
        <span class="page-kicker">Supporting work</span>
        <h1 class="mt-4 text-5xl font-display font-bold tracking-tight sm:text-6xl">
          Video is supporting proof of storytelling and communication work.
        </h1>
        <p class="mt-6 max-w-3xl text-lg leading-relaxed text-muted-foreground">
          I keep this page available because documentary and visual communication work strengthens the reporting side of
          the portfolio. It sits here as supporting context rather than a primary destination.
        </p>
      </div>
    </div>
  </section>

  {featuredVideo && (
    <section class="pb-24 pt-10">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <div class="grid gap-6 lg:grid-cols-[1.2fr_0.8fr]">
          <div class="page-frame overflow-hidden">
            <div class="aspect-video">
              <iframe
                src={`https://www.youtube.com/embed/${featuredVideo.data.videoId}`}
                title={featuredVideo.data.title}
                class="h-full w-full"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
              ></iframe>
            </div>
          </div>

          <div class="page-frame-soft p-8">
            <div class="page-icon-tile h-14 w-14">
              <Icon name="video" size={24} />
            </div>
            <span class="page-kicker mt-6">Documentary</span>
            <h2 class="mt-3 text-3xl font-display font-bold text-foreground">{featuredVideo.data.title}</h2>
            <p class="mt-4 text-sm leading-relaxed text-muted-foreground">{featuredVideo.data.description}</p>

            <div class="page-frame mt-6 p-4 text-sm leading-relaxed text-muted-foreground">
              This work supports the portfolio by showing narrative pacing, visual communication, and the ability to
              deliver a complete story package outside standard article formats.
            </div>

            <a
              href={`https://www.youtube.com/watch?v=${featuredVideo.data.videoId}`}
              target="_blank"
              rel="noopener noreferrer"
              class="page-inline-link mt-6"
            >
              Watch on YouTube
              <Icon name="external-link" size={16} />
            </a>
          </div>
        </div>
      </div>
    </section>
  )}
</MainLayout>
