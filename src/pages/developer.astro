---
import Icon from "../components/Icon.astro";
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout
  title="Developer"
  description="This overview has been folded into the main projects library."
  noindex={true}
>
  <section class="pt-28 pb-24">
    <div class="container-standard">
      <div class="page-frame p-8 text-center md:p-12">
        <span class="page-kicker">Moved</span>
        <h1
          class="mt-4 text-4xl font-display font-bold tracking-tight text-foreground sm:text-5xl"
        >
          This work now lives inside the main projects library.
        </h1>
        <p
          class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-muted-foreground"
        >
          The portfolio now uses one primary work flow instead of separate lane
          pages. Use `Projects` for case studies and shipped apps, or `Contact`
          if you want the fastest route for role discussions.
        </p>

        <div class="mt-8 flex flex-col justify-center gap-4 sm:flex-row">
          <a href="/projects" class="page-button">
            Open Projects
            <Icon name="arrow-right" size={18} />
          </a>
          <a href="/contact" class="page-button page-button--secondary">
            Contact Me
            <Icon name="arrow-right" size={18} />
          </a>
        </div>
      </div>
    </div>
  </section>
</MainLayout>
