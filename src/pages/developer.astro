---
import Icon from "../components/Icon.astro";
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout
  title="Developer"
  description="Anil Karaca's development work is now part of the main projects page."
  noindex={true}
>
  <section class="pt-28 pb-24">
    <div class="container-standard">
      <div class="page-frame p-8 text-center md:p-12">
        <span class="page-kicker">Page moved</span>
        <h1
          class="mt-4 text-4xl font-display font-bold tracking-tight text-foreground sm:text-5xl"
        >
          My development work is now in Projects.
        </h1>
        <p
          class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-muted-foreground"
        >
          I’ve brought my app and web work together on one page. Browse Projects
          for the full case-study library, or get in touch if you’d like to
          discuss a role or collaboration.
        </p>

        <div class="mt-8 flex flex-col justify-center gap-4 sm:flex-row">
          <a href="/projects" class="page-button">
            Browse projects
            <Icon name="arrow-right" size={18} />
          </a>
          <a href="/contact" class="page-button page-button--secondary">
            Get in touch
            <Icon name="arrow-right" size={18} />
          </a>
        </div>
      </div>
    </div>
  </section>
</MainLayout>
