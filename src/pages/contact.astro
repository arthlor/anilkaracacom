---
import Icon from '../components/Icon.astro';
import MainLayout from '../layouts/MainLayout.astro';

const socialLinks = [
  {
    name: 'LinkedIn',
    handle: '/in/anil-karaca',
    href: 'https://www.linkedin.com/in/anil-karaca/',
    icon: 'linkedin',
    description: 'Best for recruiter outreach and role conversations.',
  },
  {
    name: 'GitHub',
    handle: '@arthlor',
    href: 'https://github.com/arthlor',
    icon: 'github',
    description: 'Code, experiments, and shipped repositories.',
  },
  {
    name: 'X',
    handle: '@anilkaraca17',
    href: 'https://x.com/anilkaraca17',
    icon: 'twitter',
    description: 'Public writing and shorter updates.',
  },
];
---

<MainLayout title="Contact" description="Direct contact details for Anil Karaca.">
  <section class="pt-28 pb-14">
    <div class="relative mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="page-frame p-6 md:p-8">
        <span class="page-kicker">Contact</span>
        <h1 class="mt-4 max-w-4xl text-5xl font-display font-bold tracking-tight sm:text-6xl">
          Email is the fastest way to reach me.
        </h1>
        <p class="mt-6 max-w-3xl text-lg leading-relaxed text-muted-foreground">
          For roles, collaborations, or project conversations, start with email and I can send the right material from
          there.
        </p>
      </div>
    </div>
  </section>

  <section class="pb-24 pt-8">
    <div class="mx-auto grid max-w-6xl gap-6 px-4 sm:px-6 lg:grid-cols-[1.1fr_0.9fr] lg:px-8">
      <a
        href="mailto:anilkaraca140@gmail.com"
        class="page-frame group p-8 transition-all duration-300 hover:border-primary/30"
        data-track-event="contact_click"
        data-track-label="Primary Email"
      >
        <div class="page-icon-tile h-16 w-16">
          <Icon name="mail" size={28} />
        </div>
        <span class="page-kicker mt-6">Primary contact</span>
        <h2 class="mt-3 text-3xl font-display font-bold text-foreground">anilkaraca140@gmail.com</h2>
        <p class="mt-4 max-w-xl text-sm leading-relaxed text-muted-foreground">
          Best for recruiter outreach, hiring-manager intros, and collaboration requests. I usually reply within one or
          two days.
        </p>
        <span class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-primary transition-all group-hover:gap-3">
          Send an email
          <Icon name="arrow-right" size={16} />
        </span>
      </a>

      <div class="page-frame-soft p-8">
        <span class="page-kicker">Profiles</span>
        <div class="mt-6 space-y-4">
          {socialLinks.map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-start gap-4 rounded-[1.25rem] border border-white/[0.08] bg-white/[0.02] p-4 transition-all duration-300 hover:border-primary/30"
            >
              <div class="page-icon-tile h-12 w-12 shrink-0">
                <Icon name={link.icon} size={22} />
              </div>
              <div>
                <h3 class="text-lg font-display font-bold text-foreground">{link.name}</h3>
                <p class="mt-1 text-sm font-medium text-primary">{link.handle}</p>
                <p class="mt-3 text-sm leading-relaxed text-muted-foreground">{link.description}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>
</MainLayout>
