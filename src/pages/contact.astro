---
import Icon from '../components/Icon.astro';
import ResumeLinks from '../components/ResumeLinks.astro';
import { contactFocusAreas } from '../data/portfolio';
import MainLayout from '../layouts/MainLayout.astro';

const socialLinks = [
  {
    name: 'LinkedIn',
    handle: '/in/anil-karaca',
    href: 'https://www.linkedin.com/in/anil-karaca/',
    icon: 'linkedin',
    description: 'Best place for recruiter outreach and role discussions.',
  },
  {
    name: 'GitHub',
    handle: '@arthlor',
    href: 'https://github.com/arthlor',
    icon: 'github',
    description: 'Code, experiments, and shipped repositories.',
  },
  {
    name: 'X',
    handle: '@anilkaraca17',
    href: 'https://x.com/anilkaraca17',
    icon: 'twitter',
    description: 'Public writing and fast-moving conversations.',
  },
];
---

<MainLayout title="Contact" description="Hiring-focused contact page for Anil Karaca.">
  <section class="relative overflow-hidden pt-28 pb-18">
    <div class="absolute inset-0 bg-gradient-to-b from-card/35 to-background"></div>
    <div class="absolute left-0 top-20 h-[360px] w-[360px] rounded-full bg-primary/10 blur-[120px]"></div>

    <div class="relative mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl">
        <span class="text-xs font-semibold uppercase tracking-[0.18em] text-primary">Contact</span>
        <h1 class="mt-4 text-5xl font-display font-bold tracking-tight sm:text-6xl">
          I am most interested in full-time roles, especially where analysis and product thinking overlap.
        </h1>
        <p class="mt-6 max-w-3xl text-lg leading-relaxed text-muted-foreground">
          If you are hiring for data journalism, editorial product, frontend, or mobile work, email is the fastest
          route. I can share the right resume version and relevant portfolio links quickly.
        </p>
      </div>
    </div>
  </section>

  <section class="py-14">
    <div class="mx-auto grid max-w-6xl gap-6 px-4 sm:px-6 lg:grid-cols-[1.1fr_0.9fr] lg:px-8">
      <a
        href="mailto:anilkaraca140@gmail.com"
        class="group rounded-[2rem] border border-border bg-card/80 p-8 backdrop-blur-sm transition-all duration-300 hover:border-primary/30"
        data-track-event="contact_click"
        data-track-label="Primary Email"
      >
        <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-primary/10 text-primary">
          <Icon name="mail" size={28} />
        </div>
        <span class="mt-6 block text-xs font-semibold uppercase tracking-[0.18em] text-primary">Primary contact</span>
        <h2 class="mt-3 text-3xl font-display font-bold text-foreground">anilkaraca140@gmail.com</h2>
        <p class="mt-4 text-sm leading-relaxed text-muted-foreground">
          Best for recruiter outreach, hiring-manager intros, and role conversations. I typically respond within one or
          two days.
        </p>
        <span class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-primary transition-all group-hover:gap-3">
          Send an email
          <Icon name="arrow-right" size={16} />
        </span>
      </a>

      <div class="rounded-[2rem] border border-border bg-card/80 p-8 backdrop-blur-sm">
        <span class="text-xs font-semibold uppercase tracking-[0.18em] text-primary">Best fit areas</span>
        <div class="mt-5 space-y-3">
          {contactFocusAreas.map((area) => (
            <div class="rounded-2xl border border-border/70 bg-background/50 px-4 py-4 text-sm leading-relaxed text-muted-foreground">
              {area}
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-6 md:grid-cols-3">
        {socialLinks.map((link) => (
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-3xl border border-border bg-card/80 p-6 backdrop-blur-sm transition-all duration-300 hover:border-primary/30"
          >
            <div class="flex items-start gap-4">
              <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-primary/10 text-primary">
                <Icon name={link.icon} size={22} />
              </div>
              <div>
                <h3 class="text-lg font-display font-bold text-foreground">{link.name}</h3>
                <p class="mt-1 text-sm font-medium text-primary">{link.handle}</p>
                <p class="mt-3 text-sm leading-relaxed text-muted-foreground">{link.description}</p>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="pb-24 pt-6">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <ResumeLinks
        title="Send the right resume with the conversation"
        description="If you are assessing me for a specific track, the tailored versions are easier to review quickly."
      />
    </div>
  </section>
</MainLayout>
