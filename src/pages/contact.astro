---
import Icon from "../components/Icon.astro";
import MainLayout from "../layouts/MainLayout.astro";

const socialLinks = [
  {
    name: "LinkedIn",
    handle: "/in/anil-karaca",
    href: "https://www.linkedin.com/in/anil-karaca/",
    icon: "linkedin",
    description: "Best for recruiter outreach and role conversations.",
  },
  {
    name: "GitHub",
    handle: "@arthlor",
    href: "https://github.com/arthlor",
    icon: "github",
    description: "Code, experiments, and shipped repositories.",
  },
  {
    name: "X",
    handle: "@anilkaraca17",
    href: "https://x.com/anilkaraca17",
    icon: "twitter",
    description: "Public writing and shorter updates.",
  },
];
---

<MainLayout
  title="Contact"
  description="Direct contact details for Anil Karaca."
>
  <section class="contact-hero">
    <div class="contact-hero__shell">
      <header class="contact-hero__copy">
        <p class="contact-hero__eyebrow">Contact</p>
        <h1>Get in Touch</h1>
        <p class="contact-hero__subtitle">
          Email is the fastest way to reach me.
        </p>
        <p class="contact-hero__description">
          For roles, collaborations, or project conversations, start with email
          and I can send the right material from there.
        </p>
      </header>
    </div>
  </section>

  <section class="contact-body">
    <div class="contact-body__shell">
      <div class="contact-grid">
        <!-- Email Action Card -->
        <a
          href="mailto:anilkaraca140@gmail.com"
          class="contact-email-card"
          data-track-event="contact_click"
          data-track-label="Primary Email"
        >
          <div class="contact-email-card__icon-wrap">
            <Icon name="mail" size={26} />
          </div>
          <span class="contact-email-card__kicker">Primary contact</span>
          <h2 class="contact-email-card__address">anilkaraca140@gmail.com</h2>
          <p class="contact-email-card__desc">
            Best for recruiter outreach, hiring-manager intros, and
            collaboration requests. I usually reply within one or two days.
          </p>
          <span class="contact-email-card__action">
            Send an email
            <Icon name="arrow-right" size={16} />
          </span>
        </a>

        <!-- Social Profile List -->
        <div class="contact-profiles-card">
          <span class="contact-profiles-card__kicker">Profiles</span>
          <div class="contact-profiles-list">
            {
              socialLinks.map((link) => (
                <a
                  href={link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="contact-profile-item"
                >
                  <div class="contact-profile-item__icon-wrap">
                    <Icon name={link.icon} size={20} />
                  </div>
                  <div class="contact-profile-item__content">
                    <h3 class="contact-profile-item__name">{link.name}</h3>
                    <p class="contact-profile-item__handle">{link.handle}</p>
                    <p class="contact-profile-item__desc">{link.description}</p>
                  </div>
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>
</MainLayout>

<style>
  /* Base & Hero */
  .contact-hero {
    padding: 7.5rem 0 3.5rem;
  }

  .contact-hero__shell {
    width: min(100% - 2rem, 1200px);
    margin-inline: auto;
  }

  .contact-hero__copy {
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    padding-bottom: 3.5rem;
  }

  .contact-hero__eyebrow {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--premium-accent, #7af298);
  }

  .contact-hero h1 {
    margin-top: 0.6rem;
    font-size: 4.8rem;
    line-height: 1;
    letter-spacing: -0.02em;
    font-family: var(--font-display);
    font-weight: 800;
    color: hsl(var(--foreground));
  }

  .contact-hero__subtitle {
    max-width: 38rem;
    margin-top: 1.2rem;
    font-size: 1.25rem;
    line-height: 1.6;
    font-family: var(--font-display);
    font-weight: 600;
    color: rgba(255, 255, 255, 0.85);
  }

  .contact-hero__description {
    max-width: 38rem;
    margin-top: 1rem;
    font-size: 0.98rem;
    line-height: 1.75;
    color: hsl(var(--muted-foreground));
  }

  /* Animations */
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .contact-hero,
  .contact-body {
    animation: fadeIn 450ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  /* Body Grid */
  .contact-body {
    padding: 1.5rem 0 7.5rem;
  }

  .contact-body__shell {
    width: min(100% - 2rem, 1200px);
    margin-inline: auto;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 1.5rem;
    align-items: start;
  }

  /* Direct Email Card */
  .contact-email-card {
    display: flex;
    flex-direction: column;
    padding: 3rem 2.5rem;
    border: 1px solid rgba(255, 255, 255, 0.04);
    border-radius: 24px;
    background:
      radial-gradient(
        circle at top left,
        rgba(122, 242, 152, 0.05),
        transparent 30%
      ),
      linear-gradient(
        180deg,
        rgba(255, 255, 255, 0.015),
        rgba(255, 255, 255, 0.005)
      );
    box-shadow: 0 32px 80px rgba(0, 0, 0, 0.22);
    text-decoration: none;
    transition: all 250ms ease;
  }

  .contact-email-card:hover {
    border-color: rgba(122, 242, 152, 0.2);
    transform: translateY(-2px);
    box-shadow:
      0 32px 80px rgba(0, 0, 0, 0.3),
      0 0 40px rgba(122, 242, 152, 0.05);
    background:
      radial-gradient(
        circle at top left,
        rgba(122, 242, 152, 0.08),
        transparent 30%
      ),
      linear-gradient(
        180deg,
        rgba(255, 255, 255, 0.03),
        rgba(255, 255, 255, 0.01)
      );
  }

  .contact-email-card__icon-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 3.5rem;
    width: 3.5rem;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.05);
    color: rgba(255, 255, 255, 0.7);
    transition: all 200ms ease;
  }

  .contact-email-card:hover .contact-email-card__icon-wrap {
    color: var(--premium-accent, #7af298);
    border-color: rgba(122, 242, 152, 0.2);
    background: rgba(122, 242, 152, 0.04);
  }

  .contact-email-card__kicker {
    margin-top: 1.75rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--premium-accent, #7af298);
  }

  .contact-email-card__address {
    margin-top: 0.5rem;
    font-size: 2.2rem;
    line-height: 1.1;
    font-family: var(--font-display);
    font-weight: 800;
    color: hsl(var(--foreground));
  }

  .contact-email-card__desc {
    margin-top: 1rem;
    font-size: 0.94rem;
    line-height: 1.7;
    color: hsl(var(--muted-foreground));
    max-width: 32rem;
  }

  .contact-email-card__action {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 2rem;
    font-size: 0.84rem;
    font-weight: 700;
    color: var(--premium-accent, #7af298);
    transition: all 200ms ease;
  }

  .contact-email-card:hover .contact-email-card__action {
    gap: 0.65rem;
    color: #9af7b1;
  }

  /* Social Profiles Card */
  .contact-profiles-card {
    padding: 2.5rem;
    border: 1px solid rgba(255, 255, 255, 0.04);
    border-radius: 24px;
    background: rgba(255, 255, 255, 0.01);
  }

  .contact-profiles-card__kicker {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: hsl(var(--muted-foreground));
  }

  .contact-profiles-list {
    margin-top: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .contact-profile-item {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    padding: 1.25rem;
    border: 1px solid rgba(255, 255, 255, 0.03);
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.015);
    text-decoration: none;
    transition: all 200ms ease;
  }

  .contact-profile-item:hover {
    border-color: rgba(122, 242, 152, 0.15);
    background: rgba(255, 255, 255, 0.03);
    transform: translateY(-1px);
  }

  .contact-profile-item__icon-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 2.5rem;
    width: 2.5rem;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.04);
    color: rgba(255, 255, 255, 0.5);
    transition: all 200ms ease;
    flex-shrink: 0;
  }

  .contact-profile-item:hover .contact-profile-item__icon-wrap {
    color: var(--premium-accent, #7af298);
    border-color: rgba(122, 242, 152, 0.15);
    background: rgba(122, 242, 152, 0.04);
  }

  .contact-profile-item__content {
    flex: 1;
  }

  .contact-profile-item__name {
    font-size: 1.15rem;
    font-family: var(--font-display);
    font-weight: 700;
    color: hsl(var(--foreground));
  }

  .contact-profile-item__handle {
    margin-top: 0.1rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--premium-accent, #7af298);
  }

  .contact-profile-item__desc {
    margin-top: 0.5rem;
    font-size: 0.86rem;
    line-height: 1.6;
    color: hsl(var(--muted-foreground));
  }

  /* Responsive Adjustments */
  @media (max-width: 1024px) {
    .contact-hero h1 {
      font-size: 3.8rem;
    }

    .contact-grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
  }

  @media (max-width: 768px) {
    .contact-hero {
      padding-top: 6.5rem;
    }

    .contact-hero h1 {
      font-size: 2.8rem;
    }

    .contact-email-card {
      padding: 1.75rem;
      border-radius: 20px;
    }

    .contact-email-card__address {
      font-size: 1.6rem;
    }

    .contact-profiles-card {
      padding: 1.5rem;
      border-radius: 20px;
    }

    .contact-profile-item {
      padding: 1rem;
    }
  }
</style>
