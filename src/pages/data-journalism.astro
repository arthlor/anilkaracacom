---
import { getCollection, type CollectionEntry } from 'astro:content';

import Icon from '../components/Icon.astro';
import ResumeLinks from '../components/ResumeLinks.astro';
import WorkCard from '../components/WorkCard.astro';
import {
  dataJournalismProjectSlugs,
  featuredArticleSlugs,
  journalismMethods,
  resumeLinks,
  supportingVideo,
} from '../data/portfolio';
import { pickEntriesBySlug } from '../lib/content';
import MainLayout from '../layouts/MainLayout.astro';

const projects: CollectionEntry<'projects'>[] = await getCollection('projects');
const articles: CollectionEntry<'articles'>[] = await getCollection('articles', ({ data }) => !data.draft);

const featuredProjects = pickEntriesBySlug<'projects'>(projects, dataJournalismProjectSlugs);
const reportingStories = pickEntriesBySlug<'articles'>(articles, featuredArticleSlugs);

const articleSummary = (article: CollectionEntry<'articles'>) =>
  article.data.summaryEn || article.data.description;
---

<MainLayout
  title="Data Journalism"
  description="Data journalism portfolio for Anil Karaca, featuring investigations, election analysis, civic data reporting, and interactive storytelling."
  image="/images/turkey-elections-2025.png"
>
  <section class="relative overflow-hidden pt-28 pb-18">
    <div class="absolute inset-0 bg-gradient-to-b from-card/40 to-background"></div>
    <div class="absolute -left-10 top-16 h-[420px] w-[420px] rounded-full bg-primary/10 blur-[120px]"></div>

    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl">
        <span class="inline-flex items-center gap-2 rounded-full border border-primary/25 bg-card/80 px-4 py-2 text-sm text-muted-foreground backdrop-blur-sm">
          <Icon name="data-journalism" size={16} class="text-primary" />
          Target roles: Data Journalist, Data Reporter, Investigative / Data Visualization Journalist
        </span>

        <h1 class="mt-8 text-5xl font-display font-bold tracking-tight sm:text-6xl">
          Public-interest stories built from messy data, political context, and clear visuals.
        </h1>

        <p class="mt-6 max-w-3xl text-lg leading-relaxed text-muted-foreground">
          My journalism work focuses on politics, civic systems, elections, and urban data. I combine reporting,
          analysis, and interactive presentation so readers can explore the evidence instead of just reading the
          conclusion.
        </p>

        <div class="mt-10 flex flex-col gap-4 sm:flex-row">
          <a
            href={resumeLinks.dataJournalism}
            class="inline-flex items-center justify-center gap-2 rounded-2xl bg-primary px-7 py-4 text-sm font-semibold text-primary-foreground transition-all duration-300 hover:brightness-110"
            data-track-event="download_data_journalism_resume"
            data-track-label="Data Journalism Hero Resume"
          >
            <Icon name="download" size={18} />
            Download data journalism resume
          </a>
          <a
            href="/contact"
            class="inline-flex items-center justify-center gap-2 rounded-2xl border border-border bg-card/80 px-7 py-4 text-sm font-semibold text-foreground transition-all duration-300 hover:border-primary/30"
            data-track-event="contact_click"
            data-track-label="Data Journalism Contact"
          >
            Contact me
            <Icon name="arrow-right" size={18} />
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="py-14">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mb-8 max-w-2xl">
        <span class="text-xs font-semibold uppercase tracking-[0.18em] text-primary">Method</span>
        <h2 class="mt-3 text-3xl font-display font-bold text-foreground">How I approach data journalism</h2>
      </div>

      <div class="grid gap-5 md:grid-cols-3">
        {journalismMethods.map((method) => (
          <div class="rounded-3xl border border-border bg-card/80 p-6 backdrop-blur-sm">
            <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-primary/10 text-primary">
              <Icon name="data-journalism" size={20} />
            </div>
            <p class="mt-4 text-sm leading-relaxed text-muted-foreground">{method}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mb-10 max-w-2xl">
        <span class="text-xs font-semibold uppercase tracking-[0.18em] text-primary">Featured case studies</span>
        <h2 class="mt-3 text-3xl font-display font-bold text-foreground">Investigations and interactive explainers</h2>
        <p class="mt-3 text-base leading-relaxed text-muted-foreground">
          These are the clearest examples of how I structure a civic or political story around evidence, not just
          narrative framing.
        </p>
      </div>

      <div class="grid gap-6 lg:grid-cols-2">
        {featuredProjects.map((project) => (
          <WorkCard
            title={project.data.title}
            eyebrow="Case study"
            description={project.data.summaryEn || project.data.description}
            href={project.data.liveUrl || `/projects/${project.slug}`}
            external={Boolean(project.data.liveUrl?.startsWith('http'))}
            role={project.data.role}
            impact={project.data.impact}
            tags={project.data.technologies}
            image={project.data.heroImage}
            ctaLabel="Open case study"
          />
        ))}
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mb-10 max-w-2xl">
        <span class="text-xs font-semibold uppercase tracking-[0.18em] text-primary">Selected reporting</span>
        <h2 class="mt-3 text-3xl font-display font-bold text-foreground">Reporting work with English framing</h2>
        <p class="mt-3 text-base leading-relaxed text-muted-foreground">
          Some of the underlying work is in Turkish, but each of these stories is framed here for international
          recruiters and editors.
        </p>
      </div>

      <div class="grid gap-6 lg:grid-cols-3">
        {reportingStories.map((article) => (
          <WorkCard
            title={article.data.title}
            eyebrow={article.data.language === 'tr' ? 'Reported in Turkish' : 'Reported in English'}
            description={articleSummary(article)}
            href={`/articles/${article.slug}`}
            role={article.data.role}
            impact={article.data.impact}
            tags={article.data.tags.slice(0, 3)}
            image={article.data.heroImage}
            ctaLabel="Read article"
          />
        ))}
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-6 lg:grid-cols-[1.2fr_0.8fr]">
        <div class="rounded-3xl border border-border bg-card/80 p-8 backdrop-blur-sm">
          <span class="text-xs font-semibold uppercase tracking-[0.18em] text-primary">Supporting proof</span>
          <h2 class="mt-4 text-3xl font-display font-bold text-foreground">
            Documentary and public communication work sharpened my storytelling range.
          </h2>
          <p class="mt-4 text-base leading-relaxed text-muted-foreground">
            I also worked in municipal communications, producing documentary and digital content at scale. That
            experience strengthened interview structure, audience pacing, and the ability to turn complex public topics
            into understandable stories.
          </p>
          <div class="mt-6 rounded-2xl border border-border bg-background/50 p-5">
            <p class="text-sm font-semibold text-foreground">{supportingVideo.title}</p>
            <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{supportingVideo.description}</p>
            <a
              href={supportingVideo.url}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-primary"
            >
              Watch documentary
              <Icon name="external-link" size={16} />
            </a>
          </div>
        </div>

        <div class="rounded-3xl border border-border bg-card/80 p-8 backdrop-blur-sm">
          <span class="text-xs font-semibold uppercase tracking-[0.18em] text-primary">What I bring</span>
          <div class="mt-5 space-y-4 text-sm leading-relaxed text-muted-foreground">
            <p>
              I can work from raw civic datasets through story framing, analysis, chart design, and the final web
              presentation.
            </p>
            <p>
              I am especially useful in teams covering elections, accountability, local government, and public systems.
            </p>
            <p>
              My technical background helps me move faster when a newsroom needs custom graphics or a lightweight
              editorial product instead of a static article.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <ResumeLinks
        title="Resume options"
        description="The data journalism version is the primary fit here, but the full set is available if you want the broader context."
      />
    </div>
  </section>

  <section class="pb-24">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <div class="rounded-[2rem] border border-primary/20 bg-gradient-to-br from-card to-background p-8 text-center md:p-12">
        <h2 class="text-3xl font-display font-bold text-foreground sm:text-4xl">
          If you need journalism that can stand up to scrutiny, I am ready to talk.
        </h2>
        <p class="mx-auto mt-4 max-w-2xl text-base leading-relaxed text-muted-foreground">
          Reach out if you are hiring for data reporting, investigative storytelling, or editorial product work with a
          strong analysis component.
        </p>
        <div class="mt-8 flex flex-col justify-center gap-4 sm:flex-row">
          <a
            href="/contact"
            class="inline-flex items-center justify-center gap-2 rounded-2xl bg-primary px-7 py-4 text-sm font-semibold text-primary-foreground transition-all duration-300 hover:brightness-110"
            data-track-event="contact_click"
            data-track-label="Data Journalism Footer Contact"
          >
            Contact me
            <Icon name="arrow-right" size={18} />
          </a>
          <a
            href="https://www.linkedin.com/in/anil-karaca/"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 rounded-2xl border border-border bg-card/80 px-7 py-4 text-sm font-semibold text-foreground transition-all duration-300 hover:border-primary/30"
          >
            View LinkedIn
            <Icon name="external-link" size={18} />
          </a>
        </div>
      </div>
    </div>
  </section>
</MainLayout>
