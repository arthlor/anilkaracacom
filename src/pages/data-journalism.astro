---
import Icon from "../components/Icon.astro";
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout
  title="Data Journalism"
  description="Anil Karaca's data journalism work is now available through Projects and Articles."
  noindex={true}
>
  <section class="pt-28 pb-24">
    <div class="container-standard">
      <div class="page-frame p-8 text-center md:p-12">
        <span class="page-kicker">Page moved</span>
        <h1
          class="mt-4 text-4xl font-display font-bold tracking-tight text-foreground sm:text-5xl"
        >
          My data journalism work is now in Projects and Articles.
        </h1>
        <p
          class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-muted-foreground"
        >
          Browse Projects for case studies that show how the work was made, or
          head to Articles for the reporting itself.
        </p>

        <div class="mt-8 flex flex-col justify-center gap-4 sm:flex-row">
          <a href="/projects" class="page-button">
            Browse projects
            <Icon name="arrow-right" size={18} />
          </a>
          <a href="/articles" class="page-button page-button--secondary">
            Read articles
            <Icon name="arrow-right" size={18} />
          </a>
        </div>
      </div>
    </div>
  </section>
</MainLayout>
