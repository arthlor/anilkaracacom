---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

import JsonLd from "../../components/JsonLd.astro";
import ProductCard from "../../components/ProductCard.astro";
import {
  arrangeProducts,
  getProjectMeta,
  isPublicEntryData,
  sortProjects,
} from "../../lib/content";
import MainLayout from "../../layouts/MainLayout.astro";
import { buildProductsSchema, toJpg } from "../../lib/seo";

const projects = sortProjects(
  await getCollection("projects", ({ data }) => isPublicEntryData(data)),
);
const products = arrangeProducts(projects);
const films = projects.filter((entry) => entry.data.kind === "film");

const collection = {
  "@type": "CollectionPage",
  name: "Projects",
  mainEntity: buildProductsSchema(
    await Promise.all(
      projects.map(async (entry) => {
        const art = entry.data.heroImage ?? entry.data.cover;
        return { entry, image: art && (await toJpg(art, 512)) };
      }),
    ),
  ),
};
---

<MainLayout
  title="Projects"
  description="Apps, games, and digital products by Anıl Karaca, and a short documentary."
>
  <JsonLd schema={collection} />
  <header class="page-head container">
    <h1 class="t-display">Projects</h1>
  </header>

  <section class="container group" aria-labelledby="products-title">
    <h2 id="products-title" class="group__title">Products</h2>
    <ul class="products" role="list">
      {
        products.map(({ entry, wide }) => (
          <li class:list={[wide && "products__wide"]}>
            <ProductCard entry={entry} />
          </li>
        ))
      }
    </ul>
  </section>

  {
    films.length > 0 && (
      <section class="container group" aria-labelledby="film-title">
        <h2 id="film-title" class="group__title">Film</h2>
        {films.map((film) => (
          <a
            class="film"
            href={film.data.url}
            target="_blank"
            rel="noopener noreferrer"
            data-track-event="open_project"
            data-track-label={film.data.title}
          >
            {film.data.heroImage && (
              <div class="film__cover">
                <Image
                  src={film.data.heroImage}
                  alt=""
                  widths={[640, 960, 1280]}
                  sizes="(min-width: 900px) 640px, 100vw"
                  loading="lazy"
                />
                <span class="film__play" aria-hidden="true" />
              </div>
            )}
            <div class="film__text">
              <h3 class="film__title" lang="tr">
                {film.data.title}
              </h3>
              <p class="film__desc">{film.data.description}</p>
              <p class="film__meta">
                <span class="t-meta">
                  {getProjectMeta(film).platform} · 2021 · 9 min
                </span>
                <span class="film__cta">
                  {getProjectMeta(film).action} <span aria-hidden="true">↗</span>
                </span>
              </p>
            </div>
          </a>
        ))}
      </section>
    )
  }
</MainLayout>

<style>
  .group {
    padding-bottom: clamp(56px, 8vw, 96px);
  }

  .group:last-of-type {
    padding-bottom: clamp(80px, 10vw, 128px);
  }

  .group__title {
    margin-bottom: 24px;
    padding-bottom: 12px;
    border-bottom: 1px solid hsl(var(--border));
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: hsl(var(--muted-foreground));
  }

  .products {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .products__wide {
    grid-column: 1 / -1;
  }

  /* The film sits in the same rounded card as the products above it. */
  .film {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    align-items: center;
    overflow: hidden;
    border-radius: 28px;
    background: hsl(var(--muted));
    transition: background-color 250ms ease;
  }

  .film:hover {
    background: hsl(var(--foreground) / 0.07);
  }

  .film__cover {
    position: relative;
    align-self: stretch;
    overflow: hidden;
    background: hsl(var(--foreground) / 0.08);
  }

  .film__cover img {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    transition: transform 1400ms var(--ease);
  }

  .film:hover .film__cover img {
    transform: scale(1.03);
  }

  .film__play {
    position: absolute;
    inset: 50% auto auto 50%;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: hsl(0 0% 100% / 0.9);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    transform: translate(-50%, -50%);
    transition: transform 250ms var(--ease);
  }

  .film__play::after {
    content: "";
    position: absolute;
    inset: 50% auto auto 54%;
    border-block: 9px solid transparent;
    border-left: 14px solid #1d1d1b;
    transform: translate(-50%, -50%);
  }

  .film:hover .film__play {
    transform: translate(-50%, -50%) scale(1.06);
  }

  .film__text {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 32px clamp(28px, 4vw, 48px);
  }

  .film__title {
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.028em;
    text-wrap: balance;
  }

  .film__desc {
    margin-top: 8px;
    line-height: 1.45;
    color: hsl(var(--foreground) / 0.66);
    text-wrap: pretty;
  }

  .film__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 14px;
    margin-top: 16px;
  }

  .film__cta {
    padding: 5px 12px;
    border-radius: 999px;
    background: hsl(var(--foreground) / 0.08);
    font-size: 0.8125rem;
    font-weight: 500;
    transition:
      background-color 250ms ease,
      color 250ms ease;
  }

  .film:hover .film__cta {
    background: hsl(var(--foreground));
    color: hsl(var(--background));
  }

  @media (max-width: 899px) {
    .products {
      grid-template-columns: minmax(0, 1fr);
    }

    .film {
      grid-template-columns: minmax(0, 1fr);
    }

    .film__cover img {
      height: auto;
    }
  }

  @media (max-width: 599px) {
    .products {
      gap: 12px;
    }

    .film {
      border-radius: 24px;
    }

    .film__text {
      padding: 20px 22px 24px;
    }

    .film__title {
      font-size: 1.3125rem;
    }
  }
</style>
