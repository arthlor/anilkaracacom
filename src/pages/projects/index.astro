---
import { getCollection } from "astro:content";

import Icon from "../../components/Icon.astro";
import ProjectArchiveCard from "../../components/ProjectArchiveCard.astro";
import TechBadge from "../../components/ui/TechBadge.astro";
import {
  primaryProductProjectSlugs,
  projectShowcaseSections,
} from "../../data/portfolio";
import {
  getArticleHref,
  getEntryHref,
  getEntrySummary,
  getEntryTags,
  getEntryTypeLabel,
  isPublicEntryData,
  sortEntriesByDateDesc,
  sortEntriesByFeatureAndDate,
} from "../../lib/content";
import MainLayout from "../../layouts/MainLayout.astro";

const [projects, latestArticles] = await Promise.all([
  getCollection("projects", ({ data }) => isPublicEntryData(data)),
  getCollection("articles", ({ data }) => isPublicEntryData(data)).then(
    (entries) => sortEntriesByDateDesc(entries).slice(0, 3),
  ),
]);

const featuredProductProjects = new Set<string>(primaryProductProjectSlugs);
const featuredDocumentaryId = "ekmegimizi-buyutuyoruz";
const remainingProjects = sortEntriesByFeatureAndDate(
  projects.filter(
    (entry) =>
      !featuredProductProjects.has(entry.id) &&
      entry.id !== featuredDocumentaryId,
  ),
);
const featuredDocumentary = projects.find(
  (entry) => entry.id === featuredDocumentaryId,
);

const getYouTubeVideoId = (url?: string) => {
  if (!url) return undefined;

  try {
    const parsed = new URL(url);
    const shortId = parsed.hostname.includes("youtu.be")
      ? parsed.pathname.replace(/^\/+/, "")
      : undefined;
    const watchId = parsed.searchParams.get("v") ?? undefined;
    const embedId = parsed.pathname.startsWith("/embed/")
      ? parsed.pathname.split("/")[2]
      : undefined;
    return shortId || watchId || embedId;
  } catch {
    return undefined;
  }
};

const documentaryBadges = [
  "9 min 23 sec",
  "Written by me",
  "Shot by me",
  "Edited by me",
];
const documentaryHighlights = [
  {
    label: "What the film captures",
    text: "The documentary follows process and impact together: how the team works, which neighborhoods it reaches first, and what those interventions mean in daily life.",
  },
];
const featuredDocumentaryVideoId = getYouTubeVideoId(
  featuredDocumentary?.data.demoUrl ?? featuredDocumentary?.data.liveUrl,
);
const featuredDocumentaryHref = featuredDocumentary
  ? getEntryHref(featuredDocumentary)
  : undefined;
const featuredDocumentaryVideoUrl =
  featuredDocumentary?.data.demoUrl ?? featuredDocumentary?.data.liveUrl;
---

<MainLayout
  title="Projects"
  description="Project archive organized into mobile apps, websites, and interactive case studies."
>
  <section class="projects-archive" data-projects-archive>
    <div class="projects-archive__shell">
      <header class="projects-archive__hero">
        <div class="projects-archive__hero-copy">
          <p class="projects-archive__eyebrow">Project archive</p>
          <h1>Projects</h1>
          <p class="projects-archive__subtitle">
            A comprehensive archive of shipped mobile apps, data visualizations, municipal communications, and interactive case studies.
          </p>
        </div>
      </header>

      <div class="projects-archive__controls">
        <div
          class="projects-archive__filter-group"
          role="tablist"
          aria-label="Project categories"
        >
          <button
            class="projects-archive__filter"
            type="button"
            data-filter="all"
            data-active="true"
          >
            All
          </button>
          <button
            class="projects-archive__filter"
            type="button"
            data-filter="mobile-apps"
            data-active="false"
          >
            Mobile Apps
          </button>
          <button
            class="projects-archive__filter"
            type="button"
            data-filter="websites"
            data-active="false"
          >
            Websites
          </button>
          <button
            class="projects-archive__filter"
            type="button"
            data-filter="data-journalism"
            data-active="false"
          >
            Data Journalism & Case Studies
          </button>
        </div>
      </div>

      <div class="projects-archive__content">
        <div class="projects-archive__sections">
          <!-- Mobile Apps Section -->
          {
            projectShowcaseSections
              .filter((s) => s.slug === "mobile-apps")
              .map((section) => (
                <section
                  class="projects-section"
                  id="mobile-apps"
                  data-section="mobile-apps"
                >
                  <div class="projects-section__head">
                    <h2>{section.title}</h2>
                    <span class="projects-section__count">
                      {section.entries.length} shipped
                    </span>
                  </div>
                  <div class="projects-section__grid">
                    {section.entries.map((entry) => (
                      <ProjectArchiveCard
                        title={entry.title}
                        eyebrow={entry.eyebrow}
                        meta={entry.meta}
                        description={entry.description}
                        href={entry.href}
                        external={entry.external}
                        role={entry.role}
                        impact={entry.impact}
                        tags={entry.tags}
                        image={entry.image}
                        imageFit={entry.imageFit ?? "cover"}
                        ctaLabel={entry.ctaLabel}
                      />
                    ))}
                  </div>
                </section>
              ))
          }

          <!-- Websites Section -->
          {
            projectShowcaseSections
              .filter((s) => s.slug === "websites")
              .map((section) => (
                <section
                  class="projects-section"
                  id="websites"
                  data-section="websites"
                >
                  <div class="projects-section__head">
                    <h2>{section.title}</h2>
                    <span class="projects-section__count">
                      {section.entries.length} live
                    </span>
                  </div>
                  <div class="projects-section__grid">
                    {section.entries.map((entry) => (
                      <ProjectArchiveCard
                        title={entry.title}
                        eyebrow={entry.eyebrow}
                        meta={entry.meta}
                        description={entry.description}
                        href={entry.href}
                        external={entry.external}
                        role={entry.role}
                        impact={entry.impact}
                        tags={entry.tags}
                        image={entry.image}
                        imageFit={entry.imageFit ?? "cover"}
                        ctaLabel={entry.ctaLabel}
                      />
                    ))}
                  </div>
                </section>
              ))
          }

          <!-- Data Journalism Section -->
          <section
            class="projects-section"
            id="data-journalism"
            data-section="data-journalism"
          >
            <div class="projects-section__head">
              <h2>
                Reporting-driven investigations, scrollytelling builds, and
                documentary work.
              </h2>
              <span class="projects-section__count">
                {(featuredDocumentary ? 1 : 0) + remainingProjects.length} case studies
              </span>
            </div>

            {
              featuredDocumentary && featuredDocumentaryVideoId && (
                <div class="projects-documentary">
                  <div class="projects-documentary__body">
                    <div class="projects-documentary__player-shell">
                      <div class="projects-documentary__player-meta">
                        <div class="projects-documentary__player-labels">
                          <span>Field documentary</span>
                          <span>İzmirTube / 2021</span>
                        </div>

                        {featuredDocumentaryVideoUrl && (
                          <a
                            href={featuredDocumentaryVideoUrl}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="projects-documentary__player-link"
                          >
                            Watch on YouTube
                            <Icon name="external-link" size={14} />
                          </a>
                        )}
                      </div>

                      <div class="projects-documentary__player-frame">
                        <div
                          class="projects-documentary__player-dots"
                          aria-hidden="true"
                        >
                          <span />
                          <span />
                          <span />
                        </div>

                        <div class="projects-documentary__player-embed">
                          <iframe
                            src={`https://www.youtube-nocookie.com/embed/${featuredDocumentaryVideoId}?rel=0&modestbranding=1`}
                            title={featuredDocumentary.data.title}
                            class="h-full w-full"
                            loading="lazy"
                            referrerpolicy="strict-origin-when-cross-origin"
                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                            allowfullscreen
                          />
                        </div>
                      </div>

                      <p class="projects-documentary__player-caption">
                        A municipal field documentary centered on visible
                        neighborhood change, urgent service delivery, and civic
                        storytelling told at street level.
                      </p>
                    </div>

                    <div class="projects-documentary__content">
                      <div class="projects-documentary__summary-card">
                        <div class="projects-documentary__summary-header">
                          <div class="page-icon-tile h-12 w-12 shrink-0">
                            <Icon name="video" size={20} />
                          </div>
                          <span class="page-kicker">
                            Written, shot, and edited by me
                          </span>
                        </div>
                        <h3 class="projects-documentary__title">
                          {featuredDocumentary.data.title}
                        </h3>
                        <p class="projects-documentary__description">
                          {featuredDocumentary.data.description}
                        </p>

                        <div class="flex flex-wrap gap-2">
                          {documentaryBadges.map((badge) => (
                            <TechBadge label={badge} />
                          ))}
                        </div>

                        <div class="projects-documentary__summary-points">
                          {documentaryHighlights.map((item) => (
                            <div class="projects-documentary__summary-point">
                              <p class="projects-documentary__summary-point-label">
                                {item.label}
                              </p>
                              <p>{item.text}</p>
                            </div>
                          ))}
                        </div>

                        <div class="projects-documentary__actions">
                          {featuredDocumentaryHref && (
                            <a
                              href={featuredDocumentaryHref}
                              class="page-inline-link"
                            >
                              Open case study
                              <Icon name="arrow-right" size={16} />
                            </a>
                          )}

                          {featuredDocumentaryVideoUrl && (
                            <a
                              href={featuredDocumentaryVideoUrl}
                              target="_blank"
                              rel="noopener noreferrer"
                              class="page-inline-link"
                            >
                              Watch on YouTube
                              <Icon name="external-link" size={16} />
                            </a>
                          )}
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              )
            }

            {
              remainingProjects.length > 0 && (
                <div class="projects-section__grid">
                  {remainingProjects.map((entry) => (
                    <ProjectArchiveCard
                      title={entry.data.title}
                      eyebrow={getEntryTypeLabel(entry)}
                      meta={entry.data.pubDate.toLocaleDateString(
                        entry.data.language === "tr" ? "tr-TR" : "en-US",
                        {
                          year: "numeric",
                          month: "short",
                          day: "numeric",
                        },
                      )}
                      description={getEntrySummary(entry)}
                      href={getEntryHref(entry)}
                      external={false}
                      tags={entry.data.techStack}
                      image={entry.data.heroImage}
                      imageFit={
                        entry.id === "yeser" || entry.id === "ai-fit-check"
                          ? "contain"
                          : "cover"
                      }
                      ctaLabel="Open case study"
                    />
                  ))}
                </div>
              )
            }
          </section>

          <!-- Latest Articles Section (Hidden when specific category is filtered) -->
          {
            latestArticles.length > 0 && (
              <section
                class="projects-section"
                id="latest-articles"
                data-section="latest-articles"
              >
                <div class="projects-section__head">
                  <h2>
                    The latest reporting, investigations, and analysis from the
                    writing archive.
                  </h2>
                  <span class="projects-section__count">Recent writing</span>
                </div>

                <div class="projects-section__grid">
                  {latestArticles.map((entry) => (
                    <ProjectArchiveCard
                      title={entry.data.title}
                      eyebrow={getEntryTypeLabel(entry)}
                      meta={entry.data.pubDate.toLocaleDateString(
                        entry.data.language === "tr" ? "tr-TR" : "en-US",
                        {
                          year: "numeric",
                          month: "short",
                          day: "numeric",
                        },
                      )}
                      description={getEntrySummary(entry)}
                      href={getArticleHref(entry)}
                      external={false}
                      role={entry.data.role}
                      impact={entry.data.impact}
                      tags={getEntryTags(entry)}
                      image={entry.data.heroImage}
                      ctaLabel="Read article"
                    />
                  ))}
                </div>
              </section>
            )
          }
        </div>
      </div>
    </div>
  </section>
</MainLayout>

<script is:inline>
  const archive = document.querySelector("[data-projects-archive]");

  if (archive instanceof HTMLElement) {
    const filterButtons = Array.from(archive.querySelectorAll("[data-filter]"));
    const sections = Array.from(archive.querySelectorAll("[data-section]"));

    const applyFilter = (filter) => {
      filterButtons.forEach((button) => {
        if (button instanceof HTMLElement) {
          button.dataset.active = String(button.dataset.filter === filter);
        }
      });

      sections.forEach((section) => {
        if (section instanceof HTMLElement) {
          // If all is selected, show all project sections + latest articles
          // If specific filter, show matching section and hide others (including latest articles)
          const visible =
            filter === "all" || section.dataset.section === filter;
          section.toggleAttribute("hidden", !visible);
        }
      });
    };

    filterButtons.forEach((button) => {
      button.addEventListener("click", () => {
        if (button instanceof HTMLElement && button.dataset.filter) {
          applyFilter(button.dataset.filter);
        }
      });
    });
  }
</script>

<style>
  .projects-archive {
    padding: 7.5rem 0 6rem;
  }

  .projects-archive__shell {
    width: min(100% - 2rem, 1200px);
    margin-inline: auto;
  }

  .projects-archive__hero {
    padding-bottom: 2.5rem;
    border-bottom: 1px solid hsl(var(--foreground) / 0.08);
  }

  .projects-archive__eyebrow {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--premium-accent);
  }

  .projects-archive__hero h1 {
    margin-top: 0.6rem;
    font-size: 4.8rem;
    line-height: 1;
    letter-spacing: -0.02em;
    font-family: var(--font-display);
    font-weight: 800;
    color: hsl(var(--foreground));
  }

  .projects-archive__subtitle {
    max-width: 38rem;
    margin-top: 1.2rem;
    font-size: 1.05rem;
    line-height: 1.75;
    color: hsl(var(--muted-foreground));
  }

  .projects-archive__controls {
    position: sticky;
    top: 78px;
    z-index: 30;
    margin-top: 1.5rem;
    padding: 0.85rem 0;
    background: hsl(var(--background) / 0.88);
    border-bottom: 1px solid hsl(var(--foreground) / 0.08);
    backdrop-filter: blur(16px);
  }

  .projects-archive__filter-group {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .projects-archive__filter {
    min-height: 2.1rem;
    padding: 0.45rem 0.9rem;
    border: 1px solid transparent;
    border-radius: 999px;
    background: transparent;
    color: hsl(var(--muted-foreground));
    font-size: 0.8rem;
    font-weight: 500;
    cursor: pointer;
    transition:
      border-color 180ms ease,
      background 180ms ease,
      color 180ms ease;
  }

  .projects-archive__filter:hover {
    color: hsl(var(--foreground));
    background: hsl(var(--foreground) / 0.04);
  }

  .projects-archive__filter[data-active="true"] {
    border-color: rgba(122, 242, 152, 0.25);
    background: rgba(122, 242, 152, 0.06);
    color: var(--premium-accent);
    font-weight: 600;
  }

  .projects-archive__content {
    margin-top: 3.5rem;
  }

  .projects-archive__sections {
    display: grid;
    gap: 4.5rem;
    min-width: 0;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .projects-section {
    animation: fadeIn 350ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .projects-section[hidden] {
    display: none;
  }

  .projects-section__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 2rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid hsl(var(--foreground) / 0.08);
  }

  .projects-section__head h2 {
    font-size: 1.8rem;
    line-height: 1.25;
    font-family: var(--font-display);
    font-weight: 700;
    color: hsl(var(--foreground));
    max-width: 44rem;
  }

  .projects-section__count {
    font-size: 0.76rem;
    color: hsl(var(--muted-foreground));
    font-weight: 500;
    white-space: nowrap;
    margin-left: 1.5rem;
  }

  .projects-section__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
  }

  /* Documentary Sub-section Layout */
  .projects-documentary {
    position: relative;
    margin-bottom: 3.5rem;
    padding-bottom: 3.5rem;
    border-bottom: 1px solid hsl(var(--foreground) / 0.08);
  }

  .projects-documentary__body {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(320px, 0.75fr);
    gap: 2rem;
    align-items: start;
  }

  .projects-documentary__player-shell {
    position: relative;
    display: grid;
    gap: 1rem;
    padding: clamp(1rem, 1.8vw, 1.3rem);
    border: 1px solid hsl(var(--foreground) / 0.1);
    border-radius: 24px;
    background:
      radial-gradient(
        circle at top left,
        rgba(122, 242, 152, 0.08),
        transparent 34%
      ),
      radial-gradient(
        circle at bottom right,
        rgba(255, 214, 133, 0.05),
        transparent 28%
      ),
      linear-gradient(
        180deg,
        hsl(var(--foreground) / 0.04),
        hsl(var(--foreground) / 0.015)
      );
    box-shadow: 0 32px 80px rgba(0, 0, 0, 0.35);
    overflow: hidden;
  }

  .projects-documentary__player-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    align-items: center;
  }

  .projects-documentary__player-labels {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .projects-documentary__player-labels span {
    display: inline-flex;
    align-items: center;
    min-height: 1.8rem;
    padding: 0 0.75rem;
    border-radius: 999px;
    border: 1px solid hsl(var(--foreground) / 0.1);
    background: hsl(var(--foreground) / 0.04);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: hsl(var(--foreground) / 0.64);
  }

  .projects-documentary__player-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--premium-accent);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: color 180ms ease;
  }

  .projects-documentary__player-link:hover {
    color: #9af7b1;
  }

  .projects-documentary__player-frame {
    position: relative;
    display: grid;
    gap: 0.8rem;
    padding: 0;
  }

  .projects-documentary__player-dots {
    display: inline-flex;
    gap: 0.4rem;
  }

  .projects-documentary__player-dots span {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 999px;
    background: hsl(var(--foreground) / 0.12);
  }

  .projects-documentary__player-dots span:first-child {
    background: rgba(255, 107, 107, 0.8);
  }

  .projects-documentary__player-dots span:nth-child(2) {
    background: rgba(255, 214, 102, 0.8);
  }

  .projects-documentary__player-dots span:last-child {
    background: rgba(122, 242, 152, 0.8);
  }

  .projects-documentary__player-embed {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 16px;
    background: #050505;
  }

  .projects-documentary__player-caption {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.7;
    color: hsl(var(--muted-foreground));
  }

  .projects-documentary__content {
    display: block;
  }

  .projects-documentary__summary-card {
    display: grid;
    gap: 1.25rem;
    padding: 0.5rem;
  }

  .projects-documentary__summary-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.8rem;
  }

  .projects-documentary__title {
    font-size: 2.2rem;
    line-height: 1.15;
    font-family: var(--font-display);
    font-weight: 750;
    color: hsl(var(--foreground));
  }

  .projects-documentary__description {
    font-size: 0.96rem;
    line-height: 1.75;
    color: hsl(var(--muted-foreground));
  }

  .projects-documentary__summary-points {
    display: grid;
    gap: 1rem;
    padding-top: 1.25rem;
    border-top: 1px solid hsl(var(--foreground) / 0.08);
  }

  .projects-documentary__summary-point-label {
    margin: 0 0 0.35rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--premium-accent);
  }

  .projects-documentary__summary-point p:last-child {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.7;
    color: hsl(var(--foreground) / 0.7);
  }

  .projects-documentary__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    align-items: center;
    padding-top: 0.5rem;
  }

  @media (max-width: 1024px) {
    .projects-section__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.5rem;
    }

    .projects-documentary__body {
      grid-template-columns: minmax(0, 1.1fr) minmax(300px, 0.9fr);
      gap: 1.5rem;
    }

    .projects-documentary__title {
      font-size: 1.8rem;
    }
  }

  @media (max-width: 768px) {
    .projects-archive {
      padding-top: 6.5rem;
    }

    .projects-archive__hero h1 {
      font-size: 3.5rem;
    }

    .projects-archive__content {
      margin-top: 2.5rem;
    }

    .projects-section__grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .projects-documentary__body {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.5rem;
    }

    .projects-documentary__player-shell,
    .projects-documentary__summary-card {
      padding: 1rem;
      border-radius: 18px;
    }

    .projects-documentary__player-embed {
      border-radius: 12px;
    }

    .projects-archive__controls {
      position: static;
    }

    .projects-section__head h2 {
      font-size: 1.4rem;
    }
  }
</style>
