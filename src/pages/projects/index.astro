---
import { getCollection } from 'astro:content';

import WorkCard from '../../components/WorkCard.astro';
import {
  getEntryHref,
  getEntrySummary,
  getEntryTypeLabel,
  groupEntriesByPillar,
  sortEntriesByFeatureAndDate,
} from '../../lib/content';
import MainLayout from '../../layouts/MainLayout.astro';

const [articles, projects] = await Promise.all([
  getCollection('articles', ({ data }) => data.published),
  getCollection('projects', ({ data }) => data.published),
]);

const allEntries = sortEntriesByFeatureAndDate([...projects, ...articles]);
const grouped = groupEntriesByPillar(allEntries).filter((section) => section.entries.length > 0);
---

<MainLayout
  title="Projects"
  description="Unified work library spanning shipped apps, investigations, and interactive case studies."
>
  <section class="pt-28 pb-14">
    <div class="container-standard">
      <div class="page-frame p-6 md:p-8">
        <span class="page-kicker">All work</span>
        <h1 class="mt-4 max-w-4xl text-5xl font-display font-bold tracking-tight text-foreground sm:text-6xl">
          The main archive for apps, reporting, investigations, and case studies.
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted-foreground">
          This is the one place to review the full range of work. Everything is grouped by pillar so the connections are
          visible without turning the rest of the site into duplicate archive pages.
        </p>
      </div>
    </div>
  </section>

  <section class="pb-24 pt-8">
    <div class="container-standard">
      <div class="space-y-16">
        {grouped.map((section) => (
          <section>
            <div class="mb-8">
              <div class="page-section-head mb-0 max-w-3xl">
                <span class="page-kicker">{section.shortTitle}</span>
                <h2 class="mt-3 text-3xl font-display font-bold text-foreground">{section.title}</h2>
                <p class="mt-3 text-base leading-relaxed text-muted-foreground">{section.description}</p>
              </div>
            </div>

            <div class="grid gap-6 lg:grid-cols-3">
              {section.entries.map((entry) => (
                <WorkCard
                  title={entry.data.title}
                  eyebrow={getEntryTypeLabel(entry)}
                  meta={entry.data.pubDate.toLocaleDateString(entry.data.language === 'tr' ? 'tr-TR' : 'en-US', {
                    year: 'numeric',
                    month: 'short',
                    day: 'numeric',
                  })}
                  description={getEntrySummary(entry)}
                  href={getEntryHref(entry)}
                  external={false}
                  tags={entry.collection === 'articles' ? entry.data.tags.slice(0, 3) : entry.data.techStack.slice(0, 4)}
                  image={entry.data.heroImage}
                  ctaLabel={entry.collection === 'projects' ? 'Open case study' : 'Read article'}
                />
              ))}
            </div>
          </section>
        ))}
      </div>
    </div>
  </section>
</MainLayout>
