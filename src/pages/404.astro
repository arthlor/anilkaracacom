---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="Page not found" description="This page could not be found." noindex>
  <section class="page-head container not-found">
    <h1 class="t-display">Page not found.</h1>
    <p class="t-lede">The link may be old, or the page has moved.</p>
    <p class="not-found__links">
      <a class="more" href="/">Home</a>
      <a class="more" href="/articles">Articles</a>
    </p>
  </section>
</MainLayout>

<style>
  .not-found {
    min-height: 60vh;
  }

  .not-found__links {
    display: flex;
    gap: 28px;
    margin-top: 28px;
  }
</style>
