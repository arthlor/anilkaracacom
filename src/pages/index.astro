    .portfolio-home__tag-row {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }

    .portfolio-home__tag-row span,
    .portfolio-home__article-meta span {
      display: inline-flex;
      align-items: center;
      min-height: 34px;
      border-radius: 999px;
      background: hsl(var(--foreground) / 0.08);
      padding: 0 14px;
      font-size: 0.82rem;
      color: var(--premium-accent);
