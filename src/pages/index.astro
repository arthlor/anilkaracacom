    .portfolio-home__section-divider {
      display: flex;
      align-items: center;
      gap: 14px;
      margin-bottom: 40px;
      color: var(--premium-accent);
      font-size: 1.25rem;
    }

    .portfolio-home__section-divider::after {
      content: "";
      flex: 1;
      border-top: 1px solid hsl(var(--foreground) / 0.18);
