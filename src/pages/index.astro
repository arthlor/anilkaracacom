    .portfolio-home__process-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 28px;
    }

    .portfolio-home__process-card {
      display: grid;
      gap: 22px;
      padding: 28px;
      border: 1px solid hsl(var(--foreground) / 0.1);
      background: hsl(var(--foreground) / 0.025);
    }

    .portfolio-home__process-number {
      font-size: 2.9rem;
      font-weight: 700;
      line-height: 1;
      color: hsl(var(--foreground));
    }

    .portfolio-home__clients-band {
      overflow: hidden;
      padding: 8px 0 0;
