    .portfolio-home__skills-copy {
      padding-top: 44px;
    }

    .portfolio-home__skills-copy p {
      margin: 0;
      font-size: 1.14rem;
      line-height: 1.85;
      color: hsl(var(--foreground) / 0.86);
    }

    .portfolio-home__positioning-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(320px, 420px);
      gap: 54px;
      align-items: start;
    }

    .portfolio-home__positioning-copy {
      margin-top: 24px;
      max-width: 720px;
    }

    .portfolio-home__positioning-copy h2 {
      margin: 0;
      font-size: clamp(2.2rem, 4.4vw, 4rem);
      line-height: 0.98;
      letter-spacing: -0.05em;
      color: hsl(var(--foreground));
    }

    .portfolio-home__positioning-copy p {
      margin: 22px 0 0;
      font-size: 1.08rem;
      line-height: 1.85;
      color: hsl(var(--foreground) / 0.76);
    }

    .portfolio-home__positioning-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
      margin-top: 34px;
    }

    .portfolio-home__positioning-notes {
      display: grid;
      gap: 0;
      padding-top: 44px;
    }

    .portfolio-home__positioning-note {
      display: grid;
      gap: 16px;
      padding: 20px 0;
      border-bottom: 1px solid hsl(var(--foreground) / 0.14);
    }

    .portfolio-home__positioning-note span {
      font-size: 0.82rem;
      font-weight: 700;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--premium-accent);
    }

    .portfolio-home__positioning-note p {
      margin: 0;
      font-size: 0.98rem;
      line-height: 1.75;
      color: hsl(var(--foreground) / 0.76);
    }

    .portfolio-home__button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      margin-top: 28px;
      min-height: 52px;
      border: 0;
      border-radius: 999px;
      background: hsl(var(--primary));
      color: hsl(var(--primary-foreground));
      padding: 12px 28px;
      font-size: 0.84rem;
      font-weight: 700;
      letter-spacing: 0.03em;
      text-transform: none;
      box-shadow: 0 14px 34px rgba(46, 204, 113, 0.25);
      transition:
        transform 180ms ease,
        box-shadow 180ms ease,
        filter 180ms ease;
    }

    .portfolio-home__button:hover {
      filter: brightness(1.08);
      transform: translateY(-1px);
      box-shadow: 0 18px 38px rgba(46, 204, 113, 0.35);
    }

    .portfolio-home__button--ghost {
      border: 1px solid hsl(var(--foreground) / 0.14);
      background: hsl(var(--foreground) / 0.04);
      color: hsl(var(--foreground));
      box-shadow: none;
    }

    .portfolio-home__button--ghost:hover {
      color: var(--premium-accent);
      filter: none;
      box-shadow: none;
      border-color: rgba(46, 204, 113, 0.4);
    }

    .portfolio-home__stats-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 40px;
      margin-top: 64px;
    }

    .portfolio-home__stat {
      padding-bottom: 18px;
      border-bottom: 1px solid hsl(var(--foreground) / 0.14);
    }

    .portfolio-home__stat-value {
      font-size: clamp(2.2rem, 4vw, 4rem);
      font-weight: 700;
      line-height: 1;
      color: hsl(var(--foreground));
    }

    .portfolio-home__stat p {
      margin: 14px 0 0;
      max-width: 340px;
      font-size: 0.95rem;
      line-height: 1.7;
      color: var(--premium-accent);
    }

    .portfolio-home__work-grid {
      display: grid;
      grid-template-columns: repeat(12, 1fr);
      gap: 20px;
      margin-top: 32px;
    }

    .portfolio-home__work-card {
      position: relative;
      display: flex;
      flex-direction: column;
      background: hsl(var(--card));
      border: 1px solid hsl(var(--border));
      border-radius: 28px;
      overflow: hidden;
      text-decoration: none;
      transition:
        border-color 0.4s ease,
        background-color 0.4s ease,
        transform 0.4s cubic-bezier(0.23, 1, 0.32, 1);
      isolation: isolate;
    }

    .portfolio-home__work-card:hover {
      border-color: rgba(122, 242, 152, 0.3);
      background: hsl(var(--muted) / 0.72);
      transform: translateY(-4px);
    }

    /* Bento Spans - Now 3-column grid */
    .portfolio-home__work-card--1 {
      grid-column: span 4;
      grid-row: span 1;
    }
    .portfolio-home__work-card--2 {
      grid-column: span 4;
      grid-row: span 1;
    }
    .portfolio-home__work-card--3 {
      grid-column: span 4;
      grid-row: span 1;
    }
    .portfolio-home__work-card--4 {
      grid-column: span 4;
      grid-row: span 1;
    }
    .portfolio-home__work-card--5 {
      grid-column: span 4;
      grid-row: span 1;
    }
    .portfolio-home__work-card--6 {
      grid-column: span 4;
      grid-row: span 1;
    }

    .portfolio-home__work-glow {
      position: absolute;
      inset: 0;
      background: radial-gradient(
        circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
        rgba(122, 242, 152, 0.15),
        transparent 40%
      );
      opacity: 0;
      transition: opacity 0.4s ease;
      pointer-events: none;
      z-index: 1;
    }

    .portfolio-home__work-card:hover .portfolio-home__work-glow {
      opacity: 1;
    }

    .portfolio-home__work-image-frame {
      position: relative;
      overflow: hidden;
      background: hsl(var(--muted));
      flex: 1;
      aspect-ratio: auto;
    }

    .portfolio-home__work-card--1 .portfolio-home__work-image-frame {
      aspect-ratio: 16 / 10;
    }
    .portfolio-home__work-card--2 .portfolio-home__work-image-frame {
      aspect-ratio: 16 / 10;
    }
    .portfolio-home__work-card--3 .portfolio-home__work-image-frame {
      aspect-ratio: 16 / 10;
    }
    .portfolio-home__work-card--4 .portfolio-home__work-image-frame {
      aspect-ratio: 16 / 10;
    }

    .portfolio-home__work-image {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.8s cubic-bezier(0.23, 1, 0.32, 1);
    }

    .portfolio-home__work-image-frame--contain .portfolio-home__work-image {
      object-fit: contain;
      padding: 1.5rem;
      transform: scale(1.1);
    }

    .portfolio-home__work-card:hover
      .portfolio-home__work-image-frame--contain
      .portfolio-home__work-image {
      transform: scale(1.15);
    }

    .portfolio-home__work-card:hover .portfolio-home__work-image {
      transform: scale(1.05);
    }

    .portfolio-home__work-content {
      position: relative;
      padding: 16px;
      display: flex;
      flex-direction: column;
      gap: 8px;
      z-index: 2;
      border-top: 1px solid hsl(var(--border));
      background: hsl(var(--card));
      transition: background-color 0.4s ease;
    }

    .portfolio-home__work-card:hover .portfolio-home__work-content {
      background: hsl(var(--muted) / 0.72);
    }

    .portfolio-home__work-copy h3 {
      margin: 0;
      font-size: 1.15rem;
      font-weight: 700;
      color: hsl(var(--foreground));
      letter-spacing: -0.01em;
    }

    .portfolio-home__work-copy p {
      margin: 4px 0 0;
      font-size: 0.88rem;
      line-height: 1.4;
      color: hsl(var(--muted-foreground));
      max-width: 480px;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .portfolio-home__tag-row {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    .portfolio-home__tag-row span {
      display: inline-flex;
      align-items: center;
      padding: 4px 12px;
      border-radius: 999px;
      background: rgba(122, 242, 152, 0.1);
      border: 1px solid rgba(122, 242, 152, 0.15);
      color: var(--premium-accent);
      font-size: 0.75rem;
      font-weight: 600;
    }

    .portfolio-home__work-arrow {
      position: absolute;
      top: 24px;
      right: 24px;
      width: 42px;
      height: 42px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      background: rgba(122, 242, 152, 0.1);
      color: var(--premium-accent);
      opacity: 0;
      transform: translate(-10px, 10px);
      transition: all 0.4s cubic-bezier(0.23, 1, 0.32, 1);
      z-index: 3;
    }

    .portfolio-home__work-card:hover .portfolio-home__work-arrow {
      opacity: 1;
      transform: translate(0, 0);
    }

    .portfolio-home__work-arrow svg {
      width: 20px;
      height: 20px;
    }

    .portfolio-home__section--work .portfolio-home__section-cta {
      margin-top: 20px;
    }

    .portfolio-home__writing-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.25rem;
    }

    .portfolio-home__writing-card {
      display: flex;
      flex-direction: column;
      gap: 0;
      overflow: hidden;
      border: 1px solid hsl(var(--foreground) / 0.1);
      border-radius: 1.25rem;
      background: hsl(var(--foreground) / 0.025);
      text-decoration: none;
      color: inherit;
      transition:
        border-color 180ms ease,
        transform 180ms ease,
        background 180ms ease,
        box-shadow 180ms ease;
    }

    .portfolio-home__writing-card:hover {
      transform: translateY(-2px);
      border-color: rgba(122, 242, 152, 0.35);
      background: hsl(var(--foreground) / 0.045);
      box-shadow: 0 16px 36px hsl(var(--foreground) / 0.1);
    }

    .portfolio-home__writing-image {
      aspect-ratio: 16 / 10;
      overflow: hidden;
      border-bottom: 1px solid hsl(var(--foreground) / 0.08);
    }

    .portfolio-home__writing-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      filter: grayscale(100%);
      transition:
        transform 400ms ease,
        filter 400ms ease;
    }

    .portfolio-home__writing-card:hover .portfolio-home__writing-image img {
      transform: scale(1.03);
      filter: grayscale(90%);
    }

    .portfolio-home__writing-copy {
      padding: 1.25rem;
    }

    .portfolio-home__writing-meta {
      margin: 0 0 0.75rem;
      font-size: 0.72rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: hsl(var(--muted-foreground));
    }

    .portfolio-home__writing-copy h3 {
      margin: 0 0 0.75rem;
      font-size: 1.35rem;
      line-height: 1.25;
    }

    .portfolio-home__writing-copy p {
      margin: 0;
      font-size: 0.92rem;
      line-height: 1.65;
      color: hsl(var(--foreground) / 0.72);
    }

    .portfolio-home__work-image,
    .portfolio-home__article-image-frame img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 260ms ease;
