---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

import ArticleRow from "@components/ArticleRow.astro";
import JsonLd from "@components/JsonLd.astro";
import ProductCard from "@components/ProductCard.astro";
import PixelMe from "@components/pixel-me/PixelMe.astro";
import MainLayout from "@layouts/MainLayout.astro";
import { workplaces } from "@/data/portfolio";
import {
  arrangeProducts,
  isPublicEntryData,
  sortEntriesByDateDesc,
} from "@/lib/content";
import {
  buildPersonSchema,
  buildProductsSchema,
  buildWebsiteSchema,
  toJpg,
} from "@/lib/seo";
import { siteConfig } from "@/lib/site";
import portrait from "@/assets/images/anilkaraca-avatar.webp";

const [projects, articles] = await Promise.all([
  getCollection("projects", ({ data }) => isPublicEntryData(data)),
  getCollection("articles", ({ data }) => isPublicEntryData(data)),
]);

// Key art leads, then products with store screenshots, then the rest.
const products = arrangeProducts(projects);
const latest = sortEntriesByDateDesc(articles).slice(0, 5);

/* Wide wordmarks and stacked marks should carry the same visual weight. */
const logoHeight = ({ width, height }: { width: number; height: number }) =>
  Math.round(40 * (width / height) ** -0.4);

/* The strip loops by sliding half its length, so each half must outrun the viewport. */
const logoCopies = [0, 1, 2, 3];

// Structured data: who this is, the site, and what he has shipped.
const schema = {
  "@graph": [
    buildWebsiteSchema(),
    buildPersonSchema(await toJpg(portrait, 512)),
    buildProductsSchema(
      await Promise.all(
        products.map(async ({ entry }) => {
          const art = entry.data.heroImage ?? entry.data.cover;
          return { entry, image: art && (await toJpg(art, 512)) };
        }),
      ),
    ),
  ],
};
---

<MainLayout
  title={`${siteConfig.displayName} — Communications. Data. Development.`}
  exactTitle
  description="Anıl Karaca is a data journalist and developer in İzmir, Türkiye. He reports with data in English and Turkish, and builds iOS apps, a Chrome extension, and a game."
>
  <JsonLd schema={schema} />

  <section class="hero container" aria-labelledby="hero-title">
    <div class="hero__copy">
      <h1 id="hero-title" class="hero__title">
        <span data-hero-name>{siteConfig.displayName}.</span>
        <span class="hero__title-muted">Communications. Data. Development.</span>
      </h1>
    </div>
    <PixelMe class="hero__pixel" />
  </section>

  <section class="section container" aria-labelledby="products-title">
    <div class="section-head">
      <h2 id="products-title" class="t-headline">Products</h2>
      <a class="more" href="/projects">All projects</a>
    </div>

    <ul class="products" role="list">
      {
        products.map(({ entry, wide }) => (
          <li class:list={[wide && "products__wide"]}>
            <ProductCard entry={entry} />
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section container" aria-labelledby="logos-title">
    <div class="section-head">
      <h2 id="logos-title" class="t-headline">Worked with</h2>
      <a class="more" href="/cv">Full CV</a>
    </div>

    <div class="marquee">
      <div class="marquee__track">
        {
          logoCopies.map((copy) => (
            <ul
              class="marquee__group"
              role="list"
              aria-hidden={copy > 0 ? "true" : undefined}
            >
              {workplaces.map((workplace) => (
                <li>
                  <a
                    class="logo"
                    href={workplace.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    tabindex={copy > 0 ? -1 : undefined}
                  >
                    <Image
                      src={workplace.logo}
                      alt={copy > 0 ? "" : workplace.name}
                      height={logoHeight(workplace.logo) * 2}
                      loading="lazy"
                      style={`--logo-h: ${logoHeight(workplace.logo)}px`}
                    />
                  </a>
                </li>
              ))}
            </ul>
          ))
        }
      </div>
    </div>
  </section>

  {
    latest.length > 0 && (
      <section class="section container" aria-labelledby="latest-title">
        <div class="section-head">
          <h2 id="latest-title" class="t-headline">
            Latest writing
          </h2>
        </div>

        <ul class="latest" role="list">
          {latest.map((entry) => (
            <li>
              <ArticleRow entry={entry} />
            </li>
          ))}
        </ul>
      </section>
    )
  }
</MainLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: clamp(40px, 5vw, 72px);
    padding-block: clamp(56px, 8vw, 112px) clamp(56px, 6vw, 80px);
  }

  /* The character stands on the title's baseline; its caption hangs below. */
  .hero > :global(.hero__pixel) {
    margin-bottom: calc(-1 * var(--pm-below-floor));
  }

  /* The name leads; the line under it is set clearly smaller so it never
     competes for width. */
  .hero__title {
    display: grid;
    gap: clamp(12px, 1.4vw, 20px);
    font-size: clamp(3rem, 7.4vw, 6.5rem);
    line-height: 1;
    letter-spacing: -0.045em;
  }

  .hero__title-muted {
    /* Pulls the box up to the baseline the character stands on. */
    margin-bottom: -0.24em;
    font-size: clamp(1.1875rem, 1.9vw, 1.5rem);
    line-height: 1.2;
    letter-spacing: -0.018em;
    font-weight: 500;
    color: hsl(var(--muted-foreground));
  }

  .latest > li {
    border-top: 1px solid hsl(var(--border));
  }

  .products {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .products__wide {
    grid-column: 1 / -1;
  }

  .marquee {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
  }

  .marquee__track {
    display: flex;
    width: max-content;
    animation: marquee 48s linear infinite;
  }

  .marquee:hover .marquee__track,
  .marquee:focus-within .marquee__track {
    animation-play-state: paused;
  }

  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }

  .marquee__group {
    display: flex;
    align-items: center;
  }

  .logo {
    display: grid;
    place-items: center;
    height: 56px;
    padding-inline: clamp(24px, 3.5vw, 40px);
  }

  .logo img {
    display: block;
    width: auto;
    height: var(--logo-h);
    filter: grayscale(1);
    opacity: 0.55;
    transition: opacity 250ms ease;
  }

  :global(html.dark) .logo img {
    filter: grayscale(1) invert(1);
  }

  .logo:hover img,
  .logo:focus-visible img {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee {
      -webkit-mask-image: none;
      mask-image: none;
    }

    .marquee__track {
      width: auto;
      animation: none;
    }

    .marquee__group {
      flex-wrap: wrap;
      margin-inline: calc(clamp(24px, 3.5vw, 40px) * -1);
    }

    .marquee__group[aria-hidden] {
      display: none;
    }
  }

  @media (max-width: 899px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      gap: 12px;
    }

    .hero > :global(.hero__pixel) {
      justify-self: start;
      margin-bottom: 0;
    }

    .hero__title-muted {
      margin-bottom: 0;
    }

    .products {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 599px) {
    .products {
      gap: 12px;
    }
  }
</style>
