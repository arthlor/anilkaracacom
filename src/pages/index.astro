  <script>
    // --- Hero Image Interactive Effects ---
    const heroContainer = document.getElementById("hero-image-container");
    const heroImage = document.getElementById("hero-portrait");
    const heroGlow = document.getElementById("hero-magnetic-glow");

    if (heroContainer && heroImage && heroGlow) {
      window.addEventListener("mousemove", (e) => {
        const rect = heroContainer.getBoundingClientRect();
        const centerX = rect.left + rect.width / 2;
        const centerY = rect.top + rect.height / 2;

        // Calculate normalized mouse position relative to container center
        const mouseX = e.clientX - centerX;
        const mouseY = e.clientY - centerY;

        // 3D Tilt Effect
        const tiltX = (mouseY / (window.innerHeight / 2)) * -6;
        const tiltY = (mouseX / (window.innerWidth / 2)) * 6;

        heroContainer.style.transform = `rotateX(${tiltX}deg) rotateY(${tiltY}deg)`;

        // Magnetic Glow Position
        // Calculate offset within the container for the glow
        const glowX = ((e.clientX - rect.left) / rect.width) * 100;
        const glowY = ((e.clientY - rect.top) / rect.height) * 100;

        heroGlow.style.setProperty("--glow-x", `${glowX}%`);
        heroGlow.style.setProperty("--glow-y", `${glowY}%`);
      });

      // Reset on mouse leave (if we were tracking container only, but we use window)
      // Since we use window, it feels more atmospheric.
    }

    // Project card hover interactive effects with scroll-tracking to prevent stalling
    const cards = document.querySelectorAll(".portfolio-home__work-card");
    let lastClientX = 0;
    let lastClientY = 0;
    let hoveredCard: HTMLElement | null = null;

    function updateCardGlow(
      card: HTMLElement,
      clientX: number,
      clientY: number,
    ) {
      const rect = card.getBoundingClientRect();
      const x = clientX - rect.left;
      const y = clientY - rect.top;
      card.style.setProperty("--mouse-x", `${x}px`);
      card.style.setProperty("--mouse-y", `${y}px`);
    }

    cards.forEach((card) => {
      if (!(card instanceof HTMLElement)) return;

      card.addEventListener("mouseenter", () => {
        hoveredCard = card;
      });

      card.addEventListener("mouseleave", () => {
        if (hoveredCard === card) {
          hoveredCard = null;
        }
      });

      card.addEventListener("mousemove", (e) => {
        const mouseEvent = e as MouseEvent;
        lastClientX = mouseEvent.clientX;
        lastClientY = mouseEvent.clientY;
        hoveredCard = card;
        updateCardGlow(card, mouseEvent.clientX, mouseEvent.clientY);
      });
    });

    window.addEventListener(
      "scroll",
      () => {
        if (hoveredCard) {
          updateCardGlow(hoveredCard, lastClientX, lastClientY);
        }
      },
      { passive: true },
    );
  </script>
