---
import { getCollection } from 'astro:content';

import JsonLd from '../components/JsonLd.astro';
import { appProjects, credibilityHighlights, resumeLinks, workplaces } from '../data/portfolio';
import {
  getEntryHref,
  getEntrySummary,
  getEntryTags,
  sortEntriesByFeatureAndDate,
} from '../lib/content';
import { buildPersonSchema } from '../lib/seo';
import { navigationLinks, siteConfig, socialLinks } from '../lib/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import portrait from '../assets/images/anil-karaca.jpg'; // Keep for now if used elsewhere, but we'll use /images/anilkaraca.png for hero

const projects = await getCollection('projects', ({ data }) => data.published);
const featuredWork = sortEntriesByFeatureAndDate(projects).slice(0, 4);

const homeStats = [
  {
    value: '10+',
    label: 'Years across journalism, civic communication, and product work',
  },
  {
    value: `${workplaces.length}`,
    label: 'Newsrooms and civic institutions represented in the profile',
  },
  {
    value: `${appProjects.length}+`,
    label: 'Shipped iOS apps released as real products',
  },
] as const;

const homeMenuLinks = [
  { label: 'Projects', href: '/projects' },
  { label: 'About', href: '/about' },
  { label: 'Contact', href: '/contact' },
] as const;

const footerQuickLinks = navigationLinks.map((link) => ({
  href: link.href,
  label: link.label,
}));

const portfolioLinks = [
  { label: 'Resume', href: resumeLinks.master, external: false },
  { label: 'Articles', href: '/articles', external: false },
  { label: 'GitHub', href: siteConfig.githubUrl, external: true },
] as const;

const socialLinkMap = new Map(
  socialLinks.map((link) => [
    link.label === 'X (Twitter)' ? 'X' : link.label,
    {
      ...link,
      label: link.label === 'X (Twitter)' ? 'X' : link.label,
    },
  ]),
);

const footerSocialLinks = ['X', 'LinkedIn', 'GitHub', 'YouTube']
  .map((label) => socialLinkMap.get(label))
  .filter((link): link is NonNullable<(typeof socialLinks)[number]> => Boolean(link));

const repeatedWorkplaces = [...workplaces, ...workplaces];
const githubDisplay = siteConfig.githubUrl.replace(/^https?:\/\//, '').replace(/\/$/, '');
---

<BaseLayout
  title="Home"
  description="Framer-style homepage for Anil Karaca, blending data journalism, civic storytelling, mobile apps, and editorial product engineering."
>
  <JsonLd schema={buildPersonSchema()} />

  <div class="portfolio-home">
    <div class="portfolio-home__texture" aria-hidden="true"></div>

    <header class="portfolio-home__nav">
      <div class="portfolio-home__container portfolio-home__nav-inner">
        <a href="/" class="portfolio-home__brand">{siteConfig.personName.toUpperCase()}</a>

        <div class="portfolio-home__menu">
          <button
            id="home-menu-toggle"
            class="portfolio-home__menu-toggle"
            type="button"
            aria-expanded="false"
            aria-controls="home-menu"
          >
            <span>Menu</span>
            <span class="portfolio-home__menu-dot" aria-hidden="true"></span>
            <svg
              class="portfolio-home__menu-icon"
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.2"
              aria-hidden="true"
            >
              <path d="M4 6L8 2L12 6"></path>
              <path d="M4 10L8 14L12 10"></path>
            </svg>
          </button>

          <div id="home-menu" class="portfolio-home__menu-panel" data-open="false">
            {homeMenuLinks.map((link) => (
              <a href={link.href} class="portfolio-home__menu-link">
                {link.label}
              </a>
            ))}
          </div>
        </div>
      </div>
    </header>

    <section class="portfolio-home__hero">
      <div class="portfolio-home__container portfolio-home__hero-grid">
        <div class="portfolio-home__hero-copy">
          <div class="portfolio-home__eyebrow">
            <span>Hey,</span>
            <span class="portfolio-home__wave" aria-hidden="true">👋</span>
            <span>I&apos;m a Data Journalist &amp; Product Developer</span>
          </div>

          <h1>ANIL KARACA</h1>
        </div>

        <div class="portfolio-home__hero-image-wrap" id="hero-image-container">
          <div class="portfolio-home__hero-glow" id="hero-magnetic-glow" aria-hidden="true"></div>
          
          <div class="portfolio-home__hero-particles" aria-hidden="true">
            <div class="portfolio-home__particle" style="--top: 15%; --left: 10%; --delay: 0s; --size: 4px;"></div>
            <div class="portfolio-home__particle" style="--top: 45%; --left: 90%; --delay: 1s; --size: 3px;"></div>
            <div class="portfolio-home__particle" style="--top: 75%; --left: 15%; --delay: 2s; --size: 5px;"></div>
            <div class="portfolio-home__particle" style="--top: 25%; --left: 85%; --delay: 3.5s; --size: 2px;"></div>
          </div>

          <img
            src="/images/anilkaraca.png"
            alt="Portrait of Anil Karaca"
            class="portfolio-home__hero-image"
            width="800"
            height="1000"
            loading="eager"
            id="hero-portrait"
          />
        </div>

        <div class="portfolio-home__hero-side">
          <p class="portfolio-home__hero-summary">
            Building at the intersection of public-interest reporting, civic analysis, and high-performance digital products.
          </p>

          <div class="portfolio-home__hero-socials">
            {footerSocialLinks.map((link) => (
              <a href={link.href} target="_blank" rel="noopener noreferrer">
                <span aria-hidden="true">/</span>
                {link.label}
              </a>
            ))}
          </div>
        </div>
        <div class="portfolio-home__hero-contacts">
          <div class="portfolio-home__contact-row">
            <span class="portfolio-home__contact-key">E</span>
            <a href={`mailto:${siteConfig.contactEmail}`}>{siteConfig.contactEmail}</a>
          </div>
          <div class="portfolio-home__contact-row">
            <span class="portfolio-home__contact-key">CV</span>
            <a href={resumeLinks.master}>Get Resume</a>
          </div>
        </div>
      </div>
    </section>

    <section class="portfolio-home__marquee-section">
      <div class="portfolio-home__section-shell" id="positioning">
        <div class="portfolio-home__container">
          <div class="portfolio-home__positioning-grid">
            <div>
              <p class="portfolio-home__section-kicker">// Positioning</p>

              <div class="portfolio-home__positioning-copy">
                <h2>Reporting, product thinking, and delivery in one profile.</h2>
                <p>
                  The strongest work here comes from overlap, not separate lanes: journalism for framing the question,
                  analysis for making it legible, and product execution for shipping something people can actually use.
                </p>
              </div>

              <div class="portfolio-home__positioning-actions">
                <a href="/projects" class="portfolio-home__button">
                  See All Work
                </a>
                <a href="/about" class="portfolio-home__button portfolio-home__button--ghost">
                  Full Profile
                </a>
              </div>
            </div>

            <div class="portfolio-home__positioning-notes">
              {credibilityHighlights.map((highlight, index) => (
                <article class="portfolio-home__positioning-note">
                  <span>{String(index + 1).padStart(2, '0')}</span>
                  <p>{highlight}</p>
                </article>
              ))}
            </div>
          </div>

          <div class="portfolio-home__stats-grid">
            {homeStats.map((stat) => (
              <div class="portfolio-home__stat">
                <div class="portfolio-home__stat-value">{stat.value}</div>
                <p>{stat.label}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="portfolio-home__section portfolio-home__section--work" id="proof">
      <div class="portfolio-home__container">
        <div class="portfolio-home__section-head portfolio-home__section-head--split">
          <div>
            <p class="portfolio-home__section-kicker">// Selected Proof</p>
          </div>

          <h2>Selected reporting, apps, and interactive systems</h2>

          <div class="portfolio-home__section-mark" aria-hidden="true">
            <span>&lt;/</span>
            <span>&gt;</span>
          </div>
        </div>

        <div class="portfolio-home__section-divider" aria-hidden="true">
          <span>&lt;/</span>
        </div>

        <div class="portfolio-home__work-grid">
          {featuredWork.map((entry) => (
            <a href={getEntryHref(entry)} class="portfolio-home__work-card">
              <div class="portfolio-home__work-image-frame">
                <img
                  src={entry.data.heroImage || portrait.src}
                  alt={entry.data.title}
                  class="portfolio-home__work-image"
                  width="1120"
                  height="820"
                  loading="lazy"
                />
              </div>

              <div class="portfolio-home__work-copy">
                <h3>{entry.data.title}</h3>
                <p>{getEntrySummary(entry)}</p>
              </div>

              <div class="portfolio-home__tag-row">
                {getEntryTags(entry)
                  .slice(0, 3)
                  .map((tag) => (
                    <span>{tag}</span>
                  ))}
              </div>
            </a>
          ))}
        </div>

        <div class="portfolio-home__section-cta">
          <a href="/projects" class="portfolio-home__button">
            Open Projects
          </a>
        </div>
      </div>
    </section>

    <section class="portfolio-home__section portfolio-home__section--proof-band">
      <div class="portfolio-home__container">
        <div class="portfolio-home__section-head portfolio-home__section-head--split">
          <div>
            <p class="portfolio-home__section-kicker">// Experience</p>
          </div>

          <h2>Newsrooms, civic institutions, and self-directed product work behind the portfolio</h2>

          <div class="portfolio-home__section-mark" aria-hidden="true">
            <span>&lt;/</span>
            <span>&gt;</span>
          </div>
        </div>

        <div class="portfolio-home__section-divider" aria-hidden="true">
          <span>&lt;/</span>
        </div>

        <div class="portfolio-home__clients-band">
          <div class="portfolio-home__clients-track">
            {repeatedWorkplaces.map((workplace, index) => (
              <a
                href={workplace.url}
                target="_blank"
                rel="noopener noreferrer"
                class="portfolio-home__client-logo"
              >
                <img
                  src={workplace.logo}
                  alt={workplace.name}
                  width="240"
                  height="96"
                  loading={index < workplaces.length ? 'eager' : 'lazy'}
                />
              </a>
            ))}
          </div>
        </div>
        <div class="portfolio-home__section-cta">
          <a href="/about" class="portfolio-home__button portfolio-home__button--ghost">
            Open About
          </a>
        </div>
      </div>
    </section>

    <footer class="portfolio-home__footer">
      <div class="portfolio-home__container">
        <div class="portfolio-home__footer-cta">
          <div class="portfolio-home__footer-cta-copy">
            <h2>Ready to take your</h2>

            <div class="portfolio-home__footer-cta-line">
              <h2>story or product</h2>
              <a href="/contact" class="portfolio-home__cta-orb">
                Contact
              </a>
            </div>

            <h2>to the next level?</h2>
          </div>
        </div>

        <div class="portfolio-home__section-divider portfolio-home__section-divider--footer" aria-hidden="true">
          <span>&lt;/</span>
        </div>

        <div class="portfolio-home__footer-grid">
          <div>
            <p class="portfolio-home__footer-title">Quick links</p>
            <div class="portfolio-home__footer-links">
              {footerQuickLinks.map((link) => (
                <a href={link.href}>{link.label}</a>
              ))}
            </div>
          </div>

          <div>
            <p class="portfolio-home__footer-title">Portfolio</p>
            <div class="portfolio-home__footer-links">
              {portfolioLinks.map((link) => (
                <a
                  href={link.href}
                  target={link.external ? '_blank' : undefined}
                  rel={link.external ? 'noopener noreferrer' : undefined}
                >
                  {link.label}
                </a>
              ))}
            </div>
          </div>

          <div>
            <p class="portfolio-home__footer-title">Social links</p>
            <div class="portfolio-home__footer-links">
              {footerSocialLinks.map((link) => (
                <a href={link.href} target="_blank" rel="noopener noreferrer">
                  {link.label}
                </a>
              ))}
            </div>
          </div>
        </div>

        <div class="portfolio-home__footer-bottom">
          <div class="portfolio-home__footer-contact">
            <a href={`mailto:${siteConfig.contactEmail}`}>{siteConfig.contactEmail}</a>
            <a href={siteConfig.githubUrl} target="_blank" rel="noopener noreferrer">
              {githubDisplay}
            </a>
          </div>

          <div class="portfolio-home__footer-links portfolio-home__footer-links--inline">
            <a href="/projects">Projects</a>
            <a href="/about">About</a>
            <a href="/contact">Contact</a>
            <a href={resumeLinks.master}>Resume</a>
          </div>
        </div>
      </div>
    </footer>
  </div>

  <style>
    .portfolio-home {
      position: relative;
      overflow: clip;
      background: #111111;
      color: #f3f1eb;
      isolation: isolate;
    }

    .portfolio-home a {
      color: inherit;
      text-decoration: none;
    }

    .portfolio-home__texture {
      position: fixed;
      inset: 0;
      z-index: -1;
      pointer-events: none;
      background:
        radial-gradient(circle at 50% 16%, rgba(122, 242, 152, 0.2), transparent 16%),
        radial-gradient(circle at 50% 84%, rgba(122, 242, 152, 0.16), transparent 20%),
        repeating-linear-gradient(
          90deg,
          rgba(255, 255, 255, 0.015) 0,
          rgba(255, 255, 255, 0.015) 1px,
          transparent 1px,
          transparent 64px
        ),
        linear-gradient(180deg, #111111 0%, #080808 100%);
    }

    .portfolio-home__container {
      position: relative;
      width: min(100% - 40px, 1320px);
      margin-inline: auto;
    }

    .portfolio-home__nav {
      position: fixed;
      inset: 0 0 auto;
      z-index: 40;
      padding-top: 10px;
      pointer-events: none;
    }

    .portfolio-home__nav-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
      pointer-events: auto;
    }

    .portfolio-home__brand {
      font-size: 0.9rem;
      font-weight: 600;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: rgba(255, 255, 255, 0.96);
    }

    .portfolio-home__menu {
      position: relative;
    }

    .portfolio-home__menu-toggle {
      display: inline-flex;
      align-items: center;
      gap: 12px;
      border: 0;
      border-radius: 999px;
      background: #f7f4ef;
      color: #111111;
      padding: 13px 16px 13px 18px;
      font-size: 0.82rem;
      line-height: 1;
      cursor: pointer;
      box-shadow: 0 16px 40px rgba(0, 0, 0, 0.28);
    }

    .portfolio-home__menu-dot {
      width: 10px;
      height: 10px;
      border-radius: 999px;
      background: #8517ff;
      transform: scale(0);
      transition: transform 180ms ease;
    }

    .portfolio-home__menu-icon {
      width: 16px;
      height: 16px;
    }

    .portfolio-home__menu-toggle[aria-expanded='true'] .portfolio-home__menu-dot {
      transform: scale(1);
    }

    .portfolio-home__menu-panel {
      position: absolute;
      top: calc(100% + 10px);
      right: 0;
      min-width: 170px;
      display: grid;
      gap: 6px;
      padding: 14px 12px;
      border-radius: 14px;
      background: #f7f4ef;
      color: #111111;
      box-shadow: 0 24px 48px rgba(0, 0, 0, 0.28);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-8px);
      transition:
        opacity 180ms ease,
        transform 180ms ease,
        visibility 180ms ease;
    }

    .portfolio-home__menu-panel[data-open='true'] {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }

    .portfolio-home__menu-link {
      display: block;
      border-radius: 10px;
      padding: 8px 10px;
      font-size: 0.88rem;
      font-weight: 600;
      transition: background-color 180ms ease;
    }

    .portfolio-home__menu-link:hover {
      background: rgba(17, 17, 17, 0.08);
    }

    .portfolio-home__hero {
      position: relative;
      padding: 194px 0 96px;
      background: #191818;
      perspective: 1200px; /* Enable 3D depth */
    }

    .portfolio-home__hero-grid {
      position: relative;
      display: grid;
      grid-template-columns: 1fr 1fr;
      grid-template-areas:
        'copy copy'
        'side contacts';
      gap: 64px 0;
      min-height: min(1080px, calc(100svh + 100px));
      padding-bottom: 240px;
      align-content: end;
    }

    .portfolio-home__hero-copy {
      grid-area: copy;
      max-width: 1120px;
    }

    .portfolio-home__eyebrow {
      display: inline-flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 8px;
      font-size: clamp(1rem, 1.4vw, 1.9rem);
      font-weight: 600;
      color: rgba(255, 255, 255, 0.94);
    }

    .portfolio-home__wave {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      transform-origin: 70% 70%;
      animation: portfolio-home-wave 2.2s ease-in-out infinite;
    }

    .portfolio-home__hero h1 {
      margin: 30px 0 0;
      font-size: clamp(5rem, 12.8vw, 11.6rem);
      line-height: 0.9;
      letter-spacing: -0.06em;
      color: #7af298;
      text-transform: uppercase;
    }

    .portfolio-home__hero-side {
      grid-area: side;
      align-self: end;
      display: flex;
      flex-direction: column;
      gap: 32px;
      max-width: 480px;
    }

    .portfolio-home__hero-summary {
      margin: 0;
      font-size: 1.18rem;
      line-height: 1.85;
      color: rgba(255, 255, 255, 0.84);
    }

    .portfolio-home__hero-socials {
      display: flex;
      flex-wrap: wrap;
      gap: 16px;
      color: rgba(255, 255, 255, 0.82);
    }

    .portfolio-home__hero-socials a {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      font-size: 0.94rem;
      transition: color 180ms ease;
    }

    .portfolio-home__hero-socials a:hover {
      color: #7af298;
    }

    .portfolio-home__hero-contacts {
      grid-area: contacts;
      align-self: end;
      display: flex;
      flex-direction: column;
      gap: 12px;
      max-width: 320px;
    }

    .portfolio-home__contact-row {
      display: flex;
      align-items: center;
      gap: 14px;
      color: rgba(255, 255, 255, 0.92);
    }

    .portfolio-home__contact-row a {
      font-size: 1rem;
      color: rgba(255, 255, 255, 0.92);
      transition: color 180ms ease;
    }

    .portfolio-home__contact-row a:hover {
      color: #7af298;
    }

    .portfolio-home__contact-key {
      min-width: 30px;
      font-size: 0.76rem;
      font-weight: 700;
      letter-spacing: 0.2em;
      color: rgba(255, 255, 255, 0.48);
      text-transform: uppercase;
    }

    .portfolio-home__hero-image-wrap {
      position: absolute;
      left: 50%;
      bottom: -20px;
      width: min(90vw, 720px);
      margin-top: 0;
      transform: translateX(-50%);
      transform-style: preserve-3d;
      transition: transform 0.1s ease-out;
      will-change: transform;
      pointer-events: none; /* Let clicks pass through to socials/links if overlapping */
    }

    .portfolio-home__hero-glow {
      position: absolute;
      top: var(--glow-y, 50%);
      left: var(--glow-x, 50%);
      width: 400px;
      height: 400px;
      border-radius: 999px;
      background: radial-gradient(circle, rgba(122, 242, 152, 0.45), transparent 70%);
      filter: blur(48px);
      transform: translate(-50%, -50%) scale(1.6);
      pointer-events: none;
      z-index: -1;
      opacity: 0.6;
      transition: opacity 0.4s ease;
    }

    .portfolio-home__hero-particles {
      position: absolute;
      inset: -10% -10%;
      pointer-events: none;
      z-index: 1;
    }

    .portfolio-home__particle {
      position: absolute;
      top: var(--top);
      left: var(--left);
      width: var(--size);
      height: var(--size);
      background: #7af298;
      border-radius: 50%;
      opacity: 0.3;
      filter: blur(1px);
      animation: hero-particle-drift 8s ease-in-out infinite alternate;
      animation-delay: var(--delay);
    }

    @keyframes hero-particle-drift {
      0% { transform: translate(0, 0); opacity: 0.2; }
      100% { transform: translate(30px, -40px); opacity: 0.5; }
    }

    .portfolio-home__hero-image {
      position: relative;
      display: block;
      width: 100%;
      height: auto;
      object-fit: cover;
      filter: saturate(0.9) contrast(1.1) brightness(1.02);
      transition: filter 0.5s ease;
      /* Refined organic mask for the new portrait */
      mask-image: 
        radial-gradient(circle at 50% 35%, black 45%, transparent 80%),
        linear-gradient(to bottom, black 65%, transparent 100%);
      -webkit-mask-image: 
        radial-gradient(circle at 50% 35%, black 45%, transparent 80%),
        linear-gradient(to bottom, black 65%, transparent 100%);
      mask-composite: intersect;
      -webkit-mask-composite: source-in;
      pointer-events: auto; /* Re-enable for tilt logic */
    }

    .portfolio-home__hero-image-wrap:hover .portfolio-home__hero-image {
      filter: saturate(1.1) contrast(1.05) brightness(1.1);
    }

    .portfolio-home__hero-image-wrap:hover .portfolio-home__hero-glow {
      opacity: 0.9;
    }

    .portfolio-home__marquee-section {
      position: relative;
    }

    .portfolio-home__section-shell,
    .portfolio-home__section {
      padding: 118px 0;
    }

    .portfolio-home__section--deep {
      background: #111111;
    }

    .portfolio-home__section--soft {
      background: #191818;
    }

    .portfolio-home__section--work {
      padding: 92px 0 96px;
    }

    .portfolio-home__section-head {
      display: flex;
      justify-content: space-between;
      align-items: end;
      gap: 28px;
      margin-bottom: 24px;
    }

    .portfolio-home__section-kicker {
      margin: 0 0 18px;
      font-size: 0.88rem;
      letter-spacing: 0.08em;
      color: #7af298;
    }

    .portfolio-home__section-head--split {
      display: grid;
      grid-template-columns: minmax(180px, 1fr) minmax(0, 640px) auto;
      align-items: end;
      gap: 24px;
    }

    .portfolio-home__section-head--split h2 {
      text-align: left;
      justify-self: start;
    }

    .portfolio-home__section-head h2 {
      margin: 0;
      max-width: 760px;
      font-size: clamp(2.25rem, 4.8vw, 4rem);
      line-height: 1.08;
      letter-spacing: -0.05em;
      color: #f5f2eb;
    }

    .portfolio-home__section-mark {
      display: flex;
      gap: 12px;
      align-items: center;
      font-size: 1.35rem;
      color: rgba(255, 255, 255, 0.76);
    }

    .portfolio-home__section-divider {
      display: flex;
      align-items: center;
      gap: 14px;
      margin-bottom: 40px;
