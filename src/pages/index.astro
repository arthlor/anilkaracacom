      mask-image: linear-gradient(
        to right,
        transparent,
        black 10%,
        black 90%,
        transparent
      );
    }

    .portfolio-home__clients-track {
      display: flex;
      align-items: center;
      gap: 68px;
      width: max-content;
      white-space: nowrap;
      animation: portfolio-home-marquee 34s linear infinite;
