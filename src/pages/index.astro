---
import { getCollection } from 'astro:content';

import JsonLd from '../components/JsonLd.astro';
import { appProjects, credibilityHighlights, resumeLinks, workplaces } from '../data/portfolio';
import {
  getEntryHref,
  getEntrySummary,
  getEntryTags,
  sortEntriesByFeatureAndDate,
} from '../lib/content';
import { buildPersonSchema } from '../lib/seo';
import { siteConfig, socialLinks } from '../lib/site';
import MainLayout from '../layouts/MainLayout.astro';
import portrait from '../assets/images/anil-karaca.jpg'; // Keep for now if used elsewhere, but we'll use /images/anilkaraca.png for hero

const projects = await getCollection('projects', ({ data }) => data.published);
const featuredWork = sortEntriesByFeatureAndDate(projects).slice(0, 4);

const homeStats = [
  {
    value: '10+',
    label: 'Years across journalism, civic communication, and product work',
  },
  {
    value: `${workplaces.length}`,
    label: 'Newsrooms and civic institutions.',
  },
  {
    value: `${appProjects.length}+`,
    label: 'Shipped iOS apps released as real products',
  },
] as const;



const socialLinkMap = new Map(
  socialLinks.map((link) => [
    link.label === 'X (Twitter)' ? 'X' : link.label,
    {
      ...link,
      label: link.label === 'X (Twitter)' ? 'X' : link.label,
    },
  ]),
);

const footerSocialLinks = ['X', 'LinkedIn', 'GitHub', 'YouTube']
  .map((label) => socialLinkMap.get(label))
  .filter((link): link is NonNullable<(typeof socialLinks)[number]> => Boolean(link));

const repeatedWorkplaces = [...workplaces, ...workplaces];
---

<MainLayout
  title="Home"
  description="Framer-style homepage for Anil Karaca, blending data journalism, civic storytelling, mobile apps, and editorial product engineering."
>
  <JsonLd schema={buildPersonSchema()} />

  <div class="portfolio-home">


    <section class="portfolio-home__hero">
      <!-- Hero-wide sparkle layer -->
      <div class="portfolio-home__hero-sparkles" aria-hidden="true">
        <div class="portfolio-home__sparkle portfolio-home__sparkle--float" style="--sx: 6%; --sy: 18%; --sd: 0s; --ss: 3px;"></div>
        <div class="portfolio-home__sparkle portfolio-home__sparkle--twinkle" style="--sx: 14%; --sy: 72%; --sd: 1.4s; --ss: 2px;"></div>
        <div class="portfolio-home__sparkle portfolio-home__sparkle--drift" style="--sx: 22%; --sy: 38%; --sd: 0.6s; --ss: 4px;"></div>
        <div class="portfolio-home__sparkle portfolio-home__sparkle--float portfolio-home__sparkle--accent" style="--sx: 32%; --sy: 85%; --sd: 2.8s; --ss: 3px;"></div>
        <div class="portfolio-home__sparkle portfolio-home__sparkle--twinkle" style="--sx: 40%; --sy: 12%; --sd: 3.2s; --ss: 2px;"></div>
        <div class="portfolio-home__sparkle portfolio-home__sparkle--drift portfolio-home__sparkle--accent" style="--sx: 48%; --sy: 55%; --sd: 1.0s; --ss: 5px;"></div>
        <div class="portfolio-home__sparkle portfolio-home__sparkle--float" style="--sx: 58%; --sy: 28%; --sd: 4.0s; --ss: 2px;"></div>
        <div class="portfolio-home__sparkle portfolio-home__sparkle--twinkle portfolio-home__sparkle--accent" style="--sx: 65%; --sy: 78%; --sd: 0.3s; --ss: 3px;"></div>
        <div class="portfolio-home__sparkle portfolio-home__sparkle--drift" style="--sx: 72%; --sy: 15%; --sd: 2.2s; --ss: 4px;"></div>
        <div class="portfolio-home__sparkle portfolio-home__sparkle--float" style="--sx: 78%; --sy: 62%; --sd: 3.6s; --ss: 2px;"></div>
        <div class="portfolio-home__sparkle portfolio-home__sparkle--twinkle" style="--sx: 85%; --sy: 42%; --sd: 1.8s; --ss: 3px;"></div>
        <div class="portfolio-home__sparkle portfolio-home__sparkle--drift portfolio-home__sparkle--accent" style="--sx: 90%; --sy: 90%; --sd: 0.8s; --ss: 4px;"></div>
        <div class="portfolio-home__sparkle portfolio-home__sparkle--float" style="--sx: 95%; --sy: 22%; --sd: 2.5s; --ss: 2px;"></div>
        <div class="portfolio-home__sparkle portfolio-home__sparkle--twinkle portfolio-home__sparkle--accent" style="--sx: 10%; --sy: 50%; --sd: 4.4s; --ss: 3px;"></div>
        <div class="portfolio-home__sparkle portfolio-home__sparkle--drift" style="--sx: 52%; --sy: 8%; --sd: 3.0s; --ss: 2px;"></div>
        <div class="portfolio-home__sparkle portfolio-home__sparkle--float portfolio-home__sparkle--accent" style="--sx: 28%; --sy: 30%; --sd: 1.6s; --ss: 5px;"></div>
      </div>

      <div class="portfolio-home__container portfolio-home__hero-grid">
        <!-- Left column: all text -->
        <div class="portfolio-home__hero-copy">
          <div class="portfolio-home__eyebrow">
            <span>Data Journalism x Product Engineering</span>
          </div>
          <h1>ANIL<br/>KARACA</h1>
        </div>

        <div class="portfolio-home__hero-side">
          <p class="portfolio-home__hero-summary">
            Crafting the digital systems that make public-interest reporting legible, interactive, and impactful.
          </p>

          <div class="portfolio-home__hero-meta">
            <div class="portfolio-home__hero-socials">
              {footerSocialLinks.map((link) => (
                <a href={link.href} target="_blank" rel="noopener noreferrer">
                  <span aria-hidden="true">/</span>
                  {link.label}
                </a>
              ))}
            </div>

            <div class="portfolio-home__hero-contacts">
              <a href={`mailto:${siteConfig.contactEmail}`}>{siteConfig.contactEmail}</a>
              <span class="portfolio-home__contact-sep" aria-hidden="true">·</span>
              <a href={resumeLinks.master}>Resume ↓</a>
            </div>
          </div>
        </div>

        <!-- Right column: portrait -->
        <div class="portfolio-home__hero-image-wrap" id="hero-image-container">
          <div class="portfolio-home__hero-glow" id="hero-magnetic-glow" aria-hidden="true"></div>

          <div class="portfolio-home__hero-particles" aria-hidden="true">
            <div class="portfolio-home__particle" style="--top: 12%; --left: 8%; --delay: 0s; --size: 4px;"></div>
            <div class="portfolio-home__particle" style="--top: 50%; --left: 92%; --delay: 1.2s; --size: 3px;"></div>
            <div class="portfolio-home__particle" style="--top: 80%; --left: 12%; --delay: 2.4s; --size: 5px;"></div>
            <div class="portfolio-home__particle" style="--top: 20%; --left: 88%; --delay: 3.6s; --size: 2px;"></div>
          </div>

          <img
            src="/images/anilkaraca.png"
            alt="Portrait of Anil Karaca"
            class="portfolio-home__hero-image"
            width="800"
            height="1000"
            loading="eager"
            id="hero-portrait"
          />
        </div>
      </div>
    </section>

    <section class="portfolio-home__marquee-section">
      <div class="portfolio-home__section-shell" id="positioning">
        <div class="portfolio-home__container">
          <div class="portfolio-home__positioning-grid">
            <div>
              <p class="portfolio-home__section-kicker">// Positioning</p>

              <div class="portfolio-home__positioning-copy">
                <h2>Where reporting meets product precision.</h2>
                <p>
                  High-impact work lives at the overlap: journalism for framing the right questions,
                  analysis for making complexity legible, and engineering for shipping products people can use.
                </p>
              </div>

              <div class="portfolio-home__positioning-actions">
                <a href="/projects" class="portfolio-home__button">
                  Explore Work
                </a>
                <a href="/about" class="portfolio-home__button portfolio-home__button--ghost">
                  Full Profile
                </a>
              </div>
            </div>

            <div class="portfolio-home__positioning-notes">
              {credibilityHighlights.map((highlight, index) => (
                <article class="portfolio-home__positioning-note">
                  <span>{String(index + 1).padStart(2, '0')}</span>
                  <p>{highlight}</p>
                </article>
              ))}
            </div>
          </div>

          <div class="portfolio-home__stats-grid">
            {homeStats.map((stat) => (
              <div class="portfolio-home__stat">
                <div class="portfolio-home__stat-value">{stat.value}</div>
                <p>{stat.label}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="portfolio-home__section portfolio-home__section--work" id="proof">
      <div class="portfolio-home__container">
        <div class="portfolio-home__section-head portfolio-home__section-head--split">
          <div>
            <p class="portfolio-home__section-kicker">// Selected Proof</p>
          </div>

          <h2>Featured reporting, apps, and interactive systems</h2>

          <div class="portfolio-home__section-mark" aria-hidden="true">
            <span>&lt;/</span>
            <span>&gt;</span>
          </div>
        </div>

        <div class="portfolio-home__section-divider" aria-hidden="true">
          <span>&lt;/</span>
        </div>

        <div class="portfolio-home__work-grid" id="project-bento-grid">
          {featuredWork.map((entry, index) => (
            <a 
              href={getEntryHref(entry)} 
              class:list={[
                "portfolio-home__work-card",
                `portfolio-home__work-card--${index + 1}`
              ]}
              data-tilt
            >
              <div class="portfolio-home__work-glow" aria-hidden="true"></div>
              
              <div class="portfolio-home__work-image-frame">
                <img
                  src={entry.data.heroImage || portrait.src}
                  alt={entry.data.title}
                  class="portfolio-home__work-image"
                  width="1120"
                  height="820"
                  loading="lazy"
                />
              </div>

              <div class="portfolio-home__work-content">
                <div class="portfolio-home__work-copy">
                  <h3>{entry.data.title}</h3>
                  <p>{getEntrySummary(entry)}</p>
                </div>

                <div class="portfolio-home__tag-row">
                  {getEntryTags(entry)
                    .slice(0, 3)
                    .map((tag) => (
                      <span>{tag}</span>
                    ))}
                </div>
              </div>
              
              <div class="portfolio-home__work-arrow" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M7 17L17 7M17 7H7M17 7V17" />
                </svg>
              </div>
            </a>
          ))}
        </div>

        <div class="portfolio-home__section-cta">
          <a href="/projects" class="portfolio-home__button">
            View All Projects
          </a>
        </div>
      </div>
    </section>

    <section class="portfolio-home__section portfolio-home__section--proof-band">
      <div class="portfolio-home__container">
        <div class="portfolio-home__section-head portfolio-home__section-head--split">
          <div>
            <p class="portfolio-home__section-kicker">// Experience</p>
          </div>

          <h2>The newsrooms, institutions, and independent products behind the work</h2>

          <div class="portfolio-home__section-mark" aria-hidden="true">
            <span>&lt;/</span>
            <span>&gt;</span>
          </div>
        </div>

        <div class="portfolio-home__section-divider" aria-hidden="true">
          <span>&lt;/</span>
        </div>

        <div class="portfolio-home__clients-band">
          <div class="portfolio-home__clients-track">
            {repeatedWorkplaces.map((workplace, index) => (
              <a
                href={workplace.url}
                target="_blank"
                rel="noopener noreferrer"
                class="portfolio-home__client-logo"
              >
                <img
                  src={workplace.logo}
                  alt={workplace.name}
                  width="240"
                  height="96"
                  loading={index < workplaces.length ? 'eager' : 'lazy'}
                />
              </a>
            ))}
          </div>
        </div>
        <div class="portfolio-home__section-cta">
          <a href="/about" class="portfolio-home__button portfolio-home__button--ghost">
            View Experience
          </a>
        </div>
      </div>
    </section>

  </div>

  <style>
    .portfolio-home {
      position: relative;
      overflow: clip;
      background: #111111;
      color: #f3f1eb;
      isolation: isolate;
    }

    .portfolio-home a {
      color: inherit;
      text-decoration: none;
    }


    .portfolio-home__container {
      position: relative;
      width: min(100% - 80px, 1320px);
      margin-inline: auto;
    }


    .portfolio-home__hero {
      position: relative;
      padding: 0;
      background: transparent;
      perspective: 1200px;
      min-height: 100svh;
      display: flex;
      align-items: center;
    }

    .portfolio-home__hero::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: 120px;
      background: linear-gradient(to bottom, transparent, #111111);
      pointer-events: none;
      z-index: 5;
    }

    .portfolio-home__hero-sparkles {
      position: absolute;
      inset: 0;
      pointer-events: none;
      z-index: 1;
      overflow: hidden;
    }

    .portfolio-home__sparkle {
      position: absolute;
      left: var(--sx);
      top: var(--sy);
      width: var(--ss);
      height: var(--ss);
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.7);
      opacity: 0;
      filter: blur(0.5px);
      animation-delay: var(--sd);
      animation-fill-mode: both;
    }

    .portfolio-home__sparkle--accent {
      background: rgba(122, 242, 152, 0.6);
      box-shadow: 0 0 6px rgba(122, 242, 152, 0.3);
    }

    .portfolio-home__sparkle--float {
      animation: sparkle-float 7s ease-in-out infinite alternate;
    }

    .portfolio-home__sparkle--twinkle {
      animation: sparkle-twinkle 4s ease-in-out infinite;
    }

    .portfolio-home__sparkle--drift {
      animation: sparkle-drift 9s ease-in-out infinite alternate;
    }


    .portfolio-home__hero-grid {
      position: relative;
      display: grid;
      grid-template-columns: 1fr 1.2fr;
      grid-template-rows: auto auto auto;
      grid-template-areas:
        'copy  image'
        'side  image'
        '.     image';
      column-gap: 48px;
      row-gap: 28px;
      padding-top: 140px;
      padding-bottom: 80px;
      align-content: center;
      z-index: 2;
    }

    .portfolio-home__hero-copy {
      grid-area: copy;
      z-index: 10;
      align-self: end;
    }

    .portfolio-home__eyebrow {
      display: inline-flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 8px;
      font-size: clamp(0.95rem, 1.2vw, 1.3rem);
      font-weight: 500;
      letter-spacing: 0.04em;
      color: rgba(255, 255, 255, 0.7);
      text-transform: uppercase;
    }

    .portfolio-home__wave {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      transform-origin: 70% 70%;
      animation: portfolio-home-wave 2.2s ease-in-out infinite;
    }

    .portfolio-home__hero h1 {
      margin: 16px 0 0;
      font-size: clamp(4.8rem, 10vw, 9.5rem);
      line-height: 0.88;
      letter-spacing: -0.05em;
      color: #f5f2eb;
      text-transform: uppercase;
    }

    .portfolio-home__hero-side {
      grid-area: side;
      display: flex;
      flex-direction: column;
      gap: 32px;
      max-width: 540px;
      z-index: 10;
      align-self: start;
    }

    .portfolio-home__hero-summary {
      margin: 0;
      font-size: 1.2rem;
      line-height: 1.75;
      color: rgba(255, 255, 255, 0.82);
      font-weight: 400;
    }

    .portfolio-home__hero-meta {
      display: flex;
      flex-direction: column;
      gap: 20px;
      padding-top: 24px;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
    }

    .portfolio-home__hero-socials {
      display: flex;
      flex-wrap: wrap;
      gap: 18px;
      color: rgba(255, 255, 255, 0.72);
    }

    .portfolio-home__hero-socials a {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      font-size: 0.9rem;
      transition: color 180ms ease;
    }

    .portfolio-home__hero-socials a:hover {
      color: #f5f2eb;
    }

    .portfolio-home__hero-contacts {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 14px;
      color: rgba(255, 255, 255, 0.72);
      font-size: 0.9rem;
    }

    .portfolio-home__hero-contacts a {
      color: rgba(255, 255, 255, 0.82);
      transition: color 180ms ease;
    }

    .portfolio-home__hero-contacts a:hover {
      color: #f5f2eb;
    }

    .portfolio-home__contact-sep {
      color: rgba(255, 255, 255, 0.25);
    }

    .portfolio-home__hero-image-wrap {
      grid-area: image;
      position: relative;
      align-self: center;
      justify-self: end;
      width: 100%;
      max-width: 820px;
      transform-style: preserve-3d;
      transition: transform 0.1s ease-out;
      will-change: transform;
    }

    .portfolio-home__hero-glow {
      position: absolute;
      top: var(--glow-y, 50%);
      left: var(--glow-x, 50%);
      width: 400px;
      height: 400px;
      border-radius: 999px;
      background: radial-gradient(circle, rgba(255, 255, 255, 0.2), transparent 70%);
      filter: blur(48px);
      transform: translate(-50%, -50%) scale(1.6);
      pointer-events: none;
      z-index: -1;
      opacity: 0.6;
      transition: opacity 0.4s ease;
    }

    .portfolio-home__hero-particles {
      position: absolute;
      inset: -10% -10%;
      pointer-events: none;
      z-index: 1;
    }

    .portfolio-home__particle {
      position: absolute;
      top: var(--top);
      left: var(--left);
      width: var(--size);
      height: var(--size);
      background: rgba(255, 255, 255, 0.6);
      border-radius: 50%;
      opacity: 0.3;
      filter: blur(1px);
      animation: hero-particle-drift 8s ease-in-out infinite alternate;
      animation-delay: var(--delay);
    }


    .portfolio-home__hero-image {
      position: relative;
      display: block;
      width: 100%;
      height: auto;
      object-fit: cover;
      filter: saturate(0.92) contrast(1.08) brightness(1.04);
      transition: filter 0.5s ease;
      mask-image: 
        linear-gradient(to bottom, black 0%, black 55%, transparent 100%),
        radial-gradient(ellipse 90% 95% at 50% 42%, black 55%, transparent 90%);
      -webkit-mask-image: 
        linear-gradient(to bottom, black 0%, black 55%, transparent 100%),
        radial-gradient(ellipse 90% 95% at 50% 42%, black 55%, transparent 90%);
      mask-composite: intersect;
      -webkit-mask-composite: source-in;
      pointer-events: auto;
    }

    .portfolio-home__hero-image-wrap:hover .portfolio-home__hero-image {
      filter: saturate(1.1) contrast(1.05) brightness(1.1);
    }

    .portfolio-home__hero-image-wrap:hover .portfolio-home__hero-glow {
      opacity: 0.9;
    }

    .portfolio-home__marquee-section {
      position: relative;
    }

    .portfolio-home__section-shell,
    .portfolio-home__section {
      padding: 118px 0;
    }

    .portfolio-home__section--deep {
      background: #111111;
    }

    .portfolio-home__section--soft {
      background: #191818;
    }

    .portfolio-home__section--work {
      padding: 72px 0 76px;
    }

    .portfolio-home__section-head {
      display: flex;
      justify-content: space-between;
      align-items: end;
      gap: 28px;
      margin-bottom: 24px;
    }

    .portfolio-home__section-kicker {
      margin: 0 0 18px;
      font-size: 0.88rem;
      letter-spacing: 0.08em;
      color: #7af298;
    }

    .portfolio-home__section-head--split {
      display: grid;
      grid-template-columns: minmax(180px, 1fr) minmax(0, 640px) auto;
      align-items: end;
      gap: 24px;
    }

    .portfolio-home__section-head--split h2 {
      text-align: left;
      justify-self: start;
    }

    .portfolio-home__section-head h2 {
      margin: 0;
      max-width: 760px;
      font-size: clamp(2.25rem, 4.8vw, 4rem);
      line-height: 1.08;
      letter-spacing: -0.05em;
      color: #f5f2eb;
    }

    .portfolio-home__section-mark {
      display: flex;
      gap: 12px;
      align-items: center;
      font-size: 1.35rem;
      color: rgba(255, 255, 255, 0.76);
    }

    .portfolio-home__section-divider {
      display: flex;
      align-items: center;
      gap: 14px;
      margin-bottom: 40px;
      color: #7af298;
      font-size: 1.25rem;
    }

    .portfolio-home__section-divider::after {
      content: '';
      flex: 1;
      border-top: 1px solid rgba(255, 255, 255, 0.18);
    }

    .portfolio-home__skills-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(320px, 480px);
      gap: 54px;
      align-items: start;
    }

    .portfolio-home__skills-list {
      display: grid;
      gap: 0;
    }

    .portfolio-home__skill-group {
      padding: 18px 0 16px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.14);
    }

    .portfolio-home__skill-group-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 16px;
      margin-bottom: 12px;
    }

    .portfolio-home__skill-group-head h2 {
      margin: 0;
      font-size: 1.12rem;
      line-height: 1.2;
      color: #ffffff;
    }

    .portfolio-home__skill-group-head span {
      color: rgba(255, 255, 255, 0.7);
      font-size: 0.92rem;
    }

    .portfolio-home__skill-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 10px 14px;
      color: rgba(255, 255, 255, 0.62);
      font-size: 0.92rem;
    }

    .portfolio-home__skills-copy {
      padding-top: 44px;
    }

    .portfolio-home__skills-copy p {
      margin: 0;
      font-size: 1.14rem;
      line-height: 1.85;
      color: rgba(255, 255, 255, 0.86);
    }

    .portfolio-home__positioning-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(320px, 420px);
      gap: 54px;
      align-items: start;
    }

    .portfolio-home__positioning-copy {
      margin-top: 24px;
      max-width: 720px;
    }

    .portfolio-home__positioning-copy h2 {
      margin: 0;
      font-size: clamp(2.2rem, 4.4vw, 4rem);
      line-height: 0.98;
      letter-spacing: -0.05em;
      color: #f5f2eb;
    }

    .portfolio-home__positioning-copy p {
      margin: 22px 0 0;
      font-size: 1.08rem;
      line-height: 1.85;
      color: rgba(255, 255, 255, 0.76);
    }

    .portfolio-home__positioning-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
      margin-top: 34px;
    }

    .portfolio-home__positioning-notes {
      display: grid;
      gap: 0;
      padding-top: 44px;
    }

    .portfolio-home__positioning-note {
      display: grid;
      gap: 16px;
      padding: 20px 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.14);
    }

    .portfolio-home__positioning-note span {
