    .portfolio-home__process-card p,
    .portfolio-home__service-body p,
    .portfolio-home__client-card span {
      margin: 12px 0 0;
      font-size: 1rem;
      line-height: 1.8;
      color: hsl(var(--foreground) / 0.74);
