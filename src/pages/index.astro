    .portfolio-home__skill-group-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 16px;
      margin-bottom: 12px;
    }

    .portfolio-home__skill-group-head h2 {
      margin: 0;
      font-size: 1.12rem;
      line-height: 1.2;
      color: hsl(var(--foreground));
    }

    .portfolio-home__skill-group-head span {
      color: hsl(var(--foreground) / 0.7);
      font-size: 0.92rem;
    }

    .portfolio-home__skill-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 10px 14px;
      color: hsl(var(--foreground) / 0.62);
      font-size: 0.92rem;
