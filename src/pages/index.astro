---
import { getCollection, type CollectionEntry } from 'astro:content';

import Icon from '../components/Icon.astro';
import JsonLd from '../components/JsonLd.astro';
import ResumeLinks from '../components/ResumeLinks.astro';
import WorkCard from '../components/WorkCard.astro';
import { InfiniteMovingCards } from '../components/ui/InfiniteMovingCards';
import {
  appProjects,
  credibilityHighlights,
  dataJournalismProjectSlugs,
  developerMethods,
  expertiseLanes,
  featuredArticleSlugs,
  journalismMethods,
  workplaces,
} from '../data/portfolio';
import { pickEntriesBySlug } from '../lib/content';
import MainLayout from '../layouts/MainLayout.astro';

const projects: CollectionEntry<'projects'>[] = await getCollection('projects');
const articles: CollectionEntry<'articles'>[] = await getCollection('articles', ({ data }) => !data.draft);

const journalismProjects = pickEntriesBySlug<'projects'>(projects, dataJournalismProjectSlugs);
const featuredArticles = pickEntriesBySlug<'articles'>(articles, featuredArticleSlugs);
const leadApp = appProjects[0];

const articleSummary = (article: CollectionEntry<'articles'>) =>
  article.data.summaryEn || article.data.description;

const personSchema = {
  '@type': 'Person',
  name: 'Anil Karaca',
  jobTitle: 'Data Journalist and Developer',
  url: 'https://anilkaraca.com',
  sameAs: [
    'https://x.com/anilkaraca17',
    'https://github.com/arthlor',
    'https://www.linkedin.com/in/anil-karaca/',
  ],
};
---

<MainLayout
  title="Home"
  description="Anil Karaca is a data journalist and developer focused on public-interest storytelling, mobile apps, and editorial product work."
  image="/images/anil-karaca.jpg"
>
  <JsonLd schema={personSchema} />

  <section class="relative overflow-hidden pt-28 pb-20">
    <div class="absolute inset-0 bg-gradient-to-br from-background via-card/30 to-background"></div>
    <div class="absolute left-0 top-10 h-[420px] w-[420px] rounded-full bg-primary/10 blur-[120px]"></div>
    <div class="absolute bottom-0 right-0 h-[360px] w-[360px] rounded-full bg-secondary/10 blur-[110px]"></div>

    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl">
        <div class="inline-flex items-center gap-2 rounded-full border border-primary/25 bg-card/80 px-4 py-2 text-sm text-muted-foreground backdrop-blur-sm">
          <span class="h-2 w-2 rounded-full bg-primary"></span>
          Open to full-time roles in data journalism and product development
        </div>

        <h1 class="mt-8 text-5xl font-display font-bold tracking-tight sm:text-6xl lg:text-7xl">
          I help teams explain complex systems through
          <span class="text-gradient"> reporting, code, and product thinking.</span>
        </h1>

        <p class="mt-6 max-w-3xl text-lg leading-relaxed text-muted-foreground sm:text-xl">
          I work at the intersection of public-interest storytelling and software delivery. Hire me for
          data journalism, newsroom-adjacent product work, frontend engineering, or mobile app execution.
        </p>

        <div class="mt-10 flex flex-col gap-4 sm:flex-row">
          <a
            href="/data-journalism"
            class="group inline-flex items-center justify-center gap-2 rounded-2xl bg-primary px-7 py-4 text-sm font-semibold text-primary-foreground shadow-lg shadow-primary/20 transition-all duration-300 hover:brightness-110"
            data-track-event="open_data_journalism_lane"
            data-track-label="Homepage Data Journalism"
          >
            View Data Journalism Work
            <Icon name="arrow-right" size={18} class="transition-transform group-hover:translate-x-1" />
          </a>
          <a
            href="/developer"
            class="group inline-flex items-center justify-center gap-2 rounded-2xl border border-border bg-card/80 px-7 py-4 text-sm font-semibold text-foreground transition-all duration-300 hover:border-primary/30 hover:bg-card"
            data-track-event="open_developer_lane"
            data-track-label="Homepage Developer"
          >
            View Developer Work
            <Icon name="arrow-right" size={18} class="transition-transform group-hover:translate-x-1" />
          </a>
          <a
            href="/anilkaraca-cv.pdf"
            class="inline-flex items-center justify-center gap-2 rounded-2xl border border-primary/25 bg-primary/10 px-7 py-4 text-sm font-semibold text-primary transition-all duration-300 hover:bg-primary/15"
            data-track-event="download_master_resume"
            data-track-label="Homepage Resume"
          >
            <Icon name="download" size={18} />
            Download Resume
          </a>
        </div>

        <div class="mt-12 grid gap-3 sm:grid-cols-3">
          {credibilityHighlights.map((highlight) => (
            <div class="rounded-2xl border border-border bg-card/70 px-4 py-4 text-sm leading-relaxed text-muted-foreground backdrop-blur-sm">
              {highlight}
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="py-12">
    <div class="mx-auto grid max-w-7xl gap-6 px-4 sm:px-6 lg:px-8 lg:grid-cols-2">
      {expertiseLanes.map((lane) => {
        const methods = lane.slug === 'data-journalism' ? journalismMethods : developerMethods;
        const laneEvent = lane.slug === 'data-journalism' ? 'open_data_journalism_lane' : 'open_developer_lane';

        return (
          <article class="rounded-3xl border border-border bg-card/80 p-8 backdrop-blur-sm">
            <span class="text-xs font-semibold uppercase tracking-[0.18em] text-primary">
              {lane.kicker}
            </span>
            <h2 class="mt-4 text-3xl font-display font-bold text-foreground">{lane.title}</h2>
            <p class="mt-4 text-base leading-relaxed text-muted-foreground">{lane.summary}</p>

            <div class="mt-6 space-y-3">
              {methods.map((method) => (
                <div class="flex items-start gap-3 rounded-2xl border border-border/70 bg-background/40 px-4 py-3">
                  <div class="mt-1 flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-primary/10 text-primary">
                    <Icon name={lane.slug === 'data-journalism' ? 'data-journalism' : 'code'} size={14} />
                  </div>
                  <p class="text-sm leading-relaxed text-muted-foreground">{method}</p>
                </div>
              ))}
            </div>

            <div class="mt-6 rounded-2xl border border-border/70 bg-background/50 p-4">
              <p class="text-xs font-semibold uppercase tracking-[0.18em] text-primary">Selected proof</p>
              <div class="mt-3 space-y-3">
                {lane.slug === 'data-journalism' ? (
                  <>
                    {journalismProjects.slice(0, 2).map((project) => (
                      <a
                        href={project.data.liveUrl || `/projects/${project.slug}`}
                        target={project.data.liveUrl?.startsWith('http') ? '_blank' : undefined}
                        rel={project.data.liveUrl?.startsWith('http') ? 'noopener noreferrer' : undefined}
                        class="flex items-start justify-between gap-3 rounded-xl border border-transparent bg-card/60 px-4 py-3 transition-colors hover:border-primary/20"
                      >
                        <div>
                          <p class="font-semibold text-foreground">{project.data.title}</p>
                          <p class="mt-1 text-sm text-muted-foreground">
                            {project.data.summaryEn || project.data.description}
                          </p>
                        </div>
                        <Icon name="arrow-right" size={16} class="mt-1 shrink-0 text-primary" />
                      </a>
                    ))}
                    {featuredArticles.slice(0, 1).map((article) => (
                      <a
                        href={`/articles/${article.slug}`}
                        class="flex items-start justify-between gap-3 rounded-xl border border-transparent bg-card/60 px-4 py-3 transition-colors hover:border-primary/20"
                      >
                        <div>
                          <p class="font-semibold text-foreground">{article.data.title}</p>
                          <p class="mt-1 text-sm text-muted-foreground">{articleSummary(article)}</p>
                        </div>
                        <Icon name="arrow-right" size={16} class="mt-1 shrink-0 text-primary" />
                      </a>
                    ))}
                  </>
                ) : (
                  <>
                    {appProjects.slice(0, 2).map((app) => (
                      <a
                        href={app.appStoreUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="flex items-start justify-between gap-3 rounded-xl border border-transparent bg-card/60 px-4 py-3 transition-colors hover:border-primary/20"
                      >
                        <div>
                          <p class="font-semibold text-foreground">{app.name}</p>
                          <p class="mt-1 text-sm text-muted-foreground">{app.technicalSummary}</p>
                        </div>
                        <Icon name="arrow-right" size={16} class="mt-1 shrink-0 text-primary" />
                      </a>
                    ))}
                    {journalismProjects.slice(1, 2).map((project) => (
                      <a
                        href={project.data.liveUrl || `/projects/${project.slug}`}
                        target={project.data.liveUrl?.startsWith('http') ? '_blank' : undefined}
                        rel={project.data.liveUrl?.startsWith('http') ? 'noopener noreferrer' : undefined}
                        class="flex items-start justify-between gap-3 rounded-xl border border-transparent bg-card/60 px-4 py-3 transition-colors hover:border-primary/20"
                      >
                        <div>
                          <p class="font-semibold text-foreground">{project.data.title}</p>
                          <p class="mt-1 text-sm text-muted-foreground">
                            Technical case study: interactive analysis built with React, D3.js, and a Python data workflow.
                          </p>
                        </div>
                        <Icon name="arrow-right" size={16} class="mt-1 shrink-0 text-primary" />
                      </a>
                    ))}
                  </>
                )}
              </div>
            </div>

            <a
              href={`/${lane.slug}`}
              class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-primary transition-all hover:gap-3"
              data-track-event={laneEvent}
              data-track-label={lane.title}
            >
              Explore {lane.title}
              <Icon name="arrow-right" size={16} />
            </a>
          </article>
        );
      })}
    </div>
  </section>

  <section class="py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mb-10 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
        <div>
          <span class="text-xs font-semibold uppercase tracking-[0.18em] text-primary">Selected proof</span>
          <h2 class="mt-3 text-3xl font-display font-bold text-foreground sm:text-4xl">
            The strongest cross-track work on one screen
          </h2>
        </div>
        <a
          href="/projects"
          class="inline-flex items-center gap-2 text-sm font-semibold text-primary"
        >
          Browse selected work
          <Icon name="arrow-right" size={16} />
        </a>
      </div>

      <div class="grid gap-6 lg:grid-cols-3">
        {journalismProjects.slice(0, 1).map((project) => (
          <WorkCard
            title={project.data.title}
            eyebrow="Data journalism"
            description={project.data.summaryEn || project.data.description}
            href={project.data.liveUrl || `/projects/${project.slug}`}
            external={Boolean(project.data.liveUrl?.startsWith('http'))}
            role={project.data.role}
            impact={project.data.impact}
            tags={project.data.technologies}
            image={project.data.heroImage}
            ctaLabel="View case study"
          />
        ))}

        {journalismProjects.slice(1, 2).map((project) => (
          <WorkCard
            title={project.data.title}
            eyebrow="Editorial product"
            description="Interactive parliamentary analysis with a strong reporting angle and a deep technical implementation."
            href={project.data.liveUrl || `/projects/${project.slug}`}
            external={Boolean(project.data.liveUrl?.startsWith('http'))}
            role={project.data.role}
            impact={project.data.impact}
            tags={project.data.technologies}
            image={project.data.heroImage}
            ctaLabel="Open project"
          />
        ))}

        {leadApp && (
          <WorkCard
            title={leadApp.name}
            eyebrow="Shipped app"
            description={leadApp.technicalSummary}
            href={leadApp.appStoreUrl}
            external={true}
            role={leadApp.role}
            impact={leadApp.impact}
            tags={leadApp.stack}
            image={leadApp.image}
            ctaLabel="View App Store listing"
          />
        )}
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="rounded-3xl border border-border bg-card/70 p-8 backdrop-blur-sm">
        <div class="max-w-2xl">
          <span class="text-xs font-semibold uppercase tracking-[0.18em] text-primary">Credibility</span>
          <h2 class="mt-3 text-3xl font-display font-bold text-foreground">
            Newsrooms, municipalities, and product work all inform how I build.
          </h2>
          <p class="mt-3 text-base leading-relaxed text-muted-foreground">
            The portfolio is intentionally split into two hiring lanes, but the underlying advantage is the mix:
            editorial judgment, analytical rigor, and actual product execution.
          </p>
        </div>

        <div class="mt-8">
          <InfiniteMovingCards
            client:load
            items={workplaces.map((workplace) => ({
              name: workplace.name,
              image: workplace.logo,
              link: workplace.url,
            }))}
            speed="slow"
            pauseOnHover={true}
            className="mx-auto"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <ResumeLinks />
    </div>
  </section>

  <section class="pb-24">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <div class="rounded-[2rem] border border-primary/20 bg-gradient-to-br from-card to-background p-8 text-center shadow-xl shadow-primary/5 md:p-12">
        <span class="text-xs font-semibold uppercase tracking-[0.18em] text-primary">Hiring</span>
        <h2 class="mt-4 text-3xl font-display font-bold text-foreground sm:text-4xl">
          Looking for someone who can report, ship, and communicate?
        </h2>
        <p class="mx-auto mt-4 max-w-2xl text-base leading-relaxed text-muted-foreground">
          I am strongest in roles where analytical thinking, strong writing, and frontend or mobile execution need to
          work together, not compete with each other.
        </p>
        <div class="mt-8 flex flex-col justify-center gap-4 sm:flex-row">
          <a
            href="/contact"
            class="inline-flex items-center justify-center gap-2 rounded-2xl bg-primary px-7 py-4 text-sm font-semibold text-primary-foreground transition-all duration-300 hover:brightness-110"
            data-track-event="contact_click"
            data-track-label="Homepage Contact"
          >
            Talk about a role
            <Icon name="arrow-right" size={18} />
          </a>
          <a
            href="https://www.linkedin.com/in/anil-karaca/"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 rounded-2xl border border-border bg-card/80 px-7 py-4 text-sm font-semibold text-foreground transition-all duration-300 hover:border-primary/30"
          >
            View LinkedIn
            <Icon name="external-link" size={18} />
          </a>
        </div>
      </div>
    </div>
  </section>
</MainLayout>
