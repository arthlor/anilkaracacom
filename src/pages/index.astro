      justify-content: center;
      border-radius: 999px;
      background: hsl(var(--primary));
      color: hsl(var(--primary-foreground));
      font-size: 0.78rem;
      font-weight: 700;
      box-shadow: 0 18px 42px rgba(46, 204, 113, 0.3);
      transition:
        transform 180ms ease,
        box-shadow 180ms ease,
        filter 180ms ease;
    }

    .portfolio-home__cta-orb:hover {
      filter: brightness(1.08);
      transform: translateY(-2px);
      box-shadow: 0 20px 46px rgba(46, 204, 113, 0.4);
