---
import { getCollection } from "astro:content";

import JsonLd from "@components/JsonLd.astro";
import {
  credibilityHighlights,
  featuredArticleSlugs,
  primaryProductProjectSlugs,
  workplaces,
} from "@/data/portfolio";
import {
  getEntryHref,
  getEntrySummary,
  getEntryTags,
  isPublicEntryData,
  pickEntriesBySlug,
  sortEntriesByFeatureAndDate,
} from "@/lib/content";
import { buildPersonSchema } from "@/lib/seo";
import { resumeUrl } from "@/lib/resume";
import { siteConfig, socialLinks } from "@/lib/site";
import MainLayout from "@layouts/MainLayout.astro";
import { Image } from "astro:assets";
import portrait from "@/assets/images/anilkaraca.webp";
import heroPortrait from "@/assets/images/anilkaraca.webp";

const [projects, articles] = await Promise.all([
  getCollection("projects", ({ data }) => isPublicEntryData(data)),
  getCollection("articles", ({ data }) => isPublicEntryData(data)),
]);
const featuredWork = sortEntriesByFeatureAndDate(projects).slice(0, 6);
const featuredArticles = pickEntriesBySlug(articles, featuredArticleSlugs).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const homeStats = [
  {
    value: "10+",
    label: "Years across journalism, communications, and digital products",
  },
  {
    value: `${workplaces.length}`,
    label: "Newsrooms and public institutions",
  },
  {
    value: `${primaryProductProjectSlugs.length - 1}`,
    label: "iOS apps shipped to the App Store",
  },
] as const;

const socialLinkMap = new Map(
  socialLinks.map((link) => [
    link.label === "X (Twitter)" ? "X" : link.label,
    {
      ...link,
      label: link.label === "X (Twitter)" ? "X" : link.label,
    },
  ]),
);

const footerSocialLinks = ["X", "LinkedIn", "GitHub", "YouTube"]
  .map((label) => socialLinkMap.get(label))
  .filter((link): link is NonNullable<(typeof socialLinks)[number]> =>
    Boolean(link),
  );

const repeatedWorkplaces = [...workplaces, ...workplaces];
---

<MainLayout
  title="Home"
  description="Anil Karaca builds mobile products, reports with data, and helps organizations communicate complex work clearly."
>
  <JsonLd schema={buildPersonSchema()} />

  <div class="portfolio-home">
    <section class="portfolio-home__hero">
      <!-- Hero-wide sparkle layer -->
      <div class="portfolio-home__hero-sparkles" aria-hidden="true">
        <div
          class="portfolio-home__sparkle portfolio-home__sparkle--float"
          style="--sx: 6%; --sy: 18%; --sd: 0s; --ss: 3px;"
        >
        </div>
        <div
          class="portfolio-home__sparkle portfolio-home__sparkle--twinkle"
          style="--sx: 14%; --sy: 72%; --sd: 1.4s; --ss: 2px;"
        >
        </div>
        <div
          class="portfolio-home__sparkle portfolio-home__sparkle--drift"
          style="--sx: 22%; --sy: 38%; --sd: 0.6s; --ss: 4px;"
        >
        </div>
        <div
          class="portfolio-home__sparkle portfolio-home__sparkle--float portfolio-home__sparkle--accent"
          style="--sx: 32%; --sy: 85%; --sd: 2.8s; --ss: 3px;"
        >
        </div>
        <div
          class="portfolio-home__sparkle portfolio-home__sparkle--twinkle"
          style="--sx: 40%; --sy: 12%; --sd: 3.2s; --ss: 2px;"
        >
        </div>
        <div
          class="portfolio-home__sparkle portfolio-home__sparkle--drift portfolio-home__sparkle--accent"
          style="--sx: 48%; --sy: 55%; --sd: 1.0s; --ss: 5px;"
        >
        </div>
        <div
          class="portfolio-home__sparkle portfolio-home__sparkle--float"
          style="--sx: 58%; --sy: 28%; --sd: 4.0s; --ss: 2px;"
        >
        </div>
        <div
          class="portfolio-home__sparkle portfolio-home__sparkle--twinkle portfolio-home__sparkle--accent"
          style="--sx: 65%; --sy: 78%; --sd: 0.3s; --ss: 3px;"
        >
        </div>
        <div
          class="portfolio-home__sparkle portfolio-home__sparkle--drift"
          style="--sx: 72%; --sy: 15%; --sd: 2.2s; --ss: 4px;"
        >
        </div>
        <div
          class="portfolio-home__sparkle portfolio-home__sparkle--float"
          style="--sx: 78%; --sy: 62%; --sd: 3.6s; --ss: 2px;"
        >
        </div>
        <div
          class="portfolio-home__sparkle portfolio-home__sparkle--twinkle"
          style="--sx: 85%; --sy: 42%; --sd: 1.8s; --ss: 3px;"
        >
        </div>
        <div
          class="portfolio-home__sparkle portfolio-home__sparkle--drift portfolio-home__sparkle--accent"
          style="--sx: 90%; --sy: 90%; --sd: 0.8s; --ss: 4px;"
        >
        </div>
        <div
          class="portfolio-home__sparkle portfolio-home__sparkle--float"
          style="--sx: 95%; --sy: 22%; --sd: 2.5s; --ss: 2px;"
        >
        </div>
        <div
          class="portfolio-home__sparkle portfolio-home__sparkle--twinkle portfolio-home__sparkle--accent"
          style="--sx: 10%; --sy: 50%; --sd: 4.4s; --ss: 3px;"
        >
        </div>
        <div
          class="portfolio-home__sparkle portfolio-home__sparkle--drift"
          style="--sx: 52%; --sy: 8%; --sd: 3.0s; --ss: 2px;"
        >
        </div>
        <div
          class="portfolio-home__sparkle portfolio-home__sparkle--float portfolio-home__sparkle--accent"
          style="--sx: 28%; --sy: 30%; --sd: 1.6s; --ss: 5px;"
        >
        </div>
      </div>

      <div class="portfolio-home__container portfolio-home__hero-grid">
        <!-- Left column: all text -->
        <div class="portfolio-home__hero-copy">
          <div class="portfolio-home__eyebrow">
            <span>Product Specialist</span>
            <span class="portfolio-home__eyebrow-sep" aria-hidden="true">·</span
            >
            <span>Data Journalist</span>
            <span class="portfolio-home__eyebrow-sep" aria-hidden="true">·</span
            >
            <span>Communications Specialist</span>
          </div>
          <h1>ANIL<br />KARACA</h1>
        </div>

        <div class="portfolio-home__hero-side">
          <p class="portfolio-home__hero-summary">
            I build mobile products, find stories in complex data, and help
            organizations communicate clearly.
          </p>

          <div class="portfolio-home__hero-meta">
            <div class="portfolio-home__hero-socials">
              {
                footerSocialLinks.map((link) => (
                  <a href={link.href} target="_blank" rel="noopener noreferrer">
                    <span aria-hidden="true">/</span>
                    {link.label}
                  </a>
                ))
              }
            </div>

            <div class="portfolio-home__hero-contacts">
              <a href={`mailto:${siteConfig.contactEmail}`}
                >{siteConfig.contactEmail}</a
              >
              <span class="portfolio-home__contact-sep" aria-hidden="true"
                >·</span
              >
              <a
                href={resumeUrl}
                data-track-event="navigate_cv"
                data-track-label="Home Hero CV">CVs</a
              >
            </div>
          </div>
        </div>

        <!-- Right column: portrait -->
        <div class="portfolio-home__hero-image-wrap" id="hero-image-container">
          <div
            class="portfolio-home__hero-glow"
            id="hero-magnetic-glow"
            aria-hidden="true"
          >
          </div>

          <div class="portfolio-home__hero-particles" aria-hidden="true">
            <div
              class="portfolio-home__particle"
              style="--top: 12%; --left: 8%; --delay: 0s; --size: 4px;"
            >
            </div>
            <div
              class="portfolio-home__particle"
              style="--top: 50%; --left: 92%; --delay: 1.2s; --size: 3px;"
            >
            </div>
            <div
              class="portfolio-home__particle"
              style="--top: 80%; --left: 12%; --delay: 2.4s; --size: 5px;"
            >
            </div>
            <div
              class="portfolio-home__particle"
              style="--top: 20%; --left: 88%; --delay: 3.6s; --size: 2px;"
            >
            </div>
          </div>

          <Image
            src={heroPortrait}
            alt="Portrait of Anil Karaca"
            class="portfolio-home__hero-image"
            width={800}
            height={1000}
            loading="eager"
            id="hero-portrait"
          />
        </div>
      </div>
    </section>

    <section class="portfolio-home__marquee-section">
      <div class="portfolio-home__section-shell" id="positioning">
        <div class="portfolio-home__container">
          <div class="portfolio-home__positioning-grid">
            <div>
              <p class="portfolio-home__section-kicker">// What I Do</p>

              <div class="portfolio-home__positioning-copy">
                <h2>I work across product, data, and communications.</h2>
                <p>
                  That can mean taking an app from idea to release, turning a
                  public dataset into an interactive story, or finding the
                  clearest way to explain complicated work.
                </p>
              </div>

              <div class="portfolio-home__positioning-actions">
                <a href="/projects" class="portfolio-home__button">
                  See my work
                </a>
                <a
                  href="/about"
                  class="portfolio-home__button portfolio-home__button--ghost"
                >
                  More about me
                </a>
              </div>
            </div>

            <div class="portfolio-home__positioning-notes">
              {
                credibilityHighlights.map((highlight, index) => (
                  <article class="portfolio-home__positioning-note">
                    <span>{String(index + 1).padStart(2, "0")}</span>
                    <p>{highlight}</p>
                  </article>
                ))
              }
            </div>
          </div>

          <div class="portfolio-home__stats-grid">
            {
              homeStats.map((stat) => (
                <div class="portfolio-home__stat">
                  <div class="portfolio-home__stat-value">{stat.value}</div>
                  <p>{stat.label}</p>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section
      class="portfolio-home__section portfolio-home__section--work"
      id="proof"
    >
      <div class="portfolio-home__container">
        <div
          class="portfolio-home__section-head portfolio-home__section-head--split"
        >
          <div>
            <p class="portfolio-home__section-kicker">// Selected Work</p>
          </div>

          <h2>A few things I’ve made and shipped</h2>

          <div class="portfolio-home__section-mark" aria-hidden="true">
            <span>&lt;/</span>
            <span>&gt;</span>
          </div>
        </div>

        <div class="portfolio-home__section-divider" aria-hidden="true">
          <span>&lt;/</span>
        </div>

        <div class="portfolio-home__work-grid" id="project-bento-grid">
          {
            featuredWork.map((entry, index) => (
              <a
                href={getEntryHref(entry)}
                class:list={[
                  "portfolio-home__work-card",
                  `portfolio-home__work-card--${index + 1}`,
                ]}
                data-tilt
              >
                <div class="portfolio-home__work-glow" aria-hidden="true" />

                <div
                  class:list={[
                    "portfolio-home__work-image-frame",
                    (entry.id === "yeser" || entry.id === "ai-fit-check") &&
                      "portfolio-home__work-image-frame--contain",
                  ]}
                >
                  <Image
                    src={entry.data.heroImage || portrait}
                    alt={entry.data.title}
                    class="portfolio-home__work-image"
                    width={1120}
                    height={820}
                    loading="lazy"
                  />
                </div>

                <div class="portfolio-home__work-content">
                  <div class="portfolio-home__work-copy">
                    <h3>{entry.data.title}</h3>
                    <p>{getEntrySummary(entry)}</p>
                  </div>

                  <div class="portfolio-home__tag-row">
                    {getEntryTags(entry)
                      .slice(0, 3)
                      .map((tag) => (
                        <span>{tag}</span>
                      ))}
                  </div>
                </div>

                <div class="portfolio-home__work-arrow" aria-hidden="true">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path d="M7 17L17 7M17 7H7M17 7V17" />
                  </svg>
                </div>
              </a>
            ))
          }
        </div>

        <div class="portfolio-home__section-cta">
          <a href="/projects" class="portfolio-home__button">
            See all projects
          </a>
        </div>
      </div>
    </section>

    {
      featuredArticles.length > 0 && (
        <section
          class="portfolio-home__section portfolio-home__section--writing"
          id="featured-writing"
        >
          <div class="portfolio-home__container">
            <div class="portfolio-home__section-head portfolio-home__section-head--split">
              <div>
                <p class="portfolio-home__section-kicker">
                  // Selected Articles
                </p>
              </div>

              <h2>Reporting that starts with the data</h2>

              <div class="portfolio-home__section-mark" aria-hidden="true">
                <span>&lt;/</span>
                <span>&gt;</span>
              </div>
            </div>

            <div class="portfolio-home__section-divider" aria-hidden="true">
              <span>&lt;/</span>
            </div>

            <div class="portfolio-home__writing-grid">
              {featuredArticles.map((entry) => (
                <a
                  href={getEntryHref(entry)}
                  class="portfolio-home__writing-card"
                >
                  {entry.data.heroImage && (
                    <div class="portfolio-home__writing-image">
                      <Image
                        src={entry.data.heroImage}
                        alt={entry.data.title}
                        width={600}
                        height={375}
                        loading="lazy"
                      />
                    </div>
                  )}
                  <div class="portfolio-home__writing-copy">
                    <p class="portfolio-home__writing-meta">
                      {entry.data.language === "tr" ? "Turkish" : "English"} ·{" "}
                      {entry.data.pubDate.toLocaleDateString("en-US", {
                        year: "numeric",
                        month: "short",
                      })}
                    </p>
                    <h3>{entry.data.title}</h3>
                    <p>{entry.data.description}</p>
                  </div>
                </a>
              ))}
            </div>

            <div class="portfolio-home__section-cta">
              <a href="/articles" class="portfolio-home__button">
                See all articles
              </a>
            </div>
          </div>
        </section>
      )
    }

    <section
      class="portfolio-home__section portfolio-home__section--proof-band"
    >
      <div class="portfolio-home__container">
        <div
          class="portfolio-home__section-head portfolio-home__section-head--split"
        >
          <div>
            <p class="portfolio-home__section-kicker">// Where I’ve Worked</p>
          </div>

          <h2>Newsrooms and public institutions I’ve worked with</h2>

          <div class="portfolio-home__section-mark" aria-hidden="true">
            <span>&lt;/</span>
            <span>&gt;</span>
          </div>
        </div>

        <div class="portfolio-home__section-divider" aria-hidden="true">
          <span>&lt;/</span>
        </div>

        <div class="portfolio-home__clients-band">
          <div class="portfolio-home__clients-track">
            {
              repeatedWorkplaces.map((workplace, index) => (
                <a
                  href={workplace.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="portfolio-home__client-logo"
                >
                  <Image
                    src={workplace.logo}
                    alt={workplace.name}
                    width={240}
                    height={96}
                    loading={index < workplaces.length ? "eager" : "lazy"}
                  />
                </a>
              ))
            }
          </div>
        </div>
        <div class="portfolio-home__section-cta">
          <a
            href="/about"
            class="portfolio-home__button portfolio-home__button--ghost"
          >
            See my experience
          </a>
        </div>
      </div>
    </section>
  </div>

  <style>
    .portfolio-home {
      position: relative;
      overflow: clip;
      background: hsl(var(--background));
      color: hsl(var(--foreground));
      isolation: isolate;
      transition:
        background-color var(--transition-normal),
        color var(--transition-normal);
    }

    .portfolio-home a {
      color: inherit;
      text-decoration: none;
    }

    .portfolio-home__container {
      position: relative;
      width: min(100% - 80px, 1320px);
      margin-inline: auto;
    }

    .portfolio-home__hero {
      position: relative;
      padding: 0;
      background: transparent;
      perspective: 1200px;
      min-height: 100svh;
      display: flex;
      align-items: center;
    }

    .portfolio-home__hero::after {
      content: "";
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: 120px;
      background: linear-gradient(
        to bottom,
        transparent,
        hsl(var(--background))
      );
      pointer-events: none;
      z-index: 5;
      transition: background var(--transition-normal);
    }

    .portfolio-home__hero-sparkles {
      position: absolute;
      inset: 0;
      pointer-events: none;
      z-index: 1;
      overflow: hidden;
    }

    .portfolio-home__sparkle {
      position: absolute;
      left: var(--sx);
      top: var(--sy);
      width: var(--ss);
      height: var(--ss);
      border-radius: 50%;
      background: hsl(var(--foreground) / 0.7);
      opacity: 0;
      filter: blur(0.5px);
      animation-delay: var(--sd);
      animation-fill-mode: both;
    }

    .portfolio-home__sparkle--accent {
      background: rgba(122, 242, 152, 0.6);
      box-shadow: 0 0 6px rgba(122, 242, 152, 0.3);
    }

    .portfolio-home__sparkle--float {
      animation: sparkle-float 7s ease-in-out infinite alternate;
    }

    .portfolio-home__sparkle--twinkle {
      animation: sparkle-twinkle 4s ease-in-out infinite;
    }

    .portfolio-home__sparkle--drift {
      animation: sparkle-drift 9s ease-in-out infinite alternate;
    }

    .portfolio-home__hero-grid {
      position: relative;
      display: grid;
      grid-template-columns: minmax(0, 1.08fr) minmax(360px, 0.72fr);
      grid-template-rows: auto auto auto;
      grid-template-areas:
        "copy  image"
        "side  image"
        ".     image";
      column-gap: clamp(48px, 6vw, 96px);
      row-gap: 28px;
      padding-top: 140px;
      padding-bottom: 80px;
      align-content: center;
      z-index: 2;
    }

    .portfolio-home__hero-copy {
      grid-area: copy;
      z-index: 10;
      align-self: end;
    }

    .portfolio-home__eyebrow {
      display: inline-flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 6px;
      font-size: clamp(0.65rem, 0.75vw, 0.8rem);
      font-weight: 600;
      letter-spacing: 0.08em;
      color: hsl(var(--foreground) / 0.55);
      text-transform: uppercase;
    }

    .portfolio-home__eyebrow-sep {
      color: hsl(var(--foreground) / 0.25);
      font-size: 0.9em;
    }

    .portfolio-home__wave {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      transform-origin: 70% 70%;
      animation: portfolio-home-wave 2.2s ease-in-out infinite;
    }

    .portfolio-home__hero h1 {
      margin: 16px 0 0;
      font-size: clamp(4.8rem, 10vw, 9.5rem);
      line-height: 0.88;
      letter-spacing: -0.05em;
      color: hsl(var(--foreground));
      text-transform: uppercase;
    }

    .portfolio-home__hero-side {
      grid-area: side;
      display: flex;
      flex-direction: column;
      gap: 32px;
      max-width: 540px;
      z-index: 10;
      align-self: start;
    }

    .portfolio-home__hero-summary {
      margin: 0;
      font-size: 1.2rem;
      line-height: 1.75;
      color: hsl(var(--foreground) / 0.82);
      font-weight: 400;
    }

    .portfolio-home__hero-meta {
      display: flex;
      flex-direction: column;
      gap: 20px;
      padding-top: 24px;
      border-top: 1px solid hsl(var(--foreground) / 0.12);
    }

    .portfolio-home__hero-socials {
      display: flex;
      flex-wrap: wrap;
      gap: 18px;
      color: hsl(var(--foreground) / 0.72);
    }

    .portfolio-home__hero-socials a {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      font-size: 0.9rem;
      transition: color 180ms ease;
    }

    .portfolio-home__hero-socials a:hover {
      color: hsl(var(--foreground));
    }

    .portfolio-home__hero-contacts {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 14px;
      color: hsl(var(--foreground) / 0.72);
      font-size: 0.9rem;
    }

    .portfolio-home__hero-contacts a {
      color: hsl(var(--foreground) / 0.82);
      transition: color 180ms ease;
    }

    .portfolio-home__hero-contacts a:hover {
      color: hsl(var(--foreground));
    }

    .portfolio-home__contact-sep {
      color: hsl(var(--foreground) / 0.32);
    }

    .portfolio-home__hero-image-wrap {
      grid-area: image;
      position: relative;
      align-self: end;
      justify-self: end;
      width: min(100%, 600px);
      margin-right: clamp(0px, 1.8vw, 28px);
      transform-style: preserve-3d;
      transition: transform 0.1s ease-out;
      will-change: transform;
    }

    .portfolio-home__hero-glow {
      position: absolute;
      top: var(--glow-y, 50%);
      left: var(--glow-x, 50%);
      width: min(30vw, 340px);
      height: min(30vw, 340px);
      border-radius: 999px;
      background: radial-gradient(
        circle,
        hsl(var(--foreground) / 0.2),
        transparent 70%
      );
      filter: blur(48px);
      transform: translate(-50%, -50%) scale(1.6);
      pointer-events: none;
      z-index: -1;
      opacity: 0.6;
      transition: opacity 0.4s ease;
    }

    .portfolio-home__hero-particles {
      position: absolute;
      inset: -10% -10%;
      pointer-events: none;
      z-index: 1;
    }

    .portfolio-home__particle {
      position: absolute;
      top: var(--top);
      left: var(--left);
      width: var(--size);
      height: var(--size);
      background: hsl(var(--foreground) / 0.6);
      border-radius: 50%;
      opacity: 0.3;
      filter: blur(1px);
      animation: hero-particle-drift 8s ease-in-out infinite alternate;
      animation-delay: var(--delay);
    }

    .portfolio-home__hero-image {
      position: relative;
      display: block;
      width: 100%;
      max-height: calc(100svh - 170px);
      height: auto;
      object-fit: contain;
      object-position: center bottom;
      filter: saturate(0.92) contrast(1.08) brightness(1.04);
      transition: filter 0.5s ease;
      mask-image:
        linear-gradient(to bottom, black 0%, black 55%, transparent 100%),
        radial-gradient(ellipse 90% 95% at 50% 42%, black 55%, transparent 90%);
      -webkit-mask-image:
        linear-gradient(to bottom, black 0%, black 55%, transparent 100%),
        radial-gradient(ellipse 90% 95% at 50% 42%, black 55%, transparent 90%);
      mask-composite: intersect;
      -webkit-mask-composite: source-in;
      pointer-events: auto;
    }

    .portfolio-home__hero-image-wrap:hover .portfolio-home__hero-image {
      filter: saturate(1.1) contrast(1.05) brightness(1.1);
    }

    .portfolio-home__hero-image-wrap:hover .portfolio-home__hero-glow {
      opacity: 0.9;
    }

    .portfolio-home__marquee-section {
      position: relative;
    }

    .portfolio-home__section-shell,
