---
import MainLayout from "@layouts/MainLayout.astro";

const versions = [
  {
    title: "Data journalism",
    focus: "Analysis, interactive graphics, and reporting with public data.",
    href: "/cvs/Anil_Karaca_Data_CV.pdf",
  },
  {
    title: "Product and development",
    focus: "Apps, games, and digital products: scope, UX, build, and release.",
    href: "/cvs/Anil_Karaca_Product_Specialist.pdf",
  },
  {
    title: "Communications",
    focus: "Public campaigns, social channels, agencies, and video.",
    href: "/cvs/Anil_Karaca_Communications_Manager.pdf",
  },
];
---

<MainLayout
  title="CV"
  description="Anıl Karaca’s CV for data journalism, product development, and communications roles."
>
  <header class="page-head container">
    <h1 class="t-display">CV</h1>
  </header>

  <section class="container cv" aria-label="CV versions">
    <ul role="list">
      {
        versions.map((version) => (
          <li>
            <a
              class="cv__row"
              href={version.href}
              target="_blank"
              rel="noopener"
              data-track-event="download_resume"
              data-track-label={`CV - ${version.title}`}
            >
              <span class="cv__text">
                <h2 class="cv__title">{version.title}</h2>
                <span class="cv__focus">{version.focus}</span>
              </span>
              <span class="cv__cta">
                PDF <span aria-hidden="true">↗</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</MainLayout>

<style>
  .cv {
    padding-bottom: clamp(80px, 10vw, 128px);
  }

  .cv ul {
    border-top: 1px solid hsl(var(--border));
  }

  .cv__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px 32px;
    padding-block: 28px;
    border-bottom: 1px solid hsl(var(--border));
  }

  .cv__text {
    display: grid;
    gap: 4px;
    min-width: 0;
  }

  .cv__title {
    font-size: clamp(1.375rem, 2.4vw, 1.75rem);
    line-height: 1.2;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .cv__focus {
    color: hsl(var(--muted-foreground));
    text-wrap: pretty;
  }

  .cv__cta {
    flex: none;
    padding: 6px 14px;
    border-radius: 999px;
    background: hsl(var(--foreground) / 0.08);
    font-size: 0.875rem;
    font-weight: 500;
    transition:
      background-color 250ms ease,
      color 250ms ease;
  }

  .cv__row:hover .cv__cta,
  .cv__row:focus-visible .cv__cta {
    background: hsl(var(--foreground));
    color: hsl(var(--background));
  }
</style>
