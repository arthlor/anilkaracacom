---
import type { CollectionEntry } from "astro:content";

import MainLayout from "./MainLayout.astro";
import JsonLd from "../components/JsonLd.astro";
import CaseStudyHero from "../components/case-study/CaseStudyHero.astro";
import RelatedContent from "../components/RelatedContent.astro";
import { mdxComponents } from "../components/mdx/mdxComponents";
import {
  buildArticleSchema,
  buildProjectSchema,
  getEntrySeo,
} from "../lib/seo";
import { isPublicEntry } from "../lib/content";
import { setStorySteps } from "../lib/storyStepContext";
import { pillarConfig, siteConfig } from "../lib/site";

interface Props {
  entry: CollectionEntry<"articles"> | CollectionEntry<"projects">;
  collection: "articles" | "projects";
  Content: any;
}

const { entry, collection, Content } = Astro.props;
const isTurkish = entry.data.language === "tr";
const isPublishedArticle = collection === "articles" && isPublicEntry(entry);
const seo = getEntrySeo(collection, entry);
const noindex = collection === "articles" && !isPublicEntry(entry);

setStorySteps(entry.data.storySteps ?? []);
const contentGridClass =
  collection === "articles"
    ? "mx-auto w-full max-w-[1660px] px-4 sm:px-6 lg:px-8 min-w-0"
    : "mx-auto w-full max-w-[1120px] px-4 sm:px-6 lg:px-8 min-w-0";

const copy = isTurkish
  ? {
      backLabel:
        collection === "articles" ? "Yazılara geri dön" : "Projelere geri dön",
      publishedLabel: collection === "articles" ? "Yayın" : "Yayınlandı",
      roleLabel: collection === "articles" ? "Rol" : "Benim rolüm",
      methodologyLabel:
        collection === "articles" ? "Üretim Akışı" : "Ne yaptım",
      contextLabel:
        collection === "articles" ? "Bağlam ve Problem Alanı" : "Neden yaptım",
      challengeLabel:
        collection === "articles" ? "Üretim Zorluğu" : "En zor karar",
      codeLabel:
        collection === "articles" ? "Etkileşimli Sistem Notu" : "Altyapı",
      conclusionLabel: collection === "articles" ? "Son söz" : "Sonuç",
    }
  : {
      backLabel:
        collection === "articles" ? "Back to articles" : "Back to projects",
      publishedLabel: collection === "articles" ? "Published" : "Released",
      roleLabel: collection === "articles" ? "Role" : "My role",
      methodologyLabel:
        collection === "articles" ? "Reporting workflow" : "What I built",
      contextLabel:
        collection === "articles"
          ? "Context and problem space"
          : "Why I made it",
      challengeLabel:
        collection === "articles" ? "Production challenge" : "The key decision",
      codeLabel:
        collection === "articles"
          ? "Interactive system note"
          : "Under the hood",
      conclusionLabel: collection === "articles" ? "Conclusion" : "Outcome",
    };

const schema =
  collection === "articles"
    ? buildArticleSchema(entry as CollectionEntry<"articles">)
    : buildProjectSchema(entry as CollectionEntry<"projects">);
---

<MainLayout
  title={seo.title}
  description={seo.description}
  image={seo.image}
  noindex={noindex}
  article={collection === "articles"}
  lang={entry.data.language}
  articlePublishedTime={collection === "articles"
    ? entry.data.pubDate.toISOString()
    : undefined}
  articleModifiedTime={collection === "articles"
    ? (entry.data.updatedDate ?? entry.data.pubDate).toISOString()
    : undefined}
  articleAuthor={siteConfig.personName}
  articleSection={collection === "articles"
    ? pillarConfig[entry.data.pillar].title
    : undefined}
>
  <JsonLd schema={schema} />

  <CaseStudyHero entry={entry} collection={collection} locale={copy} />

  <section class="case-study-layout" data-case-study={collection}>
    <div class={contentGridClass}>
      <div class="min-w-0">
        <div class="case-study-layout__panel case-study-layout__panel--main">
          {
            isPublishedArticle ? (
              <div class="article-dashboard">
                <section
                  id="visual-analysis"
                  aria-label="Makale görselleştirmeleri"
                >
                  <div class="prose-article max-w-none">
                    <Content components={mdxComponents} />
                  </div>
                </section>

                {/* Challenge, Code Proof & Conclusion Section (Behind the Scenes Dashboard) */}
                <div class="article-dashboard__outro-grid">
                  {entry.data.challenge && (
                    <section class="article-dashboard__card">
                      <p class="case-study-layout__label">
                        {copy.challengeLabel}
                      </p>
                      <p class="article-dashboard__copy mt-3">
                        {entry.data.challenge}
                      </p>
                    </section>
                  )}

                  {entry.data.codeProof && (
                    <section class="article-dashboard__card">
                      <p class="case-study-layout__label">{copy.codeLabel}</p>
                      <p class="article-dashboard__copy mt-3">
                        {entry.data.codeProof}
                      </p>
                    </section>
                  )}

                  {entry.data.conclusion && (
                    <section class="article-dashboard__card md:col-span-2 lg:col-span-2">
                      <p class="case-study-layout__label">
                        {copy.conclusionLabel}
                      </p>
                      <p class="article-dashboard__copy mt-3">
                        {entry.data.conclusion}
                      </p>
                    </section>
                  )}
                </div>
              </div>
            ) : (
              <div class="project-story">
                <section class="project-story__intro">
                  <p class="case-study-layout__label">{copy.contextLabel}</p>
                  <p class="project-story__lead">{entry.data.context}</p>
                </section>

                {entry.data.methodology.length > 0 && (
                  <section class="project-story__section">
                    <p class="case-study-layout__label">
                      {copy.methodologyLabel}
                    </p>
                    <ol class="project-story__steps">
                      {entry.data.methodology.map((item, index) => (
                        <li>
                          <span>{String(index + 1).padStart(2, "0")}</span>
                          <p>{item}</p>
                        </li>
                      ))}
                    </ol>
                  </section>
                )}

                <div class="project-story__details">
                  {entry.data.challenge && (
                    <section>
                      <p class="case-study-layout__label">
                        {copy.challengeLabel}
                      </p>
                      <p class="project-story__copy">{entry.data.challenge}</p>
                    </section>
                  )}

                  {entry.data.codeProof && (
                    <section>
                      <p class="case-study-layout__label">{copy.codeLabel}</p>
                      <p class="project-story__copy">{entry.data.codeProof}</p>
                    </section>
                  )}
                </div>

                <section class="project-story__outcome">
                  <p class="case-study-layout__label">{copy.conclusionLabel}</p>
                  <p>{entry.data.conclusion}</p>
                </section>
              </div>
            )
          }
        </div>

        <RelatedContent
          currentCollection={collection}
          currentSlug={entry.id}
          currentPillar={entry.data.pillar}
          language={entry.data.language}
          relatedContent={entry.data.relatedContent}
        />
      </div>
    </div>
  </section>
</MainLayout>

<style>
  .case-study-layout {
    padding-bottom: 6.5rem;
  }

  .case-study-layout__panel {
    padding: clamp(1.25rem, 2vw, 1.9rem);
    border-radius: 12px;
  }

  .case-study-layout__panel--main {
    position: relative;
    overflow: visible;
  }

  .case-study-layout__label {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--premium-accent);
  }

  .project-story {
    display: grid;
    gap: clamp(3rem, 7vw, 5.5rem);
  }

  .project-story__intro {
    max-width: 50rem;
  }

  .project-story__lead {
    margin-top: 1rem;
    font-family: var(--font-display);
    font-size: clamp(1.45rem, 3vw, 2.25rem);
    line-height: 1.35;
    color: hsl(var(--foreground));
  }

  .project-story__steps {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
    margin-top: 1.5rem;
    padding: 0;
    border-top: 1px solid hsl(var(--border));
    list-style: none;
  }

  .project-story__steps li {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    gap: 1rem;
    padding: 1.5rem 1.5rem 1.5rem 0;
    border-bottom: 1px solid hsl(var(--border));
  }

  .project-story__steps li:nth-child(odd) {
    padding-right: 2rem;
  }

  .project-story__steps li:nth-child(even) {
    padding-left: 2rem;
    border-left: 1px solid hsl(var(--border));
  }

  .project-story__steps span {
    color: var(--premium-accent);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  .project-story__steps p,
  .project-story__copy {
    font-size: 0.98rem;
    line-height: 1.8;
    color: hsl(var(--muted-foreground));
  }

  .project-story__details {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2rem, 5vw, 4rem);
  }

  .project-story__copy {
    margin-top: 1rem;
  }

  .project-story__outcome {
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border-left: 2px solid var(--premium-accent);
    background: hsl(var(--muted) / 0.45);
  }

  .project-story__outcome > p:last-child {
    max-width: 52rem;
    margin-top: 0.85rem;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.4vw, 1.75rem);
    line-height: 1.45;
    color: hsl(var(--foreground));
  }

  .article-dashboard {
    display: grid;
    gap: 1.25rem;
  }

  .article-dashboard__intro-grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 768px) {
    .article-dashboard__intro-grid {
      grid-template-columns: 1.2fr 1fr;
    }
  }

  .article-dashboard__outro-grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 1fr;
    margin-top: 3.5rem;
    padding-top: 2.5rem;
    border-top: 1px solid hsl(var(--border));
  }
  @media (min-width: 768px) {
    .article-dashboard__outro-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .article-dashboard__card {
    padding: 1.75rem 2rem;
    border: 1px solid hsl(var(--border));
    border-radius: 16px;
    background: hsl(var(--card));
  }

  .article-dashboard__copy {
    font-size: 0.95rem;
    line-height: 1.8;
    color: hsl(var(--muted-foreground));
  }

  .article-dashboard__methodology {
    display: grid;
    gap: 0.75rem;
    padding: 0;
    list-style: none;
  }

  .article-dashboard__methodology li {
    padding: 0.75rem 1rem;
    border-left: 2px solid rgba(122, 242, 152, 0.15);
    background: hsl(var(--muted) / 0.45);
    font-size: 0.9rem;
    line-height: 1.6;
    color: hsl(var(--foreground));
  }

  .article-snapshot {
    display: grid;
    gap: 1.25rem;
    padding: 1.75rem 2rem;
    border: 1px solid rgba(122, 242, 152, 0.1);
    border-radius: 16px;
    background: linear-gradient(
      135deg,
      rgba(122, 242, 152, 0.03) 0%,
      hsl(var(--card)) 60%,
      rgba(122, 242, 152, 0.02) 100%
    );
    backdrop-filter: blur(12px);
    scroll-margin-top: 7rem;
  }

  .article-snapshot__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .article-snapshot__body {
    max-width: 64rem;
    font-size: 0.95rem;
    line-height: 1.75;
    color: hsl(var(--muted-foreground));
  }

  .article-snapshot__metrics {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-top: 0.25rem;
  }

  .article-snapshot__metric-card {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1rem 1.1rem;
    border-left: 2px solid rgba(122, 242, 152, 0.25);
    border-radius: 0 10px 10px 0;
    background: hsl(var(--muted) / 0.55);
    transition:
      background 200ms ease,
      border-color 200ms ease;
  }

  .article-snapshot__metric-card:hover {
    background: rgba(122, 242, 152, 0.04);
    border-left-color: var(--premium-accent);
  }

  .article-snapshot__metric-value {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1;
    color: hsl(var(--foreground));
  }

  .article-snapshot__metric-label {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--premium-accent);
    opacity: 0.85;
  }

  .article-snapshot__jump {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1.15rem;
    border: 1px solid rgba(122, 242, 152, 0.2);
    border-radius: 8px;
    background: rgba(122, 242, 152, 0.06);
    color: var(--premium-accent);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
    transition:
      background 200ms ease,
      border-color 200ms ease,
      transform 200ms ease,
      box-shadow 200ms ease;
  }

  .article-snapshot__jump:hover {
    background: rgba(122, 242, 152, 0.12);
    border-color: rgba(122, 242, 152, 0.4);
    transform: translateX(2px);
    box-shadow: 0 0 20px rgba(122, 242, 152, 0.08);
  }

  .article-snapshot__jump svg {
    transition: transform 200ms ease;
  }

  .article-snapshot__jump:hover svg {
    transform: translateX(3px);
  }

  .case-study-layout[data-case-study="articles"]
    .case-study-layout__panel--main {
    padding-inline: clamp(1.1rem, 1.8vw, 1.7rem);
  }

  .case-study-layout[data-case-study="articles"] .case-study-layout__panel {
    border: 1px solid hsl(var(--border));
    background: linear-gradient(
      180deg,
      hsl(var(--card)),
      hsl(var(--muted) / 0.28)
    );
  }

  .case-study-layout[data-case-study="articles"]
    .case-study-layout__panel--main {
    border-color: transparent;
    background: transparent;
  }

  .case-study-layout[data-case-study="articles"]
    :global(
      .prose-article
        > :where(p, h2, h3, h4, ul, ol, blockquote, pre, hr, img, table)
    ) {
    max-width: 52rem;
    margin-left: auto;
    margin-right: auto;
  }

  .case-study-layout[data-case-study="articles"] .prose-article {
    width: 100%;
    min-width: 0;
  }

  .case-study-layout[data-case-study="articles"] :global(.article-dashboard) {
    width: 100%;
    min-width: 0;
    max-width: 100%;
  }

  .case-study-layout[data-case-study="articles"] :global(#visual-analysis),
  .case-study-layout[data-case-study="articles"]
    :global(.article-dashboard__outro-grid) {
    width: 100%;
    min-width: 0;
    max-width: 100%;
  }

  .case-study-layout[data-case-study="articles"]
    :global(
      .prose-article
        > :where(p, h2, h3, h4, ul, ol, blockquote, pre, hr, img, table)
    ) {
    min-width: 0;
    max-width: 52rem;
  }

  .case-study-layout[data-case-study="articles"]
    :global(.prose-article > :where(pre, table)) {
    overflow-x: auto;
  }

  .case-study-layout[data-case-study="articles"]
    :global(.prose-article > :where(.article-visual-frame, [data-story-root])) {
    width: 100%;
    min-width: 0;
    max-width: none;
    scroll-margin-top: 7rem;
  }

  @media (min-width: 1024px) {
    .case-study-layout[data-case-study="articles"]
      :global(
        .prose-article > :where(.article-visual-frame, [data-story-root])
      ) {
      margin-left: -2rem;
      margin-right: -2rem;
    }
  }

  @media (max-width: 1080px) {
    .article-snapshot__metrics {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 720px) {
    .case-study-layout {
      padding-bottom: 4.5rem;
    }

    .case-study-layout[data-case-study="articles"]
      .case-study-layout__panel--main {
      padding-inline: 0;
    }

    .case-study-layout[data-case-study="projects"]
      .case-study-layout__panel--main {
      padding-inline: 0;
    }

    .project-story__steps,
    .project-story__details {
      grid-template-columns: 1fr;
    }

    .project-story__steps li:nth-child(odd),
    .project-story__steps li:nth-child(even) {
      padding: 1.25rem 0;
      border-left: 0;
    }

    .case-study-layout[data-case-study="articles"] :global(.prose-article h2) {
      margin-top: 2.8rem;
      margin-bottom: 1.2rem;
      font-size: clamp(1.65rem, 8vw, 2rem);
      line-height: 1.12;
    }

    .case-study-layout[data-case-study="articles"] :global(.prose-article h3) {
      margin-top: 2.4rem;
      font-size: 1.4rem;
      line-height: 1.2;
    }

    .case-study-layout[data-case-study="articles"] :global(.prose-article p) {
      margin-bottom: 1.35rem;
      font-size: 1rem;
      line-height: 1.75;
    }

    .case-study-layout[data-case-study="articles"] :global(.prose-article hr) {
      margin-block: 3rem;
    }

    .article-dashboard__outro-grid {
      gap: 1rem;
      margin-top: 3rem;
      padding-top: 2rem;
    }

    .article-dashboard__card {
      padding: 1.25rem;
    }

    .article-dashboard {
      gap: 1rem;
    }

    .article-snapshot {
      padding: 1.25rem 1rem;
      border-radius: 12px;
    }

    .article-snapshot__header {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }

    .article-snapshot__metrics {
      grid-template-columns: 1fr;
      gap: 0.65rem;
    }

    .article-snapshot__metric-card {
      flex-direction: row;
      align-items: center;
      gap: 0.75rem;
      padding: 0.85rem 1rem;
    }

    .article-snapshot__metric-value {
      font-size: 1.25rem;
    }

    .article-snapshot__jump {
      width: 100%;
      justify-content: center;
    }
  }
</style>
