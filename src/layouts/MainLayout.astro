---
import BaseLayout from "./BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  exactTitle?: boolean | undefined;
  description?: string | undefined;
  image?: string | undefined;
  imageAlt?: string | undefined;
  noindex?: boolean | undefined;
  article?: boolean | undefined;
  lang?: string | undefined;
  articlePublishedTime?: string | undefined;
  articleModifiedTime?: string | undefined;
  articleAuthor?: string | undefined;
  articleSection?: string | undefined;
}

const {
  title,
  exactTitle,
  description,
  image,
  imageAlt,
  noindex,
  article = false,
  lang = "en",
  articlePublishedTime,
  articleModifiedTime,
  articleAuthor,
  articleSection,
} = Astro.props;
---

<BaseLayout
  title={title}
  exactTitle={exactTitle}
  description={description}
  image={image}
  imageAlt={imageAlt}
  noindex={noindex}
  article={article}
  lang={lang}
  articlePublishedTime={articlePublishedTime}
  articleModifiedTime={articleModifiedTime}
  articleAuthor={articleAuthor}
  articleSection={articleSection}
>
  <a class="skip-link" href="#main-content">Skip to content</a>
  <div class="shell">
    <Header />
    <main id="main-content" class="shell__main">
      <slot />
    </main>
    <Footer />
  </div>
</BaseLayout>

<style>
  .shell {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    min-height: 100svh;
  }

  .shell__main {
    flex: 1;
  }

  .skip-link {
    position: absolute;
    top: 8px;
    left: 8px;
    z-index: 200;
    padding: 8px 14px;
    border-radius: 999px;
    background: hsl(var(--foreground));
    color: hsl(var(--background));
    font-size: 0.875rem;
    transform: translateY(-200%);
  }

  .skip-link:focus {
    transform: none;
  }
</style>
