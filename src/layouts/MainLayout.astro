---
import BaseLayout from "./BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BackToTop from "../components/BackToTop.astro";

interface Props {
  title: string;
  description?: string | undefined;
  image?: string | undefined;
  noindex?: boolean | undefined;
  article?: boolean | undefined;
  lang?: string | undefined;
  articlePublishedTime?: string | undefined;
  articleModifiedTime?: string | undefined;
  articleAuthor?: string | undefined;
  articleSection?: string | undefined;
}

const {
  title,
  description,
  image,
  noindex,
  article = false,
  lang = "en",
  articlePublishedTime,
  articleModifiedTime,
  articleAuthor,
  articleSection,
} = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  noindex={noindex}
  article={article}
  lang={lang}
  articlePublishedTime={articlePublishedTime}
  articleModifiedTime={articleModifiedTime}
  articleAuthor={articleAuthor}
  articleSection={articleSection}
>
  <div class="portfolio-shell">
    <div class="portfolio-shell__texture" aria-hidden="true"></div>
    <Header />
    <main class="portfolio-shell__main">
      <slot />
    </main>
    <Footer />
    <BackToTop />
  </div>
</BaseLayout>

<style>
  .portfolio-shell {
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background: #111111;
    color: #f3f1eb;
    isolation: isolate;
  }

  .portfolio-shell__texture {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      repeating-linear-gradient(
        90deg,
        rgba(255, 255, 255, 0.015) 0,
        rgba(255, 255, 255, 0.015) 1px,
        transparent 1px,
        transparent 64px
      ),
      linear-gradient(180deg, #111111 0%, #080808 100%);
  }

  .portfolio-shell__main {
    position: relative;
    flex: 1;
  }

  /* Global Container Standard (Match Homepage) */
  :global(.container-standard) {
    width: min(100% - 80px, 1320px);
    margin-inline: auto;
  }

  @media (max-width: 720px) {
    :global(.container-standard) {
      width: min(100% - 40px, 1320px);
    }
  }
</style>
