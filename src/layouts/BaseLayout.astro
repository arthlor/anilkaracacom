---
import "../styles/global.css";
import SEO from "../components/SEO.astro";
import { PUBLIC_GA_MEASUREMENT_ID } from "astro:env/client";
import { siteConfig, themeStorageKey } from "../lib/site";
// Same hashed file the CSS asks for; preloading it lets text paint sooner.
import interLatin from "@fontsource-variable/inter/files/inter-latin-opsz-normal.woff2?url";

const gaMeasurementId = PUBLIC_GA_MEASUREMENT_ID;
const defaultTheme = siteConfig.defaultTheme;

interface Props {
  title: string;
  exactTitle?: boolean | undefined;
  description?: string | undefined;
  image?: string | undefined;
  imageAlt?: string | undefined;
  article?: boolean | undefined;
  noindex?: boolean | undefined;
  lang?: string | undefined;
  articlePublishedTime?: string | undefined;
  articleModifiedTime?: string | undefined;
  articleAuthor?: string | undefined;
  articleSection?: string | undefined;
}

const {
  title,
  exactTitle,
  description,
  image,
  imageAlt,
  article,
  noindex = false,
  lang = "en",
  articlePublishedTime,
  articleModifiedTime,
  articleAuthor,
  articleSection,
} = Astro.props;
---

<!doctype html>
<html
  lang={lang}
  data-default-theme={defaultTheme}
  data-theme-storage-key={themeStorageKey}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link
      rel="preload"
      href={interLatin}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta name="generator" content={Astro.generator} />

    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#fbfaf9" />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const storageKey =
          root.dataset.themeStorageKey || "anilkaraca-theme";
        const colorSchemeQuery = window.matchMedia(
          "(prefers-color-scheme: dark)",
        );
        const lightColorSchemeQuery = window.matchMedia(
          "(prefers-color-scheme: light)",
        );

        const getSavedTheme = () => {
          try {
            const savedTheme = localStorage.getItem(storageKey);
            return savedTheme === "light" || savedTheme === "dark"
              ? savedTheme
              : null;
          } catch {
            return null;
          }
        };

        const getPreferredTheme = () => {
          const savedTheme = getSavedTheme();
          if (savedTheme) return savedTheme;

          const configuredTheme =
            root.dataset.defaultTheme === "light" ? "light" : "dark";

          if (colorSchemeQuery.matches) return "dark";
          if (lightColorSchemeQuery.matches) return "light";
          return configuredTheme;
        };

        const applyTheme = (theme) => {
          const isDark = theme === "dark";
          root.classList.toggle("dark", isDark);
          root.dataset.theme = theme;

          const themeColorMeta = document.querySelector(
            'meta[name="theme-color"]',
          );

          if (themeColorMeta) {
            themeColorMeta.content = isDark ? "#111110" : "#fbfaf9";
          }
        };

        applyTheme(getPreferredTheme());

        colorSchemeQuery.addEventListener("change", (event) => {
          if (getSavedTheme()) return;

          const theme = event.matches ? "dark" : "light";
          applyTheme(theme);
          window.dispatchEvent(
            new CustomEvent("themechange", { detail: { theme } }),
          );
        });
      })();
    </script>

    <script is:inline>
      // After a deploy, a page loaded earlier (open tab, back button, hover
      // prefetch) can ask for chart code that no longer exists. Astro retries
      // once and then reports it; reload one time to pick up the current build
      // instead of leaving a dead graphic.
      addEventListener("astro:hydration-error", (event) => {
        const message = String(event.detail?.error?.message ?? "");
        if (!/dynamically imported module|Importing a module script failed/i.test(message)) return;
        try {
          const key = "stale-build-reload";
          if (sessionStorage.getItem(key) === location.pathname) return;
          sessionStorage.setItem(key, location.pathname);
        } catch {
          return;
        }
        event.preventDefault();
        location.reload();
      });
    </script>

    <SEO
      title={title}
      exactTitle={exactTitle}
      description={description}
      image={image}
      imageAlt={imageAlt}
      article={article}
      noindex={noindex}
      lang={lang}
      articlePublishedTime={articlePublishedTime}
      articleModifiedTime={articleModifiedTime}
      articleAuthor={articleAuthor}
      articleSection={articleSection}
    />

    {
      gaMeasurementId && (
        <script is:inline define:vars={{ gaMeasurementId }}>
          // Commands queue in dataLayer straight away; the 150 KB library
          // itself loads once the page is idle, off the critical path.
          window.dataLayer = window.dataLayer || [];
          window.gtag = function gtag() {
            window.dataLayer.push(arguments);
          };
          window.gtag("js", new Date());
          window.gtag("config", gaMeasurementId);

          const loadAnalytics = () => {
            const script = document.createElement("script");
            script.async = true;
            script.src = `https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`;
            document.head.append(script);
          };
          const whenIdle = () =>
            "requestIdleCallback" in window
              ? requestIdleCallback(loadAnalytics, { timeout: 4000 })
              : setTimeout(loadAnalytics, 2000);
          if (document.readyState === "complete") whenIdle();
          else addEventListener("load", whenIdle, { once: true });
        </script>
      )
    }

    <!-- Custom event tracking for portfolio interactions -->
    <script is:inline>
      window.addEventListener(
        "click",
        function (event) {
          var target = event.target;
          if (!(target instanceof Element)) return;

          var trigger = target.closest("[data-track-event]");
          if (!trigger || typeof window.gtag !== "function") return;

          var trackEvent = trigger.dataset.trackEvent;
          var trackLabel = trigger.dataset.trackLabel;
          var trackLocation = trigger.dataset.trackLocation;
          if (!trackEvent) return;

          window.gtag("event", trackEvent, {
            event_category: "portfolio",
            event_label: trackLabel || trackEvent,
            location: trackLocation || window.location.pathname,
          });
        },
        { capture: true },
      );
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
