---
import "../styles/global.css";
import SEO from "../components/SEO.astro";

const GA_MEASUREMENT_ID = "G-E4DHYLKXW8";

interface Props {
  title: string;
  description?: string | undefined;
  image?: string | undefined;
  article?: boolean | undefined;
  noindex?: boolean | undefined;
  lang?: string | undefined;
}

const {
  title,
  description,
  image,
  article,
  noindex = false,
  lang = "en",
} = Astro.props;
---

<!doctype html>
<html lang={lang} class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <SEO
      title={title}
      description={description}
      image={image}
      article={article}
      noindex={noindex}
    />

    <!-- Google tag (gtag.js) -->
    <script
      is:inline
      async
      src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}
    ></script>
    <script
      is:inline
      set:html={`
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', '${GA_MEASUREMENT_ID}');
      `}
    />

    <!-- Custom event tracking for portfolio interactions -->
    <script is:inline>
      window.addEventListener(
        "click",
        function (event) {
          var target = event.target;
          if (!(target instanceof Element)) return;

          var trigger = target.closest("[data-track-event]");
          if (!trigger || typeof window.gtag !== "function") return;

          var trackEvent = trigger.dataset.trackEvent;
          var trackLabel = trigger.dataset.trackLabel;
          var trackLocation = trigger.dataset.trackLocation;
          if (!trackEvent) return;

          window.gtag("event", trackEvent, {
            event_category: "portfolio",
            event_label: trackLabel || trackEvent,
            location: trackLocation || window.location.pathname,
          });
        },
        { capture: true },
      );
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <slot />
  </body>
</html>
