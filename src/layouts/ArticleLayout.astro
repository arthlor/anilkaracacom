---
import { render, type CollectionEntry } from "astro:content";
import { Image } from "astro:assets";

import MainLayout from "./MainLayout.astro";
import ArticleCard from "../components/ArticleCard.astro";
import JsonLd from "../components/JsonLd.astro";
import { mdxComponents } from "../components/mdx/mdxComponents";
import { formatEntryDate, getLanguageLabel } from "../lib/content";
import {
  buildArticleSchema,
  getArticleOgImage,
  getArticleSeo,
} from "../lib/seo";
import { pillarConfig, siteConfig } from "../lib/site";
import { setStorySteps } from "../lib/storyStepContext";

interface Props {
  entry: CollectionEntry<"articles">;
  related: CollectionEntry<"articles">[];
}

const { entry, related } = Astro.props;
// Rendering here (not in the page) lets Astro collect the styles of
// components used inside the MDX body.
const { Content } = await render(entry);
const { title, description, heroImage, language, pubDate, methodology } =
  entry.data;
const isTurkish = language === "tr";
const seo = getArticleSeo(entry);
const ogImage = await getArticleOgImage(entry);

const methodLabel = isTurkish ? "Yöntem" : "Method";

setStorySteps(entry.data.storySteps ?? []);
---

<MainLayout
  title={seo.title}
  description={seo.description}
  image={ogImage}
  imageAlt={title}
  article
  lang={language}
  articlePublishedTime={pubDate.toISOString()}
  articleModifiedTime={(entry.data.updatedDate ?? pubDate).toISOString()}
  articleAuthor={siteConfig.personName}
  articleSection={pillarConfig[entry.data.pillar].title}
>
  <JsonLd schema={{ "@graph": buildArticleSchema(entry, ogImage) }} />

  <article class="article">
    <header class="article__head container-text">
      <h1 class="article__title">{title}</h1>
      <p class="article__dek">{description}</p>
      <p class="t-meta article__meta">
        <time datetime={pubDate.toISOString()}>
          {formatEntryDate(pubDate, language, "long")}
        </time>
        <span aria-hidden="true">·</span>
        <span>{getLanguageLabel(language)}</span>
      </p>
    </header>

    {
      heroImage && (
        <figure class="article__hero container">
          <Image
            src={heroImage}
            alt=""
            widths={[640, 960, 1280, 1920]}
            sizes="(min-width: 1200px) 1120px, 100vw"
            loading="eager"
            fetchpriority="high"
          />
        </figure>
      )
    }

    <div class="article__body">
      <div class="prose-article">
        <Content components={mdxComponents} />
      </div>
    </div>

    {
      methodology.length > 0 && (
        <section class="article__notes container-text" aria-labelledby="method">
          <h2 id="method">{methodLabel}</h2>
          <ol>
            {methodology.map((step) => (
              <li>{step}</li>
            ))}
          </ol>
        </section>
      )
    }
  </article>

  {
    related.length > 0 && (
      <section class="related" aria-labelledby="related-title" lang="en">
        <div class="container">
          <div class="section-head">
            <h2 id="related-title" class="t-headline">
              More articles
            </h2>
            <a class="more" href="/articles">
              All articles
            </a>
          </div>
          <div class="related__grid">
            {related.map((item) => (
              <ArticleCard entry={item} />
            ))}
          </div>
        </div>
      </section>
    )
  }
</MainLayout>

<style>
  .article__head {
    padding-top: clamp(48px, 8vw, 96px);
  }

  .article__title {
    font-size: clamp(2.25rem, 5.2vw, 3.5rem);
    line-height: 1.05;
    letter-spacing: -0.035em;
  }

  .article__dek {
    margin-top: 20px;
    font-size: clamp(1.1875rem, 2vw, 1.375rem);
    line-height: 1.4;
    letter-spacing: -0.012em;
    color: hsl(var(--muted-foreground));
    text-wrap: pretty;
  }

  .article__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0 6px;
    margin-top: 24px;
  }

  .article__hero {
    margin-top: clamp(40px, 6vw, 64px);
  }

  .article__hero img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 18px;
    background: hsl(var(--muted));
  }

  .article__body {
    width: min(100% - 2 * var(--gutter), 1200px);
    margin: clamp(48px, 7vw, 80px) auto 0;
  }

  .article__body :global(.prose-article > :first-child) {
    margin-top: 0;
  }

  .article__body
    :global(.prose-article > :where(.article-visual-frame, [data-story-root])) {
    width: 100%;
    min-width: 0;
    max-width: none;
    scroll-margin-top: calc(var(--nav-h) + 24px);
  }

  .article__notes {
    margin-top: clamp(56px, 8vw, 96px);
    padding-top: 24px;
    border-top: 1px solid hsl(var(--border));
  }

  .article__notes h2 {
    font-size: 1.0625rem;
    letter-spacing: -0.01em;
  }

  .article__notes ol {
    margin-top: 12px;
    padding-left: 1.4em;
    list-style: decimal;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: hsl(var(--muted-foreground));
  }

  .article__notes li {
    margin-block: 6px;
    padding-left: 0.25em;
  }

  .article__notes li::marker {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  .related {
    margin-top: clamp(80px, 10vw, 128px);
    padding-block: clamp(48px, 7vw, 80px) clamp(64px, 9vw, 112px);
    border-top: 1px solid hsl(var(--border));
  }

  .related__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 40px 24px;
  }

  @media (max-width: 899px) {
    .related__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 599px) {
    .related__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
